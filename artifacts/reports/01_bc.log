"""Train BC in the model environment; run from the repo root with python -m."""

import argparse
import ast
import copy
import csv
import json
import math
import os
import random
import tempfile
import time
from dataclasses import asdict, dataclass, fields
from pathlib import Path

import numpy as np
import torch
from torch.utils.data import DataLoader, Sampler

from .dataset import EpisodeStore
from .model import BCModel, masked_l1


@dataclass
class Config:
    data_dirs: tuple = ("/home/keyu/advaitic/data/human60",)
    cache_dir: str = "/home/keyu/advaitic/data/cache"
    run_dir: str = "method/bc/checkpoints/human60"
    horizon: int = 20
    exec_steps: int = 10
    steps: int = 20_000
    batch_size: int = 64
    microbatch_size: int = 8
    val_episodes: int = 6
    val_every: int = 1000
    save_every: int = 1000
    log_every: int = 100
    lr: float = 3e-4
    backbone_lr: float = 1e-4
    weight_decay: float = 1e-4
    warmup_steps: int = 500
    ema_decay: float = 0.999
    num_workers: int = 2
    seed: int = 42
    device: str = "cuda"
    pretrained: bool = True
    temporal_ensemble: bool = False
    ensemble_decay: float = 0.01


def validate_config(config):
    if not 1 <= config.exec_steps <= config.horizon <= 50:
        raise ValueError("Require 1 <= exec_steps <= horizon <= 50")
    if not 0 <= config.num_workers <= 2:
        raise ValueError("num_workers must be in [0, 2]")
    for key in (
        "steps",
        "batch_size",
        "microbatch_size",
        "val_episodes",
        "val_every",
        "save_every",
        "log_every",
    ):
        if getattr(config, key) < 1:
            raise ValueError(f"{key} must be positive")
    if config.warmup_steps < 0 or not 0 <= config.ema_decay < 1:
        raise ValueError("Invalid warmup_steps or ema_decay")
    if config.lr <= 0 or config.backbone_lr <= 0 or config.weight_decay < 0:
        raise ValueError("Invalid optimizer settings")
    if config.ensemble_decay < 0:
        raise ValueError("ensemble_decay must be nonnegative")


class StepBatches(Sampler):
    """Reproducible random batches independent of worker prefetch and restarts."""

    def __init__(self, size, batch_size, start, stop, seed):
        self.size, self.batch_size = size, batch_size
        self.start, self.stop, self.seed = start, stop, seed

    def __iter__(self):
        for step in range(self.start, self.stop):
            generator = torch.Generator().manual_seed(self.seed + step)
            yield torch.randint(self.size, (self.batch_size,), generator=generator).tolist()

    def __len__(self):
        return self.stop - self.start


def atomic_save(value, path):
    path = Path(path)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as stream:
        temporary = Path(stream.name)
        try:
            torch.save(value, stream)
            stream.flush()
            os.fsync(stream.fileno())
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)


def rng_state(cuda):
    return {
        "python": random.getstate(),
        "numpy": np.random.get_state(),
        "torch": torch.get_rng_state(),
        "cuda": torch.cuda.get_rng_state_all() if cuda else None,
    }


def restore_rng(state, cuda):
    random.setstate(state["python"])
    np.random.set_state(state["numpy"])
    torch.set_rng_state(state["torch"])
    if cuda and state["cuda"] is not None:
        torch.cuda.set_rng_state_all(state["cuda"])


def lr_factor(step, config):
    if step < config.warmup_steps:
        return (step + 1) / config.warmup_steps
    progress = (step - config.warmup_steps) / max(1, config.steps - config.warmup_steps)
    return 0.5 * (1 + math.cos(math.pi * min(progress, 1)))


@torch.no_grad()
def update_ema(ema, model, decay):
    for average, current in zip(ema.parameters(), model.parameters(), strict=True):
        average.lerp_(current.detach(), 1 - decay)
    for average, current in zip(ema.buffers(), model.buffers(), strict=True):
        average.copy_(current)


def to_device(batch, device):
    return {key: value.to(device, non_blocking=True) for key, value in batch.items()}


@torch.inference_mode()
def validate(model, loader, device, cuda):
    model.eval()
    total, count = 0.0, 0
    for batch in loader:
        batch = to_device(batch, device)
        with torch.autocast(device_type=device.type, dtype=torch.float16, enabled=cuda):
            prediction = model(batch["rgb"], batch["proprio"])
            loss = masked_l1(prediction.float(), batch["target"], batch["pad_mask"])
        valid = int((~batch["pad_mask"]).sum()) * prediction.shape[-1]
        total += float(loss) * valid
        count += valid
    return total / count


def train(config, *, stop_after=None):
    """stop_after tests interruption without changing the total LR schedule."""
    validate_config(config)
    device = torch.device(config.device)
    cuda = device.type == "cuda"
    if cuda and not torch.cuda.is_available():
        raise RuntimeError("CUDA is unavailable; pass --device cpu for a CPU run")
    random.seed(config.seed)
    np.random.seed(config.seed)
    torch.manual_seed(config.seed)
    if cuda:
        torch.cuda.reset_peak_memory_stats(device)
    run_dir = Path(config.run_dir)
    run_dir.mkdir(parents=True, exist_ok=True)
    checkpoint_path = run_dir / "last.pt"
    previous = (
        torch.load(checkpoint_path, map_location="cpu", weights_only=False)
        if checkpoint_path.exists()
        else None
    )
    store = EpisodeStore(config.data_dirs, config.cache_dir, config.val_episodes)
    if previous is not None:
        allowed_changes = {"run_dir", "cache_dir", "num_workers", "device"}
        for key, value in asdict(config).items():
            if key not in allowed_changes and value != previous["config"][key]:
                raise ValueError(f"Resume config changed: {key}; use a new run directory")
        if previous["data_digest"] != store.digest:
            raise ValueError("Resume data changed; use a new run directory")
    (run_dir / "config.json").write_text(json.dumps(asdict(config), indent=2) + "\n")
    model = BCModel(config.horizon, pretrained=config.pretrained and previous is None).to(device)
    backbone_ids = {id(p) for p in model.backbone.parameters()}
    optimizer = torch.optim.AdamW(
        [
            {"params": model.backbone.parameters(), "lr": config.backbone_lr},
            {
                "params": [p for p in model.parameters() if id(p) not in backbone_ids],
                "lr": config.lr,
            },
        ],
        weight_decay=config.weight_decay,
    )
    scaler = torch.amp.GradScaler("cuda", enabled=cuda)
    ema = copy.deepcopy(model).eval().requires_grad_(False)
    step = 0
    last_val = float("nan")
    if previous is not None:
        model.load_state_dict(previous["model"])
        ema.load_state_dict(previous["ema"])
        optimizer.load_state_dict(previous["optimizer"])
        scaler.load_state_dict(previous["scaler"])
        step = previous["step"]
        last_val = previous["val_loss"]
        restore_rng(previous["rng"], cuda)
        print(f"Resumed {checkpoint_path} at step {step}", flush=True)
    del previous
    train_data, val_data = (
        store.dataset("train", config.horizon),
        store.dataset("val", config.horizon),
    )
    stop = config.steps if stop_after is None else min(config.steps, stop_after)
    if stop <= step:
        print("Training already complete.", flush=True)
        return checkpoint_path
    # Dedicated loader generators preserve dropout/augmentation RNG on resume.
    loader_options = {"num_workers": config.num_workers, "pin_memory": cuda}
    train_loader = DataLoader(
        train_data,
        batch_sampler=StepBatches(len(train_data), config.batch_size, step, stop, config.seed),
        generator=torch.Generator().manual_seed(config.seed),
        **loader_options,
    )
    val_loader = DataLoader(
        val_data,
        batch_size=config.microbatch_size,
        generator=torch.Generator().manual_seed(config.seed),
        **loader_options,
    )
    log_path = run_dir / "log.csv"
    print(
        f"{len(store.train_ids)} train / {len(store.val_ids)} val episodes; "
        f"{len(train_data)} train frames; cache={store.image_path}",
        flush=True,
    )
    started, logged_step = time.monotonic(), step
    train_total, train_count = 0.0, 0
    with log_path.open("a", newline="") as log:
        writer = csv.writer(log)
        if log.tell() == 0:
            writer.writerow(["step", "train_loss", "val_loss", "lr", "it/s"])
            log.flush()
        model.train()
        for batch in train_loader:
            factor = lr_factor(step, config)
            for group, base_lr in zip(
                optimizer.param_groups, (config.backbone_lr, config.lr), strict=True
            ):
            ):
                group["lr"] = base_lr * factor
            optimizer.zero_grad(set_to_none=True)
            valid_count = (~batch["pad_mask"]).sum().item() * 10
            batch_loss = 0.0
            # Only microbatch_size * 3 images occupy backbone activation RAM.
            # Weight by valid elements to preserve the logical batch-64 mean.
            for start in range(0, len(batch["rgb"]), config.microbatch_size):
                micro = to_device(
                    {k: v[start : start + config.microbatch_size] for k, v in batch.items()}, device
                )
                with torch.autocast(device_type=device.type, dtype=torch.float16, enabled=cuda):
                    prediction = model(micro["rgb"], micro["proprio"])
                    loss = masked_l1(prediction.float(), micro["target"], micro["pad_mask"])
                    fraction = (~micro["pad_mask"]).sum().item() * 10 / valid_count
                    loss = loss * fraction
                scaler.scale(loss).backward()
                batch_loss += float(loss.detach())
            scaler.unscale_(optimizer)
            norm = torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            if not cuda and not torch.isfinite(norm):
                raise FloatingPointError("Nonfinite CPU gradient")
            old_scale = scaler.get_scale()
            scaler.step(optimizer)
            scaler.update()
            if scaler.get_scale() >= old_scale:
                update_ema(ema, model, config.ema_decay)
            step += 1
            train_total += batch_loss
            train_count += 1
            check = step % config.save_every == 0 or step == stop
            evaluate = step % config.val_every == 0 or check
            if evaluate:
                last_val = validate(ema, val_loader, device, cuda)
            if step % config.log_every == 0 or evaluate:
                if cuda:
                    torch.cuda.synchronize(device)
                elapsed = time.monotonic() - started
                throughput = (step - logged_step) / max(elapsed, 1e-9)
                train_loss = train_total / train_count
                writer.writerow(
                    [step, train_loss, last_val, optimizer.param_groups[1]["lr"], throughput]
                )
                log.flush()
                print(
                    f"step={step} train={train_loss:.5f} val={last_val:.5f} "
                    f"lr={optimizer.param_groups[1]['lr']:.3g} it/s={throughput:.2f}",
                    flush=True,
                )
                train_total, train_count = 0.0, 0
                started, logged_step = time.monotonic(), step
            if check:
                atomic_save(
                    {
                        "version": 1,
                        "config": asdict(config),
                        "model": model.state_dict(),
                        "ema": ema.state_dict(),
                        "optimizer": optimizer.state_dict(),
                        "scaler": scaler.state_dict(),
                        "step": step,
                        "rng": rng_state(cuda),
                        "stats": store.stats,
                        "data_digest": store.digest,
                        "train_episodes": [store.files[i] for i in store.train_ids],
                        "val_episodes": [store.files[i] for i in store.val_ids],
                        "val_loss": last_val,
                    },
                    checkpoint_path,
                )
    peak = torch.cuda.max_memory_allocated(device) / 1e9 if cuda else 0.0
    reserved = torch.cuda.max_memory_reserved(device) / 1e9 if cuda else 0.0
    print(f"Peak CUDA memory: allocated={peak:.3f} GB, reserved={reserved:.3f} GB", flush=True)
    if cuda and reserved >= 3.0:
        raise RuntimeError("Memory budget exceeded; lower --microbatch-size in a new run")
    return checkpoint_path


def read_config(path):
    """Flat YAML (scalars/inline lists) or JSON; no PyYAML dependency."""
    text = Path(path).read_text()
    if text.lstrip().startswith("{"):
        return json.loads(text)
    result = {}
    for number, line in enumerate(text.splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition(":")
        if not separator or not value.strip():
            raise ValueError(f"Config line {number}: expected key: scalar or inline list")
        value = value.strip()
        try:
            parsed = json.loads(value)
        except json.JSONDecodeError:
            try:
                parsed = ast.literal_eval(value)
            except (ValueError, SyntaxError):
                parsed = value
        result[key.strip().replace("-", "_")] = parsed
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=Path)
    for field in fields(Config):
        name = "--" + field.name.replace("_", "-")
        options = {"default": argparse.SUPPRESS}
        if field.name == "data_dirs":
            options["nargs"] = "+"
        elif field.type is bool:
            options["action"] = argparse.BooleanOptionalAction
        else:
            options["type"] = field.type
        parser.add_argument(name, **options)
    args = vars(parser.parse_args())
    config_path = args.pop("config")
    values = read_config(config_path) if config_path else {}
    values.update(args)
    if "data_dirs" in values:
        if not isinstance(values["data_dirs"], (list, tuple)):
            parser.error("data_dirs must be an inline list or --data-dirs DIR [DIR ...]")
        values["data_dirs"] = tuple(values["data_dirs"])
    train(Config(**values))


if __name__ == "__main__":
    main()
"""Shared BC network; kept in submission so evaluator digests cover inference code."""

import torch
from torch import nn
from torch.nn import functional as F
from torchvision.models import ResNet18_Weights, resnet18

ACTIVE_DIMS = (0, 1, 4, 5, 6, 7, 8, 9, 10, 18)
PROPRIO_DIMS = (*range(9), *range(18, 22), *range(40, 44), 44, 45)


class SpatialSoftmax(nn.Module):
    def __init__(self):
        super().__init__()
        self.project = nn.Conv2d(256, 32, 1)

    def forward(self, features):
        features = self.project(features)
        h, w = features.shape[-2:]
        # Accumulate probabilities in fp32 even under autocast.
        probabilities = features.flatten(2).float().softmax(-1)
        y, x = torch.meshgrid(
            torch.linspace(-1, 1, h, device=features.device),
            torch.linspace(-1, 1, w, device=features.device),
            indexing="ij",
        )
        return torch.stack(
            (probabilities @ x.flatten(), probabilities @ y.flatten()), dim=-1
        ).flatten(1)


def random_shift(images, pad=4):
    """DrQ replication padding + independent integer translation per camera image."""
    n, _, h, w = images.shape
    padded = F.pad(images, (pad, pad, pad, pad), mode="replicate")
    offsets = torch.randint(2 * pad + 1, (n, 2), device=images.device)
    ys = offsets[:, 0, None, None] + torch.arange(h, device=images.device)[None, :, None]
    xs = offsets[:, 1, None, None] + torch.arange(w, device=images.device)[None, None, :]
    return padded.permute(0, 2, 3, 1)[
        torch.arange(n, device=images.device)[:, None, None], ys, xs
    ].permute(0, 3, 1, 2)


class BCModel(nn.Module):
    def __init__(self, horizon=20, pretrained=True):
        super().__init__()
        if not 1 <= horizon <= 50:
            raise ValueError("horizon must be in [1, 50]")
        self.horizon = horizon
        network = resnet18(weights=ResNet18_Weights.DEFAULT if pretrained else None)
        self.backbone = nn.Sequential(*list(network.children())[:7])  # through layer3
        self.spatial = SpatialSoftmax()
        self.camera_embedding = nn.Embedding(3, 16)
        self.proprio = nn.Sequential(nn.Linear(len(PROPRIO_DIMS), 128), nn.GELU())
        self.head = nn.Sequential(
            nn.Linear(3 * (64 + 16) + 128, 512),
            nn.GELU(),
            nn.Dropout(0.1),
            nn.Linear(512, 512),
            nn.GELU(),
            nn.Dropout(0.1),
            nn.Linear(512, horizon * len(ACTIVE_DIMS)),
        )
        self.register_buffer("image_mean", torch.tensor([0.485, 0.456, 0.406])[None, :, None, None])
        self.register_buffer("image_std", torch.tensor([0.229, 0.224, 0.225])[None, :, None, None])
        self.train()

    def train(self, mode=True):
        super().train(mode)
        # Freeze ImageNet BN statistics: small correlated robot batches give noisy
        # estimates. Affine parameters and all convolution weights still train.
        for layer in self.backbone.modules():
            if isinstance(layer, nn.BatchNorm2d):
                layer.eval()
        return self

    def forward(self, rgb, proprio):
        batch = rgb.shape[0]
        images = rgb.reshape(-1, 3, 84, 84).float().div(255)
        if self.training:
            images = random_shift(images)
        images = (images - self.image_mean) / self.image_std
        features = self.spatial(self.backbone(images)).reshape(batch, 3, 64)
        cameras = self.camera_embedding.weight[None].expand(batch, -1, -1)
        vision = torch.cat((features, cameras), dim=-1).flatten(1)
        return self.head(torch.cat((vision, self.proprio(proprio)), dim=-1)).reshape(
            batch, self.horizon, len(ACTIVE_DIMS)
        )


def masked_l1(prediction, target, pad_mask):
    """True means padding; padding contributes neither loss nor denominator."""
    valid = (~pad_mask).unsqueeze(-1)
    return ((prediction - target).abs() * valid).sum() / (
        valid.sum().clamp_min(1) * prediction.shape[-1]
    )
"""Observation-only BC policy. Set ADV_CKPT to an EMA training checkpoint."""

import os
from pathlib import Path

import numpy as np
import torch

from .model import ACTIVE_DIMS, PROPRIO_DIMS, BCModel


class BCPolicy:
    def __init__(self, checkpoint):
        self.device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        # Our own checkpoints contain optimizer/RNG objects as well as tensors.
        checkpoint = torch.load(checkpoint, map_location="cpu", weights_only=False)
        config = checkpoint["config"]
        self.horizon = config["horizon"]
        self.exec_steps = config["exec_steps"]
        if not 1 <= self.exec_steps <= self.horizon <= 50:
            raise ValueError("Require 1 <= exec_steps <= horizon <= 50")
        self.model = BCModel(self.horizon, pretrained=False)
        self.model.load_state_dict(checkpoint["ema"])
        self.model.to(self.device).eval()
        stats = checkpoint["stats"]
        self.mean = np.asarray(stats["proprio_mean"], dtype=np.float32)
        self.std = np.asarray(stats["proprio_std"], dtype=np.float32)
        self.action_mean = np.asarray(stats["action_mean"], dtype=np.float32)
        if self.mean.shape != (19,) or self.std.shape != (19,) or self.action_mean.shape != (20,):
            raise ValueError("Checkpoint normalization shapes do not match this policy")
        self.temporal_ensemble = config.get("temporal_ensemble", False)
        self.ensemble_decay = config.get("ensemble_decay", 0.01)
        self.reset()

    def reset(self):
        self.time = 0
        self.predictions = []

    @torch.inference_mode()
    def __call__(self, obs):
        rgb = np.asarray(obs["rgb"], dtype=np.uint8)
        state = np.asarray(obs["state"], dtype=np.float32)
        if rgb.shape != (3, 3, 84, 84) or state.shape != (50,):
            raise ValueError("Expected RGB (3,3,84,84) and state (50,)")
        proprio = (state[list(PROPRIO_DIMS)] - self.mean) / self.std
        chunk = (
            self.model(
                torch.from_numpy(rgb.copy())[None].to(self.device),
                torch.from_numpy(proprio)[None].to(self.device),
            )[0]
            .float()
            .cpu()
            .numpy()
        )
        active = chunk[: self.exec_steps].copy()
        if self.temporal_ensemble:
            # Observations still arrive only every exec_steps control steps.
            self.predictions = [(t, p) for t, p in self.predictions if t + self.horizon > self.time]
            self.predictions.append((self.time, chunk))
            for offset in range(self.exec_steps):
                candidates = [
                    p[self.time + offset - t]
                    for t, p in self.predictions
                    if 0 <= self.time + offset - t < self.horizon
                ]
                # ACT convention: older overlapping predictions get more weight.
                weights = np.exp(-self.ensemble_decay * np.arange(len(candidates)))
                active[offset] = np.average(candidates, axis=0, weights=weights)
        self.time += self.exec_steps
        actions = np.broadcast_to(self.action_mean, (self.exec_steps, 20)).copy()
        actions[:, ACTIVE_DIMS] = active
        actions[:, 18] = np.where(actions[:, 18] >= 0, 1.0, -1.0)
        if not np.isfinite(actions).all():
            raise ValueError("BC prediction contains nonfinite actions")
        return np.clip(actions, -1, 1).astype(np.float32)


def make_policy():
    path = os.environ.get("ADV_CKPT") or Path(__file__).parent / "weights" / "policy.pt"
    return BCPolicy(path)
"""Export once in the sim environment: uv run python -m method.bc.export_human."""

import argparse
import json
import os
import tempfile
from pathlib import Path

import numpy as np


def export(out, metadata=None):
    out = Path(out)
    out.mkdir(parents=True, exist_ok=True)
    if all((out / f"ep_{i}.npz").exists() for i in range(60)):
        print("All 60 episodes already exist; nothing to load.")
        return
    records = {}
    if metadata is not None:
        records = {int(row["demo"]): row for row in json.loads(Path(metadata).read_text())}
    os.environ["ORT_DISABLE_TELEMETRY"] = "1"
    import onnxruntime

    onnxruntime.disable_telemetry_events()
    from bigym.loco import make_gym

    env = make_gym("move_plate")
    try:
        demos = env.get_demos(60)  # Once, in this process only; never in DataLoader workers.
        if len(demos) != 60:
            raise ValueError(f"Expected 60 demos, found {len(demos)}")
        for index, demo in enumerate(demos):
            path = out / f"ep_{index}.npz"
            if path.exists():
                continue
            actions = np.asarray(demo["action"], dtype=np.float32)
            length = len(actions)
            state = np.asarray(demo["obs"]["state"], dtype=np.float32)
            rgb = np.asarray(demo["obs"]["rgb"], dtype=np.uint8)
            if state.shape != (length + 1, 50) or rgb.shape != (length + 1, 3, 3, 84, 84):
                raise ValueError(f"Unexpected observation shape in demo {index}")
            # Unknown metadata stays unknown; no task-state reconstruction or rollout.
            record = records.get(index, {})
            seed = demo.get("seed", record.get("seed", -1))
            slot = demo.get("slot", record.get("slot", -1))
            with tempfile.NamedTemporaryFile(dir=out, suffix=".npz", delete=False) as stream:
                temporary = stream.name
                try:
                    np.savez_compressed(
                        stream,
                        rgb=rgb[:length:2],
                        rgb_stride=np.int64(2),
                        state=state[:length],
                        action=actions,
                        seed=np.int64(-1 if seed is None else seed),
                        slot=np.int64(-1 if slot is None else slot),
                        success=np.bool_(demo["success"]),
                    )
                    stream.flush()
                    os.fsync(stream.fileno())
                    os.replace(temporary, path)
                finally:
                    if os.path.exists(temporary):
                        os.unlink(temporary)
            print(f"{path}: {length} actions, {len(rgb[:length:2])} frames", flush=True)
    finally:
        env.close()


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--out", type=Path, default=Path("/home/keyu/advaitic/data/human60"))
    parser.add_argument("--metadata", type=Path, help="Optional human demo index/seed/slot JSON")
    args = parser.parse_args()
    export(args.out, args.metadata)

