"""Run the privileged teacher in one process and append completed episodes."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import sys
import tempfile
import time
from pathlib import Path

# Set before any simulator/controller imports. Training generator uses CPU only.
os.environ["ORT_DISABLE_TELEMETRY"] = "1"
os.environ["CUDA_VISIBLE_DEVICES"] = ""

import numpy as np

if __package__ in (None, ""):
    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from method.teacher.teacher import METHOD_DIR, REPO_DIR, Teacher

RGB_STRIDE = 2


def parse_seeds(specs: list[str]) -> list[int]:
    """Accept integers, comma lists and Python-style start:stop[:step] ranges."""
    seeds = []
    for spec in specs:
        for item in spec.split(","):
            if ":" in item:
                parts = [int(v) for v in item.split(":")]
                if len(parts) not in (2, 3) or (len(parts) == 3 and parts[2] == 0):
                    raise ValueError(f"Invalid seed range: {item}")
                seeds.extend(range(*parts))
            else:
                seeds.append(int(item))
    if not seeds or any(s < 0 or s > 2**32 - 1 for s in seeds):
        raise ValueError("Provide at least one seed, each in [0, 2**32-1]")
    return list(dict.fromkeys(seeds))


def read_records(stream) -> dict[int, dict]:
    """Ignore interrupted/malformed lines, preserving them in the append-only log."""
    stream.seek(0)
    records = {}
    for number, line in enumerate(stream, 1):
        if not line.strip():
            continue
        try:
            row = json.loads(line)
            if row.get("completed") is not True or type(row.get("seed")) is not int:
                raise ValueError("Not a completed episode record")
        except (ValueError, AttributeError) as exc:
            print(f"Ignoring JSONL line {number}: {exc}", file=sys.stderr, flush=True)
            continue
        if row["seed"] in records:
            raise ValueError(f"Duplicate completed seed in log: {row['seed']}")
        records[row["seed"]] = row
    return records


def append_record(stream, record: dict):
    """Append only after completion; fsync before reporting durable progress."""
    payload = json.dumps(record, allow_nan=False, separators=(",", ":")) + "\n"
    stream.seek(0, os.SEEK_END)
    # A previous SIGKILL may have left a partial final line. Preserve its bytes,
    # and separate the next record so it remains independently parseable.
    if stream.tell():
        stream.seek(stream.tell() - 1)
        if stream.read(1) != "\n":
            stream.write("\n")
    stream.write(payload)
    stream.flush()
    os.fsync(stream.fileno())


def save_demo(directory: Path, seed: int, slot: int, rgb, states, actions) -> Path:
    """Atomically publish successful pre-action observations and their actions."""
    destination = directory / f"ep_{seed}.npz"
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="wb", dir=directory, prefix=f".ep_{seed}_", suffix=".npz", delete=False
        ) as stream:
            temporary = Path(stream.name)
            np.savez_compressed(
                stream,
                rgb=np.asarray(rgb, dtype=np.uint8),
                state=np.asarray(states, dtype=np.float32),
                action=np.asarray(actions, dtype=np.float32),
                seed=np.int64(seed),
                slot=np.int64(slot),
                success=np.bool_(True),
                rgb_stride=np.int64(RGB_STRIDE),
            )
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, destination)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
    return destination


def run_episode(env, teacher: Teacher, seed: int, save_directory: Path | None) -> dict:
    started = time.monotonic()
    ts = env.reset(seed=seed)
    from advaitic_eval.environment import observed_source_slot

    slot = observed_source_slot(env)
    teacher.reset(env)
    rgb, states, actions = [], [], []
    steps = 0
    while not ts.last():
        action = teacher.act(ts)
        if action.shape != (20,) or not np.isfinite(action).all() or np.any(np.abs(action) > 1):
            raise ValueError("Teacher returned an invalid normalized action")
        if save_directory is not None:
            states.append(np.asarray(ts.low_dim_obs, dtype=np.float32).copy())
            actions.append(action.copy())
            if steps % RGB_STRIDE == 0:
                rgb.append(np.asarray(ts.rgb_obs, dtype=np.uint8).copy())
        ts = env.step(action)
        steps += 1
    fell = bool(env.episode_fell())
    success = bool(env.episode_succeeded() and not fell)
    record = {
        "seed": seed,
        "slot": slot,
        "chosen_demo": teacher.chosen_demo,
        "grasp_shift": teacher.grasp_shift.tolist(),
        "place_shift": teacher.place_shift.tolist(),
        "success": success,
        "completed": True,
        "termination": env.episode_termination(),
        "fell": fell,
        "steps": steps,
        "max_pelvis_tracking_error": teacher.max_tracking_error,
        "wait_steps": dict(teacher.wait_steps),
        "demo_step": teacher.demo_step,
        "demo_file": None,
    }
    if success and save_directory is not None:
        record["demo_file"] = str(save_demo(save_directory, seed, slot, rgb, states, actions))
    record["wall_time"] = time.monotonic() - started
    return record


def run(args) -> int:
    seeds = parse_seeds(args.seeds)
    teacher = Teacher(
        args.demos,
        args.meta,
        kp=args.kp,
        tolerance=args.tolerance,
        max_wait=args.max_wait,
    )
    # Prevent accidentally resuming a changed controller/data configuration.
    digest = hashlib.sha256()
    for path in (Path(__file__), Path(__file__).with_name("teacher.py"), args.demos, args.meta):
        digest.update(path.read_bytes())
    digest.update((REPO_DIR / "src/advaitic_eval/action_layout.json").read_bytes())
    digest.update(json.dumps(teacher.config, sort_keys=True).encode())
    run_id = digest.hexdigest()
    args.out.parent.mkdir(parents=True, exist_ok=True)
    if args.save_demos is not None:
        args.save_demos = args.save_demos.resolve()
        args.save_demos.mkdir(parents=True, exist_ok=True)
    with args.out.open("a+", encoding="utf-8") as stream:
        try:
            fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RuntimeError("Output JSONL is already in use; use one log per process") from exc
        records = read_records(stream)
        if any(row.get("run_id") != run_id for row in records.values()):
            raise ValueError("Controller/data configuration changed; choose a new --out JSONL")
        pending = [seed for seed in seeds if seed not in records]
        print(
            f"Requested {len(seeds)}; skipped {len(seeds) - len(pending)}; pending {len(pending)}"
        )
        if pending:
            # Import this worktree's evaluator, even with a sibling editable env.
            sys.path.insert(0, str(REPO_DIR / "src"))
            from advaitic_eval.environment import make_environment

            env = make_environment()
            try:
                for seed in pending:
                    record = run_episode(env, teacher, seed, args.save_demos)
                    record.update(run_id=run_id, teacher_config=teacher.config)
                    append_record(stream, record)
                    records[seed] = record
                    print(
                        f"seed={seed} slot={record['slot']} demo={record['chosen_demo']} "
                        f"success={record['success']} end={record['termination']} "
                        f"steps={record['steps']} error={record['max_pelvis_tracking_error']:.4f}m",
                        flush=True,
                    )
            finally:
                env.close()
        successes = sum(records[seed]["success"] for seed in seeds)
        print(
            f"Privileged teacher: {successes}/{len(seeds)} successful ({successes / len(seeds):.1%})"
        )
        for slot in range(6):
            rows = [records[s] for s in seeds if records[s]["slot"] == slot]
            print(f"  slot {slot}: {sum(r['success'] for r in rows)}/{len(rows)}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--seeds", nargs="+", required=True, help="e.g. 100000:100030 or 100000,100003 100008"
    )
    parser.add_argument("--out", type=Path, required=True, help="Append-only episode JSONL")
    parser.add_argument("--save-demos", type=Path, help="Save successful episodes atomically here")
    parser.add_argument("--demos", type=Path, default=METHOD_DIR / "data/demos_lowdim.npz")
    parser.add_argument("--meta", type=Path, default=METHOD_DIR / "data/demo_meta.json")
    parser.add_argument("--kp", type=float, default=2.0, help="Base position gain in 1/s")
    parser.add_argument("--tolerance", type=float, default=0.01, help="Gate tracking error in m")
    parser.add_argument("--max-wait", type=int, default=100, help="Max extra steps per event")
    args = parser.parse_args()
    try:
        return run(args)
    except KeyboardInterrupt:
        print(
            "Interrupted; unfinished episode was not logged. Resume with the same command.",
            file=sys.stderr,
        )
        return 130
    except (ValueError, RuntimeError, OSError) as exc:
        parser.exit(2, f"{type(exc).__name__}: {exc}\n")


if __name__ == "__main__":
    raise SystemExit(main())
# Privileged demo-transfer teacher

This is a training-demonstration generator, **not an evaluated student policy**.
It reads the real plate pose and destination rack origin at reset. This privileged
geometry is unavailable to a student during evaluation. It never changes physics,
poses, termination, success checks, or the evaluator. Human demonstrations come
from the supplied BiGym2-derived `method/data/demos_lowdim.npz` and
`method/data/demo_meta.json`; the controller and tooling were implemented with Codex.

## Controller

`Teacher.reset(env)` reads geometry after the environment's ordinary reset and
warmup. The first `act(ts)` uses that reset timestep's pelvis xy to select the demo
with nearest plate-relative-to-starting-pelvis xy. It excludes demo 45, which was
reported to fail even on its original seed. Selection uses neither seed nor source
slot. `nearest_demos(plate_xy, pelvis_xy, top_n=N)` also returns ranked candidates.

For reference demo k, the world-frame translations are:

```text
g = (plate_xy - pelvis0_xy) - (demo_plate_xy - demo_pelvis0_xy)
h = target_rack_offset_xy - demo_target_rack_offset_xy
desired_pelvis_xy(t) = demo_pelvis_xy(t) + shift(t)
```

The destination rack's nominal xy origin is `[0.55, -0.24]`, read from the pinned
`MovePlateG1` implementation. The source plate comes from `get_pose()[:2]` after
warmup. The destination remains the reference demo's placement location translated
with its rack; v1 does not infer a destination slot or replay demos to label one.
The sampled source slot is recorded by the runner for analysis only.

`shift(t)` is g through `grasp_step + 30`, blends linearly to h through
`release_step - 40`, then stays at h. The default proportional gain is 2/s. Rotate
the world xy position error by minus the observed pelvis yaw, add feedback to the
demo's raw body-frame vx/vy, clip to the raw action bounds, and normalize again.
Height, yaw command, both arms and both grippers retain the demo's targets.

The single demo clock stops **before** the closing/opening action when xy error is
at least 1 cm, holding the preceding arm/gripper targets for at most 100 additional
environment steps per event. During a wait, velocity feed-forward is zero and the
pelvis target is fixed. The event proceeds when error drops below 1 cm or the wait
budget expires. These waits count toward the unchanged 1,700-step episode budget.
After the demo ends, hold its final action with both grippers open, without further
base corrections, until the environment terminates. There is no grasp detection,
retry, or candidate switching in v1; measure v1 before adding those features.

API example (inside an operator-run simulator process):

```python
from advaitic_eval.environment import make_environment
from method.teacher.teacher import Teacher

env = make_environment()
teacher = Teacher()
try:
    ts = env.reset(seed=100000)
    teacher.reset(env)
    while not ts.last():
        ts = env.step(teacher.act(ts))
    print(env.episode_succeeded(), env.episode_termination())
finally:
    env.close()
```

## Commands

Run from the worktree root. Use the committed lockfile; no dependency changes are
needed. If this worktree has no environment, the operator can prepare one with:

```bash
cd /home/keyu/advaitic/wt-teacher
uv sync --locked
```

CPU-only implementation checks (fake environments only; no rendering or rollout):

```bash
ORT_DISABLE_TELEMETRY=1 uv run --locked ruff check method
ORT_DISABLE_TELEMETRY=1 uv run --locked ruff format --check method
ORT_DISABLE_TELEMETRY=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src \
  uv run --locked python -m unittest discover -s method/teacher -p 'test_*.py' -v
uv run --locked python -m method.teacher.run_teacher --help
```

Generate and measure on fresh **training** seeds; the upper range endpoint is
exclusive. These example seeds are outside the provided demo seed set. Keep them
separate from any final reviewer evaluation block:

```bash
ORT_DISABLE_TELEMETRY=1 MUJOCO_GL=egl uv run --locked \
  python -m method.teacher.run_teacher \
  --seeds 100000:100030 \
  --out method/teacher/runs/v1.jsonl \
  --save-demos method/teacher/generated/v1
```

Run the identical command to resume: completed seeds, including failures, are
skipped. Explicit lists, comma-separated lists and stepped ranges also work, e.g.
`--seeds 100000,100003 100008 100010:100020:2`. Logs include per-slot counts; a
consecutive seed block is not necessarily balanced across slots. For a balanced
30-episode diagnostic block, print a seed list using the unchanged protocol and
paste those integers after `--seeds` with a **new** output filename:

```bash
uv run --locked python -c 'from advaitic_eval.protocol import make_plan; print(" ".join(str(ep.seed) for ep in make_plan(30, 100000)))'
```

For an open-loop nearest-demo ablation, run the same seeds with
`--kp 0 --max-wait 0` and a new output filename. Change `--kp`, `--tolerance`
(meters), or `--max-wait` only in separate experiment logs. The log stores these
settings and a hash of the controller, runner, data, metadata and action bounds;
resuming with a changed configuration is rejected.

The runner is always single-process and launches no workers. To use two processes,
the operator can run the following in **two terminals**, at most two at once, with
disjoint seeds and separate logs. No `--workers` argument is needed:

```bash
# Terminal 1
ORT_DISABLE_TELEMETRY=1 MUJOCO_GL=egl uv run --locked \
  python -m method.teacher.run_teacher --seeds 100000:100060:2 \
  --out method/teacher/runs/v1_even.jsonl --save-demos method/teacher/generated/v1

# Terminal 2
ORT_DISABLE_TELEMETRY=1 MUJOCO_GL=egl uv run --locked \
  python -m method.teacher.run_teacher --seeds 100001:100060:2 \
  --out method/teacher/runs/v1_odd.jsonl --save-demos method/teacher/generated/v1
```

The runner disables ONNX telemetry and hides CUDA devices before importing the
simulator. EGL graphics may still use the operator's GPU for rendering. On a host
with CPU rendering available, replace `MUJOCO_GL=egl` with `MUJOCO_GL=osmesa`.

## Logs and successful demonstrations

Each completed episode adds one JSONL record: seed, zero-based sampled source slot,
chosen demo, grasp/place xy shifts in meters, success, termination, fall flag,
steps, maximum pre-action pelvis xy tracking error in meters, event wait counts,
demo clock, saved path, configuration hash and wall time in seconds. Wall time
includes reset and saving. Success requires `episode_succeeded()` and no fall;
the runner steps until the real environment terminates, including its held-success
requirement. Ordinary falls/timeouts are logged failures. An exception or Ctrl-C
leaves the unfinished seed pending and stops the run. Completed episodes alone
enter the summary, and failures are never removed when resuming.

The log is append-only and flushed/fsynced after each completed episode. A file
lock rejects simultaneous writers to the same log. A kill during append can leave
a partial line: readers warn and ignore malformed lines; the next append preserves
that fragment and starts its record on a new line. Never share overlapping seeds
between processes writing into the same demonstration directory.

With `--save-demos DIR`, successful episodes produce `DIR/ep_<seed>.npz`:

| Key | Shape / contents |
| --- | --- |
| `state` | `(T, 50)` float32, every **pre-action** observation |
| `action` | `(T, 20)` float32, normalized action paired with each state |
| `rgb` | `(ceil(T/2), 3, 3, 84, 84)` uint8, pre-action RGB at indices 0, 2, 4, ... |
| `rgb_stride` | scalar integer 2; `rgb[j]` pairs with `state[2*j]` |
| `seed`, `slot` | scalar integers; slot is zero-based |
| `success` | scalar boolean true |

T is the number of executed control steps through environment termination. There
is no terminal post-action observation in these arrays. Unsuccessful episodes
produce log records but no NPZ. Saving uses a temporary file in DIR, fsync, then
`os.replace`; the completed record is appended afterward. A kill can leave an
ignored `.ep_*.npz` temporary file or a complete NPZ without a log record. Rerunning
that pending seed atomically replaces its NPZ. Enable `--save-demos` from the start
if data are wanted: resuming a log does not backfill already-completed episodes.

## Verification in the coding sandbox

Five CPU-only checks passed: all 59 usable demo action streams are reproduced when
fed their recorded states with zero residual; selection/shift blending/body-frame
feedback; bounded grasp/release waits; interrupted JSONL recovery; and runner
resume/failure/interruption plus NPZ dtype, stride and temporal alignment. These
use fake environments and are **not task-solving rollouts**.

The worktree lacked `.venv`. Checks used the existing neighboring environment with
the same `pyproject.toml` and `uv.lock` (both compared byte-for-byte):

```bash
export UV_PROJECT_ENVIRONMENT=/home/keyu/advaitic/robot-learning-assignment/.venv
export UV_CACHE_DIR=/tmp/teacher-uv-cache
export RUFF_CACHE_DIR=/tmp/teacher-ruff-cache
ORT_DISABLE_TELEMETRY=1 uv run --locked --no-sync ruff check method
ORT_DISABLE_TELEMETRY=1 uv run --locked --no-sync ruff format --check method
ORT_DISABLE_TELEMETRY=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src \
  uv run --locked --no-sync python -m unittest discover -s method/teacher -p 'test_*.py' -v
```

No GPU was used. A CPU OSMesa probe failed on import with
`AttributeError: 'NoneType' object has no attribute 'glGetError'`. No simulator
episodes were run. **The teacher's real success rate and the ≥90% goal remain
unverified.** Privileged teacher results are training-workflow measurements and
cannot establish the student policy's assignment target.
"""CPU-only contract checks using fake timesteps/environments, never rollouts."""

from __future__ import annotations

import contextlib
import io
import tempfile
import unittest
from pathlib import Path
from types import SimpleNamespace
from unittest.mock import patch

import numpy as np

from method.teacher.run_teacher import append_record, parse_seeds, read_records, run
from method.teacher.teacher import METHOD_DIR, TARGET_RACK_XY, Teacher


def reset_geometry(teacher, demo=0, grasp_shift=None, place_shift=None):
    """A fake geometry reader; this never constructs or changes simulator state."""
    g = np.zeros(2) if grasp_shift is None else np.asarray(grasp_shift)
    h = np.zeros(2) if place_shift is None else np.asarray(place_shift)
    row = teacher.meta[demo]
    plate = np.asarray(row["plate_pose_after_warmup"]).copy()
    plate[:2] += g
    target = np.zeros(3)
    target[:2] = TARGET_RACK_XY + np.asarray(row["target_rack_offset"])[:2] + h
    return SimpleNamespace(
        inner_env=SimpleNamespace(
            plates=[SimpleNamespace(get_pose=lambda: plate.copy())],
            rack_target=SimpleNamespace(get_position=lambda: target.copy()),
            _advaitic_initial_slot=row["slot"],
        )
    )


class FakeEpisode:
    def __init__(self, teacher, success=True, interrupt=False):
        self.inner_env = reset_geometry(teacher).inner_env
        self.state0 = teacher.states[0][0].copy()
        self.success = success
        self.interrupt = interrupt
        self.closed = False

    def timestep(self):
        state = self.state0.copy()
        state[0] = self.index
        return SimpleNamespace(
            low_dim_obs=state,
            rgb_obs=np.full((3, 3, 84, 84), self.index, dtype=np.uint8),
            last=lambda: self.index >= 5,
        )

    def reset(self, *, seed):
        self.index = 0
        return self.timestep()

    def step(self, action):
        if self.interrupt and self.index == 1:
            raise KeyboardInterrupt
        self.index += 1
        return self.timestep()

    def episode_fell(self):
        return False

    def episode_succeeded(self):
        return self.success

    def episode_termination(self):
        return "success" if self.success else "timeout"

    def close(self):
        self.closed = True


class TeacherChecks(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.teacher = Teacher()

    def test_all_usable_demo_trajectories_at_zero_error(self):
        # If observations match the reference trajectory exactly, feedback and
        # gates must preserve every recorded action for all 59 usable demos.
        teacher = self.teacher
        for k in teacher.demo_ids.tolist():
            teacher.reset(reset_geometry(teacher, demo=k))
            candidates = teacher.nearest_demos(
                teacher.plate_xy, teacher.states[k][0, 18:20], top_n=60
            )
            self.assertEqual(candidates[0], k)
            self.assertEqual(len(candidates), 59)
            self.assertNotIn(45, candidates)
            for t, expected in enumerate(teacher.actions[k]):
                ts = SimpleNamespace(low_dim_obs=teacher.states[k][t])
                action = teacher.act(ts)
                self.assertEqual(action.dtype, np.float32)
                np.testing.assert_allclose(action, expected, atol=1e-6)
            self.assertEqual(teacher.wait_steps, {"grasp": 0, "release": 0})
            final_ts = SimpleNamespace(low_dim_obs=teacher.states[k][-1])
            for _ in range(3):
                np.testing.assert_array_equal(teacher.act(final_ts), teacher.actions[k][-1])

    def test_shifts_blend_and_rotated_feedback(self):
        teacher = self.teacher
        g, h = np.array([0.001, -0.001]), np.array([0.04, -0.03])
        teacher.reset(reset_geometry(teacher, grasp_shift=g, place_shift=h))
        first = teacher.states[0][0].copy()
        teacher.act(SimpleNamespace(low_dim_obs=first))
        self.assertEqual(teacher.chosen_demo, 0)
        np.testing.assert_allclose(teacher.grasp_shift, g, atol=1e-7)
        np.testing.assert_allclose(teacher.place_shift, h, atol=1e-7)
        start = teacher.meta[0]["grasp_step"] + 30
        end = teacher.meta[0]["release_step"] - 40
        np.testing.assert_allclose(teacher.shift_at(start), g)
        np.testing.assert_allclose(teacher.shift_at(end), h)
        np.testing.assert_allclose(teacher.shift_at((start + end) / 2), (g + h) / 2)
        teacher.demo_step = 1
        state = teacher.states[0][1].copy()
        state[18:20] += g - np.array([0.02, 0.0])
        state[21] = np.pi / 2
        action = teacher.act(SimpleNamespace(low_dim_obs=state))
        expected_xy = teacher.actions[0][1, :2] + np.array([0.0, -0.04])
        np.testing.assert_allclose(action[:2], expected_xy, atol=1e-6)
        np.testing.assert_array_equal(action[2:], teacher.actions[0][1, 2:])
        teacher.demo_step = 1
        state[18:20] -= 100
        saturated = teacher.act(SimpleNamespace(low_dim_obs=state))
        self.assertTrue(np.isfinite(saturated).all())
        self.assertTrue((np.abs(saturated) <= 1).all())

    def test_grasp_release_gates_and_wait_limit(self):
        teacher = self.teacher
        for event in ("grasp", "release"):
            teacher.reset(reset_geometry(teacher))
            teacher.act(SimpleNamespace(low_dim_obs=teacher.states[0][0]))
            t = teacher.meta[0][f"{event}_step"]
            teacher.demo_step = t
            state = teacher.states[0][t].copy()
            state[18:20] += teacher.shift_at(t)
            state[18] -= 0.03
            ts = SimpleNamespace(low_dim_obs=state)
            for _ in range(100):
                action = teacher.act(ts)
                self.assertEqual(teacher.demo_step, t)
                np.testing.assert_array_equal(action[2:], teacher.actions[0][t - 1, 2:])
            action = teacher.act(ts)
            self.assertEqual(teacher.demo_step, t + 1)
            self.assertEqual(teacher.wait_steps[event], 100)
            np.testing.assert_array_equal(action[2:], teacher.actions[0][t, 2:])
            # With zero error there is no wait before the gripper event.
            teacher.reset(reset_geometry(teacher))
            teacher.act(SimpleNamespace(low_dim_obs=teacher.states[0][0]))
            teacher.demo_step = t
            state = teacher.states[0][t].copy()
            state[18:20] += teacher.shift_at(t)
            teacher.act(SimpleNamespace(low_dim_obs=state))
            self.assertEqual(teacher.wait_steps[event], 0)
            self.assertEqual(teacher.demo_step, t + 1)

    def test_seed_parser_and_interrupted_jsonl(self):
        self.assertEqual(parse_seeds(["10:16:2", "12,20", "22"]), [10, 12, 14, 20, 22])
        with self.assertRaises(ValueError):
            parse_seeds(["1:2:0"])
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / "episodes.jsonl"
            with path.open("a+") as stream:
                append_record(stream, {"seed": 10, "completed": True})
                stream.write('{"seed":11')
                stream.flush()
                append_record(stream, {"seed": 12, "completed": True})
                with contextlib.redirect_stderr(io.StringIO()):
                    self.assertEqual(set(read_records(stream)), {10, 12})
            self.assertIn('{"seed":11\n', path.read_text())

    def test_runner_alignment_failures_and_resume(self):
        # Exercise real runner/logging/NPZ code, but never construct a simulator.
        import advaitic_eval.environment

        with tempfile.TemporaryDirectory() as directory:
            directory = Path(directory)
            args = SimpleNamespace(
                seeds=["100000:100002"],
                out=directory / "episodes.jsonl",
                save_demos=directory,
                demos=METHOD_DIR / "data/demos_lowdim.npz",
                meta=METHOD_DIR / "data/demo_meta.json",
                kp=2.0,
                tolerance=0.01,
                max_wait=100,
            )
            fake = FakeEpisode(self.teacher)
            with patch.object(advaitic_eval.environment, "make_environment", return_value=fake):
                with contextlib.redirect_stdout(io.StringIO()):
                    self.assertEqual(run(args), 0)
            self.assertTrue(fake.closed)
            with np.load(directory / "ep_100000.npz") as data:
                self.assertEqual(data["state"].shape, (5, 50))
                self.assertEqual(data["action"].shape, (5, 20))
                self.assertEqual(data["rgb"].shape, (3, 3, 3, 84, 84))
                self.assertEqual(data["rgb"].dtype, np.uint8)
                self.assertEqual(data["state"].dtype, np.float32)
                self.assertEqual(data["action"].dtype, np.float32)
                np.testing.assert_array_equal(data["state"][:, 0], np.arange(5))
                np.testing.assert_array_equal(data["rgb"][:, 0, 0, 0, 0], [0, 2, 4])
                self.assertEqual(int(data["rgb_stride"]), 2)
                self.assertTrue(data["success"])
            before = args.out.read_bytes()
            with patch.object(advaitic_eval.environment, "make_environment") as factory:
                with contextlib.redirect_stdout(io.StringIO()):
                    run(args)
                factory.assert_not_called()
            self.assertEqual(args.out.read_bytes(), before)
            args.seeds = ["100002"]
            fake = FakeEpisode(self.teacher, success=False)
            with patch.object(advaitic_eval.environment, "make_environment", return_value=fake):
                with contextlib.redirect_stdout(io.StringIO()):
                    run(args)
            self.assertFalse((directory / "ep_100002.npz").exists())
            with args.out.open("a+") as stream:
                rows = read_records(stream)
                self.assertEqual(len(rows), 3)
                self.assertFalse(rows[100002]["success"])
            before = args.out.read_bytes()
            args.seeds = ["100003"]
            fake = FakeEpisode(self.teacher, interrupt=True)
            with patch.object(advaitic_eval.environment, "make_environment", return_value=fake):
                with (
                    contextlib.redirect_stdout(io.StringIO()),
                    self.assertRaises(KeyboardInterrupt),
                ):
                    run(args)
            self.assertTrue(fake.closed)
            self.assertEqual(args.out.read_bytes(), before)
            self.assertFalse((directory / "ep_100003.npz").exists())


if __name__ == "__main__":
    unittest.main()

