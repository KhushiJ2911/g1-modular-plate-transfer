import json
import numpy as np
from pyquaternion import Quaternion
from advaitic_eval.environment import make_environment
from method.teacher.diagnostics import PrivilegedSensors, plate_up
from method.teacher.teacher import REPO_DIR

env = make_environment()
try:
    env.reset(seed=2000000)
    inner = env.inner_env
    sensors = PrivilegedSensors(inner)
    snap = sensors.snapshot(0)
    dims = [8, 9, 4, 7]
    names = json.loads((REPO_DIR / 'src/advaitic_eval/action_layout.json').read_text())['limb_names']
    expected = []
    for dim in dims:
        name = names[dim - 4]
        joint = next(j for j in inner.robot.limb_joints if j.name.rsplit('/', 1)[-1] == name)
        expected.append(inner.model.bind(joint).id)
        print('action_dim', dim, 'joint', joint.name)
    axes, anchors, hand = sensors.joint_geometry(dims)
    np.testing.assert_allclose(axes, inner.data.xaxis[expected])
    np.testing.assert_allclose(anchors, inner.data.xanchor[expected])
    assert hand.shape == (3,) and np.isfinite(hand).all()
    normal = plate_up(snap['pose'][3:])
    np.testing.assert_allclose(normal, Quaternion(snap['pose'][3:]).rotate([0, 0, 1]), atol=1e-12)
    print('normal_sensitivity_per_rad', np.linalg.norm(np.cross(axes, normal), axis=1).tolist())
    print('read_only_live_kinematics_ok', 'tilt_deg', snap['tilt_deg'])
finally:
    env.close()
