        f"{side}_shoulder_yaw_joint": (150.0, 4.0),
        f"{side}_elbow_joint": (100.0, 1.0),
        f"{side}_wrist_roll_joint": (20.0, 2.0),
        f"{side}_wrist_pitch_joint": (20.0, 2.0),
