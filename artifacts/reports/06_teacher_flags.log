ORT_DISABLE_TELEMETRY=1 MUJOCO_GL=egl uv run pytest -q
```

Never regenerate the upstream integrity manifest or the demonstration
endpoint fixture merely to get a failing test to pass. An intended change
requires a documented common-release update and revalidation.

Fixture pose injection is allowed only in evaluator tests. It must never
be presented as a policy rollout or a successful task-solving result.

Do not claim the 90% policy target was demonstrated by evaluator tests.
            [c * velocity[0] + s * velocity[1], -s * velocity[0] + c * velocity[1]]
        )

    def _correct_tilt(self):
        """Small bounded wrist roll/pitch correction, assuming a rigid grasp."""
        if self.tilt_before_correction is None:
            self.tilt_before_correction = self.current_snapshot["tilt_deg"]
        axes, _, _ = self.sensors.joint_geometry([8, 9])
        normal = plate_up(self.current_snapshot["pose"][3:])
        jac = np.cross(axes, normal).T
        if self.wrist_sensitivity is None:
            self.wrist_sensitivity = np.linalg.norm(jac, axis=0).tolist()
        # d(normal)/dq = world_axis cross normal. Damping bounds near-singular
        # wrists; only the local tilt-reducing component is requested.
        delta = np.linalg.solve(
            jac.T @ jac + 0.05 * np.eye(2), jac.T @ (np.array([0.0, -1.0, 0.0]) - normal)
        )
        length = np.linalg.norm(delta)
        delta *= min(1.0, self.config["wrist_step_rad"] / max(length, 1e-12))
        self.wrist_offset = np.clip(
            self.wrist_offset + delta,
            -self.config["wrist_limit_rad"],
            self.config["wrist_limit_rad"],
        )
        self.tilt_correction_steps += 1

    def _add_wrist_offset(self, action):
        action[8:10] += 2 * self.wrist_offset / (self.high[8:10] - self.low[8:10])
        return np.clip(action, -1, 1).astype(np.float32)

    def _act_v2(self, state, pelvis_error) -> np.ndarray:
        k, t, cfg = self.chosen_demo, self.demo_step, self.config
        actions, row = self.actions[k], self.meta[k]
        if self.release_snapshot is not None:
            return self._retreat_action()
        if t >= len(actions):
            action = actions[-1].copy()
            action[:2] = self._normalize_xy(np.zeros(2))
            action[18:20] = -1
            return self._add_wrist_offset(action)
        blend_end = row["release_step"] - cfg["pre_release_steps"]
        object_phase = t >= blend_end
        error = pelvis_error
        tolerance = cfg["tolerance"]
        if object_phase:
            snap = self.current_snapshot
            error = np.asarray(snap["site_xyz"])[:2] - np.asarray(snap["pose"])[:2]
            self.object_tracking_error = float(np.linalg.norm(error))
            tolerance = cfg["object_tolerance"]
        paused = False
        if t == row["grasp_step"]:
            if (
                self.tracking_error > cfg["tolerance"]
                and self.wait_steps["grasp"] < cfg["max_wait"]
            ):
                self.wait_steps["grasp"] += 1
                paused = True
        event = None
        if t == blend_end:
            event = "pre_release"
        elif t == row["release_step"]:
            event = "release"
        if event is not None:
            position_bad = self.object_tracking_error >= cfg["object_gate_tolerance"]
            tilt_bad = (
                event == "release"
                and self.current_snapshot["tilt_deg"] > cfg["tilt_limit_deg"]
                and self.tilt_correction_steps < cfg["tilt_max_wait"]
            )
            if (position_bad or tilt_bad) and self.wait_steps[event] < cfg["object_max_wait"]:
                self.wait_steps[event] += 1
                paused = True
                if tilt_bad:
                    self._correct_tilt()
        # At blend_end hold that pose: t-1 is appropriate for the actual gripper
        # transitions, but would step backwards across the pre-lowering gate.
        index = t - 1 if paused and event != "pre_release" else t
        action = self._add_wrist_offset(actions[index].copy())
        action[:2] = self._base_feedback(error, state[21], tolerance)
        if not paused:
            if t == row["release_step"]:
                action[:2] = self._normalize_xy(np.zeros(2))
                action[18:20] = -1
            self.demo_step += 1
        return action

    def _start_recovery(self, reason):
        self.recovery_phase = "hold"
        self.recovery_step = 0
        self.recovery_action = self.last_action.copy()
        self.recovery_action[:2] = self._normalize_xy(np.zeros(2))
        self.recovery_action[18:20] = -1
        self.rejoin_step = None
        self.recovery_events.append(
            {"step": self.physical_step, "reason": reason, "plate": self.current_snapshot}
        )

    def _recovery_action(self):
        cfg = self.config
        action = self.recovery_action.copy()
        if self.recovery_phase == "hold":
            self.recovery_step += 1
            if self.recovery_step >= cfg["recovery_hold_steps"]:
                self.recovery_phase = "lift"
                self.recovery_step = 0
                _, _, self.lift_start_xyz = self.sensors.joint_geometry([4, 7])
                self.lift_start_targets = action[[4, 7]].astype(float).copy()
            return action
        self.recovery_step += 1
        axes, anchors, hand = self.sensors.joint_geometry([4, 7])
        jac = np.cross(axes, hand - anchors).T
        fraction = min(1.0, self.recovery_step / cfg["recovery_lift_steps"])
        goal = self.lift_start_xyz + np.array([0.0, 0.0, cfg["recovery_lift_m"] * fraction])
        delta = np.linalg.solve(jac.T @ jac + 0.002 * np.eye(2), jac.T @ (goal - hand))
        delta = np.clip(delta, -0.015, 0.015)
        normalized = 2 * delta / (self.high[[4, 7]] - self.low[[4, 7]])
        limit = 2 * cfg["recovery_joint_limit_rad"] / (self.high[[4, 7]] - self.low[[4, 7]])
        action[[4, 7]] = np.clip(
            action[[4, 7]] + normalized,
            self.lift_start_targets - limit,
            self.lift_start_targets + limit,
        )
        action = np.clip(action, -1, 1).astype(np.float32)
        self.recovery_action = action.copy()
        if self.recovery_step >= cfg["recovery_lift_steps"]:
            self.recovery_phase = None
            self.rejoin_step = 0
            self.rejoin_action = action.copy()
            # Re-arm against additional disturbance rather than repeatedly
            # reacting to the same already-recorded displacement.
            self.retreat_baseline = self.current_snapshot
        return action

    def _retreat_action(self) -> np.ndarray:
        cfg, snap = self.config, self.current_snapshot
        elapsed = self.physical_step - self.release_physical_step
        reason = None
        if elapsed >= cfg["held_check_steps"] and not self.held_check_done:
            self.held_check_done = True
            if snap["held"]:
                if self.recovery_phase is None:
                    reason = "held_50_steps_after_opening"
                else:
                    # The requested recovery is already in progress. Retain
                    # the exact deadline observation without restarting it.
                    self.recovery_events[-1]["also_held_after_50_steps"] = True
        if self.recovery_phase is not None:
            return self._recovery_action()
        baseline = self.retreat_baseline
        distance = np.linalg.norm(np.asarray(snap["pose"])[:3] - np.asarray(baseline["pose"])[:3])
        if elapsed > cfg["release_settle_steps"]:
            if distance > cfg["retreat_distance"]:
                reason = reason or "plate_displacement"
            elif snap["tilt_deg"] > baseline["tilt_deg"] + cfg["retreat_tilt_deg"]:
                reason = reason or "plate_tilt_increased"
        if reason is not None:
            self._start_recovery(reason)
            return self._recovery_action()
        if elapsed <= cfg["release_settle_steps"]:
            return self.release_action.copy()
        actions = self.actions[self.chosen_demo]
        action = self._add_wrist_offset(actions[min(self.demo_step, len(actions) - 1)].copy())
        # No locomotion after release: do not drag a plate while withdrawing.
        action[:2] = self._normalize_xy(np.zeros(2))
        action[18:20] = -1
        if self.rejoin_step is not None:
            self.rejoin_step += 1
            weight = min(1.0, self.rejoin_step / cfg["recovery_rejoin_steps"])
            action[4:18] = (1 - weight) * self.rejoin_action[4:18] + weight * action[4:18]
            if weight == 1:
                self.rejoin_step = None
        if self.demo_step < len(actions):
            self.demo_step += 1
        return np.clip(action, -1, 1).astype(np.float32)
"""Run the privileged teacher in one process and append completed episodes."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import sys
import time
from pathlib import Path

# Set before any simulator/controller imports. Training generator uses CPU only.
os.environ["ORT_DISABLE_TELEMETRY"] = "1"
os.environ["CUDA_VISIBLE_DEVICES"] = ""

import numpy as np

if __package__ in (None, ""):
    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from method.teacher.dart import DartNoise, validate_scale
from method.teacher.labels import PrivilegedLabels, save_npz_atomic
from method.teacher.teacher import METHOD_DIR, REPO_DIR, Teacher

RGB_STRIDE = 2


def parse_seeds(specs: list[str]) -> list[int]:
    """Accept integers, comma lists and Python-style start:stop[:step] ranges."""
    seeds = []
    for spec in specs:
        for item in spec.split(","):
            if ":" in item:
                parts = [int(v) for v in item.split(":")]
                if len(parts) not in (2, 3) or (len(parts) == 3 and parts[2] == 0):
                    raise ValueError(f"Invalid seed range: {item}")
                seeds.extend(range(*parts))
            else:
                seeds.append(int(item))
    if not seeds or any(s < 0 or s > 2**32 - 1 for s in seeds):
        raise ValueError("Provide at least one seed, each in [0, 2**32-1]")
    return list(dict.fromkeys(seeds))


def read_records(stream) -> dict[int, dict]:
    """Ignore interrupted/malformed lines, preserving them in the append-only log."""
    stream.seek(0)
    records = {}
    for number, line in enumerate(stream, 1):
        if not line.strip():
            continue
        try:
            row = json.loads(line)
            if row.get("completed") is not True or type(row.get("seed")) is not int:
                raise ValueError("Not a completed episode record")
        except (ValueError, AttributeError) as exc:
            print(f"Ignoring JSONL line {number}: {exc}", file=sys.stderr, flush=True)
            continue
        if row["seed"] in records:
            raise ValueError(f"Duplicate completed seed in log: {row['seed']}")
        records[row["seed"]] = row
    return records


def append_record(stream, record: dict):
    """Append only after completion; fsync before reporting durable progress."""
    payload = json.dumps(record, allow_nan=False, separators=(",", ":")) + "\n"
    stream.seek(0, os.SEEK_END)
    # A previous SIGKILL may have left a partial final line. Preserve its bytes,
    # and separate the next record so it remains independently parseable.
    if stream.tell():
        stream.seek(stream.tell() - 1)
        if stream.read(1) != "\n":
            stream.write("\n")
    stream.write(payload)
    stream.flush()
    os.fsync(stream.fileno())


def save_demo(
    directory: Path, seed: int, slot: int, rgb, states, actions, executed, dart_noise, labels
) -> Path:
    """Atomically publish successful pre-action observations and their actions."""
    return save_npz_atomic(
        directory / f"ep_{seed}.npz",
        rgb=np.asarray(rgb, dtype=np.uint8),
        state=np.asarray(states, dtype=np.float32),
        action=np.asarray(actions, dtype=np.float32),
        action_executed=np.asarray(executed, dtype=np.float32),
        dart_noise=np.float32(dart_noise),
        seed=np.int64(seed),
        slot=np.int64(slot),
        success=np.bool_(True),
        rgb_stride=np.int64(RGB_STRIDE),
        **labels.arrays(),
    )


def run_episode(
    env, teacher: Teacher, seed: int, save_directory: Path | None, *, trace=None, dart_noise=0.0
) -> dict:
    started = time.monotonic()
    noise = DartNoise(seed, dart_noise)
    ts = env.reset(seed=seed)
    from advaitic_eval.environment import observed_source_slot

    slot = observed_source_slot(env)
    teacher.reset(env)
    if trace is not None:
        trace(0, teacher, teacher.current_snapshot, False)
    labels = PrivilegedLabels(env) if save_directory is not None else None
    rgb, states, actions, executed = [], [], [], []
    steps = 0
    while not ts.last():
        if labels is not None:
            labels.append(ts.low_dim_obs, teacher.current_snapshot)
        demo_step = teacher.demo_step
        action = teacher.act(ts)
        if action.shape != (20,) or not np.isfinite(action).all() or np.any(np.abs(action) > 1):
            raise ValueError("Teacher returned an invalid normalized action")
        action_executed = noise.execute(action, teacher, demo_step)
        if save_directory is not None:
            states.append(np.asarray(ts.low_dim_obs, dtype=np.float32).copy())
            actions.append(action.copy())
            executed.append(action_executed.copy())
            if steps % RGB_STRIDE == 0:
                rgb.append(np.asarray(ts.rgb_obs, dtype=np.uint8).copy())
        ts = env.step(action_executed)
        steps += 1
        snapshot = teacher.observe()
        if trace is not None:
            trace(steps, teacher, snapshot, ts.last())
    fell = bool(env.episode_fell())
    success = bool(env.episode_succeeded() and not fell)
    record = {
        "seed": seed,
        "dart_noise": noise.scale,
        "slot": slot,
        "chosen_demo": teacher.chosen_demo,
        "grasp_shift": teacher.grasp_shift.tolist(),
        "place_shift": teacher.place_shift.tolist(),
        "success": success,
        "completed": True,
        "termination": env.episode_termination(),
        "fell": fell,
        "steps": steps,
        "max_pelvis_tracking_error": teacher.max_tracking_error,
        "wait_steps": dict(teacher.wait_steps),
        "demo_step": teacher.demo_step,
        "demo_file": None,
    }
    record.update(teacher.diagnostics(success=success, fell=fell))
    if success and save_directory is not None:
        record["demo_file"] = str(
            save_demo(
                save_directory, seed, slot, rgb, states, actions, executed, noise.scale, labels
            )
        )
    record["wall_time"] = time.monotonic() - started
    return record


def run(args) -> int:
    dart_noise = validate_scale(args.dart_noise)
    seeds = parse_seeds(args.seeds)
    teacher = Teacher(
        args.demos,
        args.meta,
        mode=args.mode,
        kp=args.kp,
        tolerance=args.tolerance,
        max_wait=args.max_wait,
    )
    # Prevent accidentally resuming a changed controller/data configuration.
    digest = hashlib.sha256()
    for path in (
        Path(__file__),
        Path(__file__).with_name("teacher.py"),
        Path(__file__).with_name("diagnostics.py"),
        Path(__file__).with_name("dart.py"),
        Path(__file__).with_name("labels.py"),
        args.demos,
        args.meta,
    ):
        digest.update(path.read_bytes())
    digest.update((REPO_DIR / "src/advaitic_eval/action_layout.json").read_bytes())
    digest.update(json.dumps(teacher.config, sort_keys=True).encode())
    digest.update(json.dumps({"dart_noise": dart_noise}, sort_keys=True).encode())
    run_id = digest.hexdigest()
    args.out.parent.mkdir(parents=True, exist_ok=True)
    if args.save_demos is not None:
        args.save_demos = args.save_demos.resolve()
        args.save_demos.mkdir(parents=True, exist_ok=True)
    with args.out.open("a+", encoding="utf-8") as stream:
        try:
            fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RuntimeError("Output JSONL is already in use; use one log per process") from exc
        records = read_records(stream)
        if any(row.get("run_id") != run_id for row in records.values()):
            raise ValueError("Controller/data configuration changed; choose a new --out JSONL")
        pending = [seed for seed in seeds if seed not in records]
        print(
            f"Requested {len(seeds)}; skipped {len(seeds) - len(pending)}; pending {len(pending)}"
        )
        if pending:
            # Import this worktree's evaluator, even with a sibling editable env.
            sys.path.insert(0, str(REPO_DIR / "src"))
            from advaitic_eval.environment import make_environment

            env = make_environment()
            try:
                for seed in pending:
                    record = run_episode(env, teacher, seed, args.save_demos, dart_noise=dart_noise)
                    record.update(run_id=run_id, teacher_config=teacher.config)
                    append_record(stream, record)
                    records[seed] = record
                    print(
                        f"seed={seed} slot={record['slot']} demo={record['chosen_demo']} "
                        f"success={record['success']} category={record['failure_category']} "
                        f"end={record['termination']} "
                        f"steps={record['steps']} error={record['max_pelvis_tracking_error']:.4f}m",
                        flush=True,
                    )
            finally:
                env.close()
        successes = sum(records[seed]["success"] for seed in seeds)
        print(
            f"Privileged teacher: {successes}/{len(seeds)} successful ({successes / len(seeds):.1%})"
        )
        for slot in range(6):
            rows = [records[s] for s in seeds if records[s]["slot"] == slot]
            print(f"  slot {slot}: {sum(r['success'] for r in rows)}/{len(rows)}")
    return 0


def add_controller_arguments(parser):
    parser.add_argument("--mode", choices=("v1", "v2"), default="v2")
    parser.add_argument("--demos", type=Path, default=METHOD_DIR / "data/demos_lowdim.npz")
    parser.add_argument("--meta", type=Path, default=METHOD_DIR / "data/demo_meta.json")
    parser.add_argument("--kp", type=float, default=2.0, help="Base position gain in 1/s")
    parser.add_argument(
        "--tolerance",
        type=float,
        default=None,
        help="Pelvis gate tolerance in m (v1: .01; v2: .015)",
    )
    parser.add_argument(
        "--max-wait", type=int, default=100, help="Pelvis gate wait limit (v2: grasp only)"
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--seeds", nargs="+", required=True, help="e.g. 100000:100030 or 100000,100003 100008"
    )
    parser.add_argument("--out", type=Path, required=True, help="Append-only episode JSONL")
    parser.add_argument("--save-demos", type=Path, help="Save successful episodes atomically here")
    parser.add_argument(
        "--dart-noise",
        type=float,
        default=0.0,
        help="OU action noise scale (finite, nonnegative; default: 0 = off)",
    )
    add_controller_arguments(parser)
    args = parser.parse_args()
    try:
        return run(args)
    except KeyboardInterrupt:
        print(
            "Interrupted; unfinished episode was not logged. Resume with the same command.",
            file=sys.stderr,
        )
        return 130
    except (ValueError, RuntimeError, OSError) as exc:
        parser.exit(2, f"{type(exc).__name__}: {exc}\n")


if __name__ == "__main__":
    raise SystemExit(main())
"""Episode-local action drift, applied outside the clean teacher controller."""

from __future__ import annotations

import numpy as np

THETA = 0.15
GUARD_STEPS = 15


def validate_scale(scale: float) -> float:
    scale = float(scale)
    if not np.isfinite(scale) or scale < 0:
        raise ValueError("dart_noise must be finite and nonnegative")
    return scale


class DartNoise:
    """Discrete OU drift with the requested stationary marginal standard deviation.

    x[t+1] = (1-theta)*x[t] + std*sqrt(theta*(2-theta))*N(0,1).
    Start at zero; advance on every physical step, including protected steps.
    Guards mask the applied drift without modifying the teacher's clean action.
    """

    def __init__(self, seed: int, scale: float):
        self.scale = validate_scale(scale)
        self.rng = np.random.default_rng(seed + 10_000_019)
        self.value = np.zeros(20)
        self.std = np.zeros(20)
        self.std[:2] = 0.10 * self.scale
        self.std[4:11] = 0.02 * self.scale
        self.previous_closed = np.zeros(2, dtype=bool)
        self.last_transition = None
        self.transitions = None
        self.step = 0

    def execute(self, clean, teacher, demo_step: int) -> np.ndarray:
        """Call after teacher.act, with its demo clock from BEFORE that call."""
        closed = clean[18:20] > 0
        if np.any(closed != self.previous_closed):
            self.last_transition = self.step
        self.previous_closed = closed.copy()
        if self.transitions is None:
            reference = teacher.actions[teacher.chosen_demo]
            self.transitions = (
                np.flatnonzero(
                    np.any((reference[1:, 18:20] > 0) != (reference[:-1, 18:20] > 0), axis=1)
                )
                + 1
            )
            # A reference starting closed transitions on its first command.
            if np.any(reference[0, 18:20] > 0):
                self.transitions = np.r_[0, self.transitions]
            # The controller opens both fingers at the end even if a reference
            # were to finish closed. Guard that possible synthetic transition.
            if np.any(reference[-1, 18:20] > 0):
                self.transitions = np.r_[self.transitions, len(reference)]
        before_transition = np.any(
            (self.transitions >= demo_step) & (self.transitions - demo_step <= GUARD_STEPS)
        )
        after_transition = (
            self.last_transition is not None and self.step - self.last_transition <= GUARD_STEPS
        )
        retreat = teacher.config["mode"] == "v2" and teacher.release_physical_step is not None
        self.step += 1
        if self.scale == 0:
            return clean.copy()
        self.value = (1 - THETA) * self.value + (
            self.std * np.sqrt(THETA * (2 - THETA)) * self.rng.standard_normal(20)
        )
        if before_transition or after_transition or retreat:
            return clean.copy()
        return np.clip(clean + self.value, -1, 1).astype(np.float32)

