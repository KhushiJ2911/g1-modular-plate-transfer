"""Shared disk image cache, optional privileged labels, and per-source splits."""

import fcntl
import hashlib
import json
import os
import re
import tempfile
from contextlib import ExitStack
from pathlib import Path

import numpy as np
from torch.utils.data import Dataset

from .model import ACTIVE_DIMS, PROPRIO_DIMS, validate_proprio_dims

FRAME_SHAPE = (3, 3, 84, 84)
FRAME_BYTES = int(np.prod(FRAME_SHAPE))
# Shape suffix and whether the label is constant over the episode.
PRIV_LABELS = {
    "priv_plate_rel": ((3,), False),
    "priv_target_site_rel": ((3,), False),
    "priv_plate_tilt_deg": ((), False),
    "priv_held": ((), False),
    "priv_target_rack_offset": ((2,), True),
    "priv_start_rack_offset": ((2,), True),
}
AUX_LABELS = ("priv_plate_rel", "priv_target_site_rel", "priv_target_rack_offset", "priv_held")


def episode_files(directories):
    files = []
    for directory in directories:
        episodes = sorted(
            (
                p
                for p in Path(directory).resolve().glob("ep_*.npz")
                if re.fullmatch(r"ep_\d+", p.stem)
            ),
            key=lambda p: int(p.stem[3:]),
        )
        if not episodes:
            raise ValueError(f"No ep_<index>.npz files in {directory}")
        files.extend(episodes)
    if len(set(files)) != len(files):
        raise ValueError("Episode directories overlap")
    return files


def sidecar_path(path):
    return path.with_suffix(".priv.npz")


def read_priv(path, episode, length):
    """Embedded labels take precedence per key; absent dimensions are masked."""
    labels, available = {}, {}
    with ExitStack() as stack:
        sidecar = sidecar_path(path)
        extra = (
            stack.enter_context(np.load(sidecar, allow_pickle=False)) if sidecar.exists() else {}
        )
        for key, (suffix, constant) in PRIV_LABELS.items():
            source = episode if key in episode else extra
            present = key in source
            shape = suffix if constant else (length, *suffix)
            value = (
                np.asarray(source[key], dtype=np.float32)
                if present
                else np.zeros(shape, np.float32)
            )
            if value.shape != shape or not np.isfinite(value).all():
                raise ValueError(f"{path}: invalid {key} shape/values, expected {shape}")
            if key == "priv_held" and not np.isin(value, (0, 1)).all():
                raise ValueError(f"{path}: priv_held must be binary")
            labels[key] = value
            available[key] = present
    return labels, available


def build_cache(files, cache_dir):
    """Stream one compressed episode at a time; publish index last as commit marker."""
    signature = [
        (str(p), p.stat().st_size, p.stat().st_mtime_ns)
        for episode in files
        for p in (episode, sidecar_path(episode))
        if p.exists()
    ]
    digest = hashlib.sha256(json.dumps([2, signature]).encode()).hexdigest()[:24]
    cache_dir = Path(cache_dir)
    cache_dir.mkdir(parents=True, exist_ok=True)
    image_path = cache_dir / f"{digest}.u8"
    index_path = cache_dir / f"{digest}.npz"
    with (cache_dir / f"{digest}.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if image_path.exists() and index_path.exists():
            with np.load(index_path, allow_pickle=False) as index:
                expected = int(index["frame_offsets"][-1]) * FRAME_BYTES
            if image_path.stat().st_size == expected:
                return image_path, index_path, digest
        states, actions, lengths, frame_counts = [], [], [], []
        privileged = {key: [] for key in PRIV_LABELS}
        available = {key: [] for key in PRIV_LABELS}
        with tempfile.NamedTemporaryFile(dir=cache_dir, delete=False) as stream:
            temporary = Path(stream.name)
            try:
                for path in files:
                    with np.load(path, allow_pickle=False) as episode:
                        # Executed teacher actions can contain controller corrections.
                        # Supervision always uses the clean action array.
                        action = np.asarray(episode["action"], dtype=np.float32)
                        state = np.asarray(episode["state"], dtype=np.float32)
                        rgb = episode["rgb"]
                        length = len(action)
                        if int(episode["rgb_stride"]) != 2:
                            raise ValueError(f"{path}: expected rgb_stride=2")
                        if length < 1 or action.shape != (length, 20):
                            raise ValueError(f"{path}: invalid action shape")
                        if state.shape != (length, 50):
                            raise ValueError(f"{path}: state must have exactly T rows")
                        if rgb.dtype != np.uint8 or rgb.shape != ((length + 1) // 2, *FRAME_SHAPE):
                            raise ValueError(f"{path}: invalid RGB dtype/shape")
                        if not np.isfinite(state).all() or not np.isfinite(action).all():
                            raise ValueError(f"{path}: nonfinite state/action")
                        if np.abs(action).max() > 1.00001:
                            raise ValueError(f"{path}: actions must be normalized")
                        labels, presence = read_priv(path, episode, length)
                        for key in PRIV_LABELS:
                            privileged[key].append(labels[key])
                            available[key].append(presence[key])
                        rgb.tofile(stream)
                        states.append(state)
                        actions.append(action)
                        lengths.append(length)
                        frame_counts.append(len(rgb))
                stream.flush()
                os.fsync(stream.fileno())
                os.replace(temporary, image_path)
            finally:
                temporary.unlink(missing_ok=True)
        with tempfile.NamedTemporaryFile(dir=cache_dir, delete=False) as stream:
            temporary = Path(stream.name)
            try:
                np.savez(
                    stream,
                    state=np.concatenate(states),
                    action=np.concatenate(actions),
                    step_offsets=np.r_[0, np.cumsum(lengths)],
                    frame_offsets=np.r_[0, np.cumsum(frame_counts)],
                    files=np.asarray([str(p) for p in files]),
                    **{
                        key: np.stack(values) if PRIV_LABELS[key][1] else np.concatenate(values)
                        for key, values in privileged.items()
                    },
                    **{key + "_available": np.asarray(values) for key, values in available.items()},
                )
                stream.flush()
                os.fsync(stream.fileno())
                os.replace(temporary, index_path)
            finally:
                temporary.unlink(missing_ok=True)
    return image_path, index_path, digest


class EpisodeStore:
    def __init__(self, directories, cache_dir, val_episodes=6, proprio_dims=PROPRIO_DIMS):
        files = episode_files(directories)
        self.proprio_dims = validate_proprio_dims(proprio_dims)
        self.directory_ids = np.asarray(
            [
                next(i for i, d in enumerate(directories) if p.parent == Path(d).resolve())
                for p in files
            ]
        )
        self.val_ids = []
        for directory_id, directory in enumerate(directories):
            ids = np.flatnonzero(self.directory_ids == directory_id)
            if not 1 <= val_episodes < len(ids):
                raise ValueError(
                    f"{directory}: need more than val_episodes={val_episodes} episodes"
                )
            self.val_ids.extend(ids[np.linspace(0, len(ids) - 1, val_episodes, dtype=int)].tolist())
        self.train_ids = [i for i in range(len(files)) if i not in self.val_ids]
        self.image_path, index_path, self.digest = build_cache(files, cache_dir)
        with np.load(index_path, allow_pickle=False) as index:
            self.state = index["state"]
            self.action = index["action"]
            self.steps = index["step_offsets"]
            self.frames = index["frame_offsets"]
            self.priv = {key: index[key] for key in PRIV_LABELS}
            self.priv_available = {key: index[key + "_available"] for key in PRIV_LABELS}
        self.files = [str(p) for p in files]
        row_episodes = np.repeat(np.arange(len(files)), np.diff(self.steps))
        targets, masks = [], []
        for key in AUX_LABELS:
            values = self.priv[key]
            if PRIV_LABELS[key][1]:
                values = values[row_episodes]
            values = values.reshape(len(self.state), -1)
            targets.append(values)
            masks.append(
                np.broadcast_to(self.priv_available[key][row_episodes, None], values.shape)
            )
        self.aux_target = np.concatenate(targets, axis=1)
        self.aux_mask = np.concatenate(masks, axis=1).copy()
        train_rows = np.concatenate(
            [np.arange(self.steps[i], self.steps[i + 1]) for i in self.train_ids]
        )
        proprio = self.state[train_rows][:, self.proprio_dims].astype(np.float64)
        aux_mean, aux_std = np.zeros(9, np.float32), np.ones(9, np.float32)
        for dim in range(8):
            rows = train_rows[self.aux_mask[train_rows, dim]]
            if len(rows):
                values = self.aux_target[rows, dim].astype(np.float64)
                aux_mean[dim], aux_std[dim] = values.mean(), max(values.std(), 1e-3)
        self.stats = {
            "proprio_mean": proprio.mean(0).astype(np.float32),
            "proprio_std": np.maximum(proprio.std(0), 1e-3).astype(np.float32),
            "action_mean": self.action[train_rows].mean(0, dtype=np.float64).astype(np.float32),
            "aux_mean": aux_mean,
            "aux_std": aux_std,
        }
        # Held stays binary; zero masked targets for easier inspection and safe losses.
        self.aux_target = np.where(self.aux_mask, (self.aux_target - aux_mean) / aux_std, 0)

    def dataset(self, split, horizon):
        if split not in ("train", "val"):
            raise ValueError("split must be train or val")
        return ChunkDataset(self, self.train_ids if split == "train" else self.val_ids, horizon)


class ChunkDataset(Dataset):
    def __init__(self, store, episode_ids, horizon):
        self.store = store
        self.horizon = horizon
        self.episode_ids = np.asarray(episode_ids)
        self.ends = np.cumsum([store.frames[i + 1] - store.frames[i] for i in episode_ids])
        self.images = None

    def sample_weights(self, data_weights=()):
        """Each directory gets its requested total probability, uniform within it."""
        counts = np.diff(np.r_[0, self.ends])
        groups = np.repeat(self.store.directory_ids[self.episode_ids], counts)
        sizes = np.bincount(groups, minlength=len(np.unique(self.store.directory_ids)))
        weights = np.asarray(data_weights if len(data_weights) else sizes, dtype=np.float64)
        if (
            weights.shape != sizes.shape
            or not np.isfinite(weights).all()
            or (weights < 0).any()
            or weights.sum() <= 0
        ):
            raise ValueError("data_weights must have one finite nonnegative weight per directory")
        return (weights / weights.sum() / sizes)[groups]

    def __len__(self):
        return int(self.ends[-1])

    def __getstate__(self):
        # Spawned workers reopen this same read-only mapping, never duplicate image arrays.
        return {**self.__dict__, "images": None}

    def __getitem__(self, index):
        if not 0 <= index < len(self):
            raise IndexError(index)
        if self.images is None:
            self.images = np.memmap(
                self.store.image_path,
                mode="r",
                dtype=np.uint8,
                shape=(int(self.store.frames[-1]), *FRAME_SHAPE),
            )
        position = int(np.searchsorted(self.ends, index, side="right"))
        episode = self.episode_ids[position]
        frame = index - (int(self.ends[position - 1]) if position else 0)
        t = 2 * frame
        start, end = self.store.steps[episode : episode + 2]
        steps = t + np.arange(self.horizon)
        pad_mask = steps >= end - start
        target = self.store.action[start + np.minimum(steps, end - start - 1)][:, ACTIVE_DIMS]
        proprio = self.store.state[start + t, list(self.store.proprio_dims)]
        proprio = (proprio - self.store.stats["proprio_mean"]) / self.store.stats["proprio_std"]
        return {
            "rgb": self.images[self.store.frames[episode] + frame].copy(),
            "proprio": proprio.astype(np.float32),
            "target": target.copy(),
            "pad_mask": pad_mask,
            "aux_target": self.store.aux_target[start + t].copy(),
            "aux_mask": self.store.aux_mask[start + t].copy(),
        }
"""Train BC in the model environment; run from the repo root with python -m."""

import argparse
import ast
import copy
import csv
import json
import math
import os
import random
import tempfile
import time
from dataclasses import asdict, dataclass, fields
from pathlib import Path

import numpy as np
import torch
from torch.utils.data import DataLoader, Sampler, WeightedRandomSampler

from .dataset import EpisodeStore
from .model import (
    PROPRIO_DIMS,
    BCModel,
    auxiliary_loss,
    load_bc_weights,
    masked_l1,
    validate_proprio_dims,
)


@dataclass
class Config:
    data_dirs: tuple = ("/home/keyu/advaitic/data/human60",)
    data_weights: tuple = ()
    cache_dir: str = "/home/keyu/advaitic/data/cache"
    run_dir: str = "method/bc/checkpoints/human60"
    horizon: int = 20
    exec_steps: int = 10
    steps: int = 20_000
    batch_size: int = 64
    microbatch_size: int = 8
    val_episodes: int = 6
    val_every: int = 1000
    save_every: int = 1000
    log_every: int = 100
    lr: float = 3e-4
    backbone_lr: float = 1e-4
    weight_decay: float = 1e-4
    warmup_steps: int = 500
    ema_decay: float = 0.999
    num_workers: int = 2
    seed: int = 42
    device: str = "cuda"
    pretrained: bool = True
    temporal_ensemble: bool = False
    ensemble_decay: float = 0.01
    aux_weight: float = 0.1
    proprio_dims: tuple = PROPRIO_DIMS


def validate_config(config):
    validate_proprio_dims(config.proprio_dims)
    if not math.isfinite(config.aux_weight) or config.aux_weight < 0:
        raise ValueError("aux_weight must be finite and nonnegative")
    if not 1 <= config.exec_steps <= config.horizon <= 50:
        raise ValueError("Require 1 <= exec_steps <= horizon <= 50")
    if not 0 <= config.num_workers <= 2:
        raise ValueError("num_workers must be in [0, 2]")
    for key in (
        "steps",
        "batch_size",
        "microbatch_size",
        "val_episodes",
        "val_every",
        "save_every",
        "log_every",
    ):
        if getattr(config, key) < 1:
            raise ValueError(f"{key} must be positive")
    if config.warmup_steps < 0 or not 0 <= config.ema_decay < 1:
        raise ValueError("Invalid warmup_steps or ema_decay")
    if config.lr <= 0 or config.backbone_lr <= 0 or config.weight_decay < 0:
        raise ValueError("Invalid optimizer settings")
    if config.ensemble_decay < 0:
        raise ValueError("ensemble_decay must be nonnegative")


class StepBatches(Sampler):
    """Reproducible random batches independent of worker prefetch and restarts."""

    def __init__(self, weights, batch_size, start, stop, seed):
        self.weights, self.batch_size = torch.as_tensor(weights, dtype=torch.double), batch_size
        self.start, self.stop, self.seed = start, stop, seed

    def __iter__(self):
        for step in range(self.start, self.stop):
            generator = torch.Generator().manual_seed(self.seed + step)
            yield list(
                WeightedRandomSampler(
                    self.weights, self.batch_size, replacement=True, generator=generator
                )
            )

    def __len__(self):
        return self.stop - self.start


def atomic_save(value, path):
    path = Path(path)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as stream:
        temporary = Path(stream.name)
        try:
            torch.save(value, stream)
            stream.flush()
            os.fsync(stream.fileno())
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)


def rng_state(cuda):
    return {
        "python": random.getstate(),
        "numpy": np.random.get_state(),
        "torch": torch.get_rng_state(),
        "cuda": torch.cuda.get_rng_state_all() if cuda else None,
    }


def restore_rng(state, cuda):
    random.setstate(state["python"])
    np.random.set_state(state["numpy"])
    torch.set_rng_state(state["torch"])
    if cuda and state["cuda"] is not None:
        torch.cuda.set_rng_state_all(state["cuda"])


def lr_factor(step, config):
    if step < config.warmup_steps:
        return (step + 1) / config.warmup_steps
    progress = (step - config.warmup_steps) / max(1, config.steps - config.warmup_steps)
    return 0.5 * (1 + math.cos(math.pi * min(progress, 1)))


@torch.no_grad()
def update_ema(ema, model, decay):
    for average, current in zip(ema.parameters(), model.parameters(), strict=True):
        average.lerp_(current.detach(), 1 - decay)
    for average, current in zip(ema.buffers(), model.buffers(), strict=True):
        average.copy_(current)


def to_device(batch, device):
    return {key: value.to(device, non_blocking=True) for key, value in batch.items()}


@torch.inference_mode()
def validate(model, loader, device, cuda):
    model.eval()
    total, count, aux_total, aux_count = 0.0, 0, 0.0, 0
    for batch in loader:
        batch = to_device(batch, device)
        with torch.autocast(device_type=device.type, dtype=torch.float16, enabled=cuda):
            prediction, aux = model(batch["rgb"], batch["proprio"], return_aux=True)
            loss = masked_l1(prediction.float(), batch["target"], batch["pad_mask"])
            if aux is not None:
                labeled = int(batch["aux_mask"].sum())
                aux_total += (
                    float(auxiliary_loss(aux.float(), batch["aux_target"], batch["aux_mask"]))
                    * labeled
                )
                aux_count += labeled
        valid = int((~batch["pad_mask"]).sum()) * prediction.shape[-1]
        total += float(loss) * valid
        count += valid
    return total / count, aux_total / aux_count if aux_count else 0.0


@torch.no_grad()
def initialize_from(model, path, stats):
    """Start from EMA weights, preserving their meaning under new normalization."""
    checkpoint = torch.load(path, map_location="cpu", weights_only=False)
    source = checkpoint["config"]
    if (
        source["horizon"] != model.horizon
        or tuple(source.get("proprio_dims", PROPRIO_DIMS)) != model.proprio_dims
    ):
        raise ValueError("--init-from requires matching horizon and proprio_dims")
    load_bc_weights(model, checkpoint["ema"])
    old = checkpoint["stats"]
    layer = model.proprio[0]
    mean_shift = torch.as_tensor(
        (stats["proprio_mean"] - old["proprio_mean"]) / old["proprio_std"],
        device=layer.weight.device,
    )
    scale = torch.as_tensor(stats["proprio_std"] / old["proprio_std"], device=layer.weight.device)
    layer.bias.add_(layer.weight @ mean_shift)
    layer.weight.mul_(scale)
    if model.aux_head is not None and "aux_head.weight" in checkpoint["ema"]:
        # New normalized predictions correspond to the same physical labels.
        layer = model.aux_head
        scale = torch.as_tensor(old["aux_std"] / stats["aux_std"], device=layer.weight.device)
        shift = torch.as_tensor(
            (old["aux_mean"] - stats["aux_mean"]) / stats["aux_std"], device=layer.weight.device
        )
        layer.weight.mul_(scale[:, None])
        layer.bias.mul_(scale).add_(shift)


def train(config, *, stop_after=None, init_from=None):
    """stop_after tests interruption without changing the total LR schedule."""
    validate_config(config)
    torch.backends.cudnn.benchmark = True
    device = torch.device(config.device)
    cuda = device.type == "cuda"
    if cuda and not torch.cuda.is_available():
        raise RuntimeError("CUDA is unavailable; pass --device cpu for a CPU run")
    random.seed(config.seed)
    np.random.seed(config.seed)
    torch.manual_seed(config.seed)
    if cuda:
        torch.cuda.reset_peak_memory_stats(device)
    run_dir = Path(config.run_dir)
    run_dir.mkdir(parents=True, exist_ok=True)
    checkpoint_path = run_dir / "last.pt"
    previous = (
        torch.load(checkpoint_path, map_location="cpu", weights_only=False)
        if checkpoint_path.exists()
        else None
    )
    if previous is not None and init_from is not None:
        raise ValueError("--init-from requires a new run directory; omit it to resume")
    init_source = str(init_from) if init_from is not None else None
    if previous is not None:
        init_source = previous.get("init_from")
    store = EpisodeStore(
        config.data_dirs, config.cache_dir, config.val_episodes, config.proprio_dims
    )
    train_data, val_data = (
        store.dataset("train", config.horizon),
        store.dataset("val", config.horizon),
    )
    sample_weights = train_data.sample_weights(config.data_weights)
    if previous is not None:
        if previous.get("version") != 2:
            raise ValueError("Legacy training checkpoint: use --init-from in a new run directory")
        allowed_changes = {"run_dir", "cache_dir", "num_workers", "device"}
        for key, value in asdict(config).items():
            if key not in allowed_changes and value != previous["config"][key]:
                raise ValueError(f"Resume config changed: {key}; use a new run directory")
        if previous["data_digest"] != store.digest:
            raise ValueError("Resume data changed; use a new run directory")
    (run_dir / "config.json").write_text(json.dumps(asdict(config), indent=2) + "\n")
    model = BCModel(
        config.horizon,
        pretrained=config.pretrained and previous is None and init_from is None,
        proprio_dims=config.proprio_dims,
        aux_head=config.aux_weight > 0,
    ).to(device)
    if init_from is not None:
        initialize_from(model, init_from, store.stats)
        print(f"Initialized EMA weights from {init_from}; fresh optimizer/step", flush=True)
    backbone_ids = {id(p) for p in model.backbone.parameters()}
    optimizer = torch.optim.AdamW(
        [
            {"params": model.backbone.parameters(), "lr": config.backbone_lr},
            {
                "params": [p for p in model.parameters() if id(p) not in backbone_ids],
                "lr": config.lr,
            },
        ],
        weight_decay=config.weight_decay,
    )
    scaler = torch.amp.GradScaler("cuda", enabled=cuda)
    ema = copy.deepcopy(model).eval().requires_grad_(False)
    step = 0
    last_val = float("nan")
    last_val_aux = float("nan")
    if previous is not None:
        model.load_state_dict(previous["model"])
        ema.load_state_dict(previous["ema"])
        optimizer.load_state_dict(previous["optimizer"])
        scaler.load_state_dict(previous["scaler"])
        step = previous["step"]
        last_val = previous["val_loss"]
        last_val_aux = previous["val_aux_loss"]
        restore_rng(previous["rng"], cuda)
        print(f"Resumed {checkpoint_path} at step {step}", flush=True)
    del previous
    stop = config.steps if stop_after is None else min(config.steps, stop_after)
    if stop <= step:
        print("Training already complete.", flush=True)
        return checkpoint_path
    # Dedicated loader generators preserve dropout/augmentation RNG on resume.
    loader_options = {"num_workers": config.num_workers, "pin_memory": cuda}
    train_loader = DataLoader(
        train_data,
        batch_sampler=StepBatches(sample_weights, config.batch_size, step, stop, config.seed),
        generator=torch.Generator().manual_seed(config.seed),
        **loader_options,
    )
    val_loader = DataLoader(
        val_data,
        batch_size=config.microbatch_size,
        generator=torch.Generator().manual_seed(config.seed),
        **loader_options,
    )
    log_path = run_dir / "log.csv"
    print(
        f"{len(store.train_ids)} train / {len(store.val_ids)} val episodes; "
        f"{len(train_data)} train frames; cache={store.image_path}",
        flush=True,
    )
    started, logged_step = time.monotonic(), step
    train_total, train_count, aux_total, aux_count = 0.0, 0, 0.0, 0
    with log_path.open("a", newline="") as log:
        writer = csv.writer(log)
        if log.tell() == 0:
            writer.writerow(
                ["step", "train_loss", "val_loss", "train_aux_loss", "val_aux_loss", "lr", "it/s"]
            )
            log.flush()
        model.train()
        for batch in train_loader:
            factor = lr_factor(step, config)
            for group, base_lr in zip(
                optimizer.param_groups, (config.backbone_lr, config.lr), strict=True
            ):
                group["lr"] = base_lr * factor
            optimizer.zero_grad(set_to_none=True)
            valid_count = (~batch["pad_mask"]).sum().item() * 10
            labeled_count = batch["aux_mask"].sum().item() if config.aux_weight > 0 else 0
            batch_loss = 0.0
            batch_aux = 0.0
            # Only microbatch_size * 3 images occupy backbone activation RAM.
            # Weight by valid elements to preserve the logical batch-64 mean.
            for start in range(0, len(batch["rgb"]), config.microbatch_size):
                micro = to_device(
                    {k: v[start : start + config.microbatch_size] for k, v in batch.items()}, device
                )
                with torch.autocast(device_type=device.type, dtype=torch.float16, enabled=cuda):
                    prediction, aux = model(micro["rgb"], micro["proprio"], return_aux=True)
                    action_loss = masked_l1(prediction.float(), micro["target"], micro["pad_mask"])
                    fraction = (~micro["pad_mask"]).sum().item() * 10 / valid_count
                    action_loss = action_loss * fraction
                    aux_loss = action_loss.new_zeros(())
                    if aux is not None and labeled_count:
                        aux_loss = auxiliary_loss(
                            aux.float(), micro["aux_target"], micro["aux_mask"]
                        )
                        aux_loss = aux_loss * micro["aux_mask"].sum() / labeled_count
                    loss = action_loss + config.aux_weight * aux_loss
                scaler.scale(loss).backward()
                batch_loss += float(action_loss.detach())
                batch_aux += float(aux_loss.detach())
            scaler.unscale_(optimizer)
            norm = torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            if not cuda and not torch.isfinite(norm):
                raise FloatingPointError("Nonfinite CPU gradient")
            old_scale = scaler.get_scale()
            scaler.step(optimizer)
            scaler.update()
            if scaler.get_scale() >= old_scale:
                update_ema(ema, model, config.ema_decay)
            step += 1
            train_total += batch_loss
            train_count += 1
            aux_total += batch_aux * labeled_count
            aux_count += labeled_count
            check = step % config.save_every == 0 or step == stop
            evaluate = step % config.val_every == 0 or check
            if evaluate:
                last_val, last_val_aux = validate(ema, val_loader, device, cuda)
            if step % config.log_every == 0 or evaluate:
                if cuda:
                    torch.cuda.synchronize(device)
                elapsed = time.monotonic() - started
                throughput = (step - logged_step) / max(elapsed, 1e-9)
                train_loss = train_total / train_count
                train_aux = aux_total / aux_count if aux_count else 0.0
                writer.writerow(
                    [
                        step,
                        train_loss,
                        last_val,
                        train_aux,
                        last_val_aux,
                        optimizer.param_groups[1]["lr"],
                        throughput,
                    ]
                )
                log.flush()
                print(
                    f"step={step} train={train_loss:.5f} val={last_val:.5f} "
                    f"aux={train_aux:.5f} val_aux={last_val_aux:.5f} "
                    f"lr={optimizer.param_groups[1]['lr']:.3g} it/s={throughput:.2f}",
                    flush=True,
                )
                train_total, train_count, aux_total, aux_count = 0.0, 0, 0.0, 0
                started, logged_step = time.monotonic(), step
            if check:
                atomic_save(
                    {
                        "version": 2,
                        "config": asdict(config),
                        "model": model.state_dict(),
                        "ema": ema.state_dict(),
                        "optimizer": optimizer.state_dict(),
                        "scaler": scaler.state_dict(),
                        "step": step,
                        "rng": rng_state(cuda),
                        "stats": store.stats,
                        "data_digest": store.digest,
                        "train_episodes": [store.files[i] for i in store.train_ids],
                        "val_episodes": [store.files[i] for i in store.val_ids],
                        "val_loss": last_val,
                        "val_aux_loss": last_val_aux,
                        "init_from": init_source,
                    },
                    checkpoint_path,
                )
    peak = torch.cuda.max_memory_allocated(device) / 1e9 if cuda else 0.0
    reserved = torch.cuda.max_memory_reserved(device) / 1e9 if cuda else 0.0
    print(f"Peak CUDA memory: allocated={peak:.3f} GB, reserved={reserved:.3f} GB", flush=True)
    if cuda and reserved >= 3.0:
        raise RuntimeError("Memory budget exceeded; lower --microbatch-size in a new run")
    return checkpoint_path


def read_config(path):
    """Flat YAML (scalars/inline lists) or JSON; no PyYAML dependency."""
    text = Path(path).read_text()
    if text.lstrip().startswith("{"):
        return json.loads(text)
    result = {}
    for number, line in enumerate(text.splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition(":")
        if not separator or not value.strip():
            raise ValueError(f"Config line {number}: expected key: scalar or inline list")
        value = value.strip()
        try:
            parsed = json.loads(value)
        except json.JSONDecodeError:
            try:
                parsed = ast.literal_eval(value)
            except (ValueError, SyntaxError):
                parsed = value
        result[key.strip().replace("-", "_")] = parsed
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=Path)
    parser.add_argument(
        "--init-from", type=Path, help="EMA weights only; requires a fresh run directory"
    )
    for field in fields(Config):
        name = "--" + field.name.replace("_", "-")
        options = {"default": argparse.SUPPRESS}
        if field.name in ("data_dirs", "data_weights", "proprio_dims"):
            options["nargs"] = "+"
            if field.name != "data_dirs":
                options["type"] = int if field.name == "proprio_dims" else float
        elif field.type is bool:
            options["action"] = argparse.BooleanOptionalAction
        else:
            options["type"] = field.type
        parser.add_argument(name, **options)
    args = vars(parser.parse_args())
    config_path = args.pop("config")
    init_from = args.pop("init_from")
    values = read_config(config_path) if config_path else {}
    values.update(args)
    for key in ("data_dirs", "data_weights", "proprio_dims"):
        if key in values:
            if not isinstance(values[key], (list, tuple)):
                parser.error(f"{key} must be an inline list or CLI list")
            values[key] = tuple(values[key])
    train(Config(**values), init_from=init_from)


if __name__ == "__main__":
    main()

