new file mode 100644
index 0000000000000000000000000000000000000000..08b478c0f0907d43d63a79e792a310e4ae7a3127
--- /dev/null
+++ b/method/dagger/diagnostics.py
@@ -0,0 +1,85 @@
+"""Training-only, read-only subset of the teacher's privileged sensors.
+
+Copied from method/teacher/diagnostics.py in the teacher worktree. No cross-worktree
+imports or simulator writes. Tilt follows the fixed task's plate convention.
+"""
+
+import numpy as np
+
+OPEN_DISTANCE_M = 0.05
+OPEN_TILT_DEG = 20.0
+CLOSED_LIFT_M = 0.03
+GRIPPER_DIM = 18
+
+
+def plate_up(quaternion):
+    q = np.asarray(quaternion, dtype=float)
+    w, x, y, z = q / np.linalg.norm(q)
+    return np.array([2 * (x * z + w * y), 2 * (y * z - w * x), 1 - 2 * (x * x + y * y)])
+
+
+class PrivilegedSensors:
+    def __init__(self, inner):
+        self.inner = inner
+        self.plate = inner.plates[0]
+
+    def snapshot(self, step):
+        inner, plate = self.inner, self.plate
+        pose = np.asarray(plate.get_pose(), dtype=float)
+        sites = np.array([inner.data.bind(s).xpos.copy() for s in inner.rack_target.sites])
+        if pose.shape != (7,) or sites.shape != (6, 3):
+            raise ValueError("Expected one xyz/wxyz plate pose and six xyz destination sites")
+        if not np.isfinite(pose).all() or not np.isfinite(sites).all():
+            raise ValueError("Nonfinite privileged pose/sites")
+        nearest = int(np.argmin(np.linalg.norm(sites - pose[:3], axis=1)))
+        up = plate_up(pose[3:])
+        return {
+            "step": step,
+            "pose": pose.tolist(),
+            "nearest_site": nearest,
+            "site_xyz": sites[nearest].tolist(),
+            "site_distance": float(np.linalg.norm(sites[nearest] - pose[:3])),
+            "site_xy_distance": float(np.linalg.norm(sites[nearest, :2] - pose[:2])),
+            "tilt_deg": float(np.degrees(np.arccos(np.clip(-up[1], -1, 1)))),
+            "held": any(
+                inner.robot.is_gripper_holding_object(plate, side) for side in inner.robot.grippers
+            ),
+            "contacts": {
+                "target_rack": bool(plate.is_colliding(inner.rack_target)),
+                "table": bool(plate.is_colliding(inner.table)),
+                "floor": bool(plate.is_colliding(inner.floor)),
+            },
+        }
+
+
+def gripper_label(snapshot, start_z):
+    """Return -1/open, +1/closed, or None/undefined at this pre-action state."""
+    touching = snapshot["contacts"]["target_rack"]
+    if (
+        touching
+        and snapshot["site_distance"] <= OPEN_DISTANCE_M
+        and snapshot["tilt_deg"] <= OPEN_TILT_DEG
+    ):
+        return -1.0
+    if (
+        snapshot["held"]
+        and snapshot["pose"][2] - start_z >= CLOSED_LIFT_M
+        and not touching
+    ):
+        return 1.0
+    return None
+
+
+def outcome_category(success, fell, max_lift, first_placed, end, start_z):
+    """Replay-style categories; raw geometry remains in the episode summary."""
+    if success:
+        return "success"
+    if fell or end["contacts"]["floor"]:
+        return "fell"
+    if max_lift < CLOSED_LIFT_M:
+        return "no_grasp"
+    if gripper_label(end, start_z) == -1 and end["held"]:
+        return "placed_not_released"
+    if first_placed is not None:
+        return "reached_target_then_failed"
+    return "other"
diff --git a/method/dagger/smoke_test.py b/method/dagger/smoke_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..e24a0b2c4f9aa7d5612185e9ecbffed2bd95055c
--- /dev/null
+++ b/method/dagger/smoke_test.py
@@ -0,0 +1,149 @@
+"""CPU synthetic collector checks. Fake sensors are not policy rollout evidence."""
+
+import copy
+import json
+import tempfile
+from pathlib import Path
+from unittest.mock import patch
+
+import numpy as np
+
+from .collect import append_summary, collect_episode, parse_seeds, save_npz_atomic
+from .diagnostics import gripper_label, outcome_category
+
+
+def snapshot(step):
+    return {
+        "step": step,
+        "pose": [0, 0, 0 if step == 0 else 0.04, 1, 0, 0, 0],
+        "site_distance": 0.05 if step >= 2 else 0.2,
+        "site_xy_distance": 0.02,
+        "tilt_deg": 20,
+        "held": step in (1, 2),
+        "contacts": {"target_rack": step >= 2, "floor": False, "table": False},
+    }
+
+
+class FakeSensors:
+    def __init__(self, inner):
+        pass
+
+    def snapshot(self, step):
+        return snapshot(step)
+
+
+class FakeTimestep:
+    def __init__(self, step):
+        self.low_dim_obs = np.full(50, step, np.float32)
+        self.rgb_obs = np.full((3, 3, 84, 84), step, np.uint8)
+
+    def last(self):
+        return False
+
+
+class FakeEnvironment:
+    def __init__(self):
+        self.inner_env = self
+        self._advaitic_initial_slot = 3
+        self.actions = []
+
+    def reset(self, seed):
+        self.actions = []
+        return FakeTimestep(0)
+
+    def step(self, action):
+        self.actions.append(action.copy())
+        return FakeTimestep(len(self.actions))
+
+    def episode_fell(self):
+        return False
+
+    def episode_succeeded(self):
+        return False
+
+    def episode_termination(self):
+        return "fake_timeout"
+
+
+class FakeProcess:
+    def reset(self):
+        self.calls = []
+
+    def act(self, obs):
+        self.calls.append(int(obs["state"][0]))
+        return np.full((3, 20), 0.2, np.float32)
+
+
+def main():
+    assert list(parse_seeds("2400000:2400002")) == [2400000, 2400001]
+    for spec in ("1999999:2000001", "7310000:7310030", "3000000:3000001", "2400001:2400000"):
+        try:
+            parse_seeds(spec)
+        except ValueError:
+            pass
+        else:
+            raise AssertionError(f"Accepted non-training seeds: {spec}")
+    s = snapshot(1)
+    s["pose"][2] = 0.03
+    assert gripper_label(s, 0) == 1
+    s["pose"][2] = 0.029
+    assert gripper_label(s, 0) is None
+    s["pose"][2] = 0.04
+    s["held"] = False
+    assert gripper_label(s, 0) is None
+    s = snapshot(2)
+    assert gripper_label(s, 0) == -1  # Equality on both open thresholds.
+    for key, value in (("site_distance", 0.05001), ("tilt_deg", 20.001)):
+        bad = copy.deepcopy(s)
+        bad[key] = value
+        assert gripper_label(bad, 0) is None  # Rack contact excludes the closed label.
+    s["contacts"]["target_rack"] = False
+    assert gripper_label(s, 0) == 1
+    assert outcome_category(False, False, 0, None, snapshot(0), 0) == "no_grasp"
+    assert outcome_category(False, False, 0.04, 2, snapshot(2), 0) == "placed_not_released"
+    assert outcome_category(False, False, 0.04, 2, snapshot(3), 0) == "reached_target_then_failed"
+
+    with patch("method.dagger.collect.PrivilegedSensors", FakeSensors):
+        for mode in (False, True):
+            env, process = FakeEnvironment(), FakeProcess()
+            record, arrays = collect_episode(
+                env, process, 2400000, max_steps=10, stop_after_placed=2, relabel_execute=mode
+            )
+            assert process.calls == [0, 3]  # Full chunks; stop in the second chunk.
+            assert record["steps"] == 4 and record["termination"] == "stop_after_placed"
+            assert record["label_counts"] == {"open": 2, "closed": 1, "undefined": 1}
+            assert record["label_fractions"] == {"open": 0.5, "closed": 0.25, "undefined": 0.25}
+            assert arrays["state"][:, 0].tolist() == [0, 1, 2, 3]
+            assert arrays["rgb"][:, 0, 0, 0, 0].tolist() == [0, 2]
+            assert arrays["action"][:, 18].tolist()[1:] == [1, -1, -1]
+            assert arrays["label_mask"][:, 18].tolist() == [False, True, True, True]
+            assert arrays["label_mask"].sum() == 3
+            np.testing.assert_array_equal(arrays["action_executed"], env.actions)
+            if mode:
+                np.testing.assert_array_equal(arrays["action_executed"], arrays["action"])
+            else:
+                assert (arrays["action_executed"] == np.float32(0.2)).all()
+            assert bool(arrays["relabel_execute"]) == mode
+        record, _ = collect_episode(
+            FakeEnvironment(), FakeProcess(), 2400001,
+            max_steps=1, stop_after_placed=150, relabel_execute=False,
+        )
+        assert record["steps"] == 1 and record["termination"] == "max_steps"
+    with tempfile.TemporaryDirectory(prefix="dagger-smoke-") as temporary:
+        root = Path(temporary)
+        path = root / "ep_2400001.npz"
+        save_npz_atomic(path, **arrays, summary_json=np.asarray(json.dumps(record)))
+        with np.load(path, allow_pickle=False) as episode:
+            assert episode["label_mask"].dtype == np.bool_
+            recovered = json.loads(episode["summary_json"].item())
+        summary = root / "summary.jsonl"
+        summary.write_text('{"interrupted":')
+        append_summary(summary, recovered)
+        append_summary(summary, recovered)
+        assert len(summary.read_text().splitlines()) == 2
+        assert json.loads(summary.read_text().splitlines()[-1]) == recovered
+    print("DAgger synthetic smoke passed: oracle, chunks, pre-action alignment, execution modes, cutoffs, atomic save/log recovery. No task-success evidence.")
+
+
+if __name__ == "__main__":
+    main()
