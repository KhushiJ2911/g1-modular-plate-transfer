"""Keep candidate imports out of the process owning the trusted simulator."""

from __future__ import annotations

import json
import os
import selectors
import subprocess
import sys
import time
from pathlib import Path

from .wire import pack_array


class PolicyProcess:
    def __init__(
        self,
        spec: str,
        root: Path,
        log: Path,
        *,
        timeout: float = 120.0,
        python: str = sys.executable,
    ):
        self.timeout = timeout
        self.log = log.open("ab")
        env = os.environ.copy()
        # Worker package comes from this evaluator; only candidate imports use root.
        package_root = str(Path(__file__).resolve().parents[1])
        env["PYTHONPATH"] = os.pathsep.join([package_root, str(root.resolve())])
        try:
            self.process = subprocess.Popen(
                [python, "-m", "advaitic_eval.worker", spec],
                cwd=root,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=self.log,
                bufsize=0,
                env=env,
            )
        except Exception:
            self.log.close()
            raise
        os.set_blocking(self.process.stdin.fileno(), False)
        os.set_blocking(self.process.stdout.fileno(), False)
        self.failed = False

    def _exchange(self, request):
        if self.failed or self.process.poll() is not None:
            raise RuntimeError("Policy process is unavailable")
        payload = memoryview((json.dumps(request, allow_nan=False) + "\n").encode())
        response = bytearray()
        deadline = time.monotonic() + self.timeout
        try:
            with selectors.DefaultSelector() as selector:
                selector.register(self.process.stdin, selectors.EVENT_WRITE)
                selector.register(self.process.stdout, selectors.EVENT_READ)
                while True:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        raise TimeoutError("Policy did not respond before the per-call timeout")
                    events = selector.select(remaining)
                    for key, _ in events:
                        if key.fileobj is self.process.stdin:
                            try:
                                written = os.write(key.fd, payload[:65536])
                            except BlockingIOError:
                                continue
                            payload = payload[written:]
                            if not payload:
                                selector.unregister(self.process.stdin)
                        else:
                            try:
                                chunk = os.read(key.fd, 65536)
                            except BlockingIOError:
                                continue
                            if not chunk:
                                raise RuntimeError("Policy exited before responding")
                            response.extend(chunk)
                            if len(response) > 1_000_000:
                                raise RuntimeError("Policy returned an oversized response")
                            if b"\n" in response:
                                if (
                                    payload
                                    or response.count(b"\n") != 1
                                    or not response.endswith(b"\n")
                                ):
                                    raise RuntimeError("Unexpected policy protocol response")
                                result = json.loads(response)
                                if not isinstance(result, dict):
                                    raise RuntimeError("Policy response must be an object")
                                return result
        except Exception:
            # A late response must never be mistaken for the next episode's reset.
            self.failed = True
            if self.process.poll() is None:
                self.process.kill()
            raise

    def request(self, request):
        result = self._exchange(request)
        if "error" in result:
            raise RuntimeError("Policy raised an error; inspect policy.stderr.log")
        return result

    def reset(self):
        self.request({"op": "reset"})

    def act(self, obs):
        return self.request({"op": "act", "obs": {k: pack_array(v) for k, v in obs.items()}})[
            "actions"
        ]

    def close(self):
        if self.process.poll() is None:
            self.process.terminate()
            try:
                self.process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.process.kill()
                self.process.wait()
        self.process.stdin.close()
        self.process.stdout.close()
        self.log.close()
"""Unmodified BiGym2 task; observations only cross the policy boundary."""

from __future__ import annotations

import numpy as np

from .protocol import SLOT_COUNT


def make_environment():
    import onnxruntime

    # The assignment runs locally; no optional runtime telemetry is needed.
    onnxruntime.disable_telemetry_events()
    from bigym.loco import make

    env = make("move_plate")
    inner = env.inner_env
    original_reset = inner._on_reset

    def record_reset_slot():
        original_reset()
        # Metadata only, before the unchanged 200-step settling warmup.
        # Contact settling can move the plate centre toward an adjacent
        # divider; nearest slot AFTER settling is not the sampled slot.
        sites = inner.rack_start.sites
        if len(sites) != SLOT_COUNT:
            raise RuntimeError(f"Expected {SLOT_COUNT} source slots, got {len(sites)}")
        distances = [
            np.linalg.norm(inner.plates[0].get_position() - inner.data.bind(s).xpos) for s in sites
        ]
        if min(distances) > 0.05:
            raise RuntimeError("Plate was not initialized in a source slot")
        inner._advaitic_initial_slot = int(np.argmin(distances))

    inner._on_reset = record_reset_slot
    return env


def observed_source_slot(env) -> int:
    return env.inner_env._advaitic_initial_slot


def observation(timestep) -> dict:
    # No task pose, rack slot, seed, reward, success flag, env or mjData.
    return {
        "rgb": np.asarray(timestep.rgb_obs, dtype=np.uint8),
        "state": np.asarray(timestep.low_dim_obs, dtype=np.float32),
    }


def validate_actions(value, action_dim: int = 20) -> np.ndarray:
    try:
        actions = np.asarray(value, dtype=np.float32)
    except (TypeError, ValueError, OverflowError) as exc:
        raise ValueError("Actions must be a numeric array") from exc
    if actions.shape == (action_dim,):
        actions = actions[None, :]
    if actions.ndim != 2 or actions.shape[1] != action_dim or not 1 <= len(actions) <= 50:
        raise ValueError(f"Expected (20,) or (H,20), 1<=H<=50; got {actions.shape}")
    if not np.isfinite(actions).all() or np.any(np.abs(actions) > 1.0):
        raise ValueError("Actions must be finite, normalized to [-1, 1]")
    return actions

