diff --git a/method/dagger/collect.py b/method/dagger/collect.py
new file mode 100644
index 0000000000000000000000000000000000000000..daf0099f9e3cd1e23e787ba1586ed1796321a982
--- /dev/null
+++ b/method/dagger/collect.py
@@ -0,0 +1,323 @@
+"""Collect student-visited observations with privileged gripper-only labels."""
+
+from __future__ import annotations
+
+import argparse
+import fcntl
+import hashlib
+import json
+import os
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+# Before simulator, controller or model imports; workers inherit these settings.
+os.environ["ORT_DISABLE_TELEMETRY"] = "1"
+os.environ["CUDA_VISIBLE_DEVICES"] = ""
+os.environ.setdefault("MUJOCO_GL", "egl")
+os.environ.setdefault("OMP_NUM_THREADS", "1")
+os.environ.setdefault("MKL_NUM_THREADS", "1")
+
+import numpy as np
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(REPO_ROOT / "src"))
+if __package__ in (None, ""):
+    sys.path.insert(0, str(REPO_ROOT))
+
+from advaitic_eval.environment import (  # noqa: E402
+    make_environment,
+    observation,
+    observed_source_slot,
+    validate_actions,
+)
+from advaitic_eval.policy_process import PolicyProcess  # noqa: E402
+
+from method.dagger.diagnostics import (  # noqa: E402
+    CLOSED_LIFT_M,
+    GRIPPER_DIM,
+    OPEN_DISTANCE_M,
+    OPEN_TILT_DEG,
+    PrivilegedSensors,
+    gripper_label,
+    outcome_category,
+)
+
+RGB_STRIDE = 2
+# Restrict to the designated training block, also excluding the public/final
+# evaluator block (7,310,000+) and any future reviewer seeds outside this block.
+TRAIN_SEED_START = 2_000_000
+TRAIN_SEED_STOP = 3_000_000
+
+
+def parse_seeds(spec):
+    """Python-style A:B, stop exclusive; refuse anything outside training."""
+    try:
+        start, stop = map(int, spec.split(":"))
+    except ValueError as exc:
+        raise ValueError("--seeds must be A:B (stop exclusive)") from exc
+    if not TRAIN_SEED_START <= start < stop <= TRAIN_SEED_STOP:
+        raise ValueError("Seeds must be in the training block [2000000, 3000000)")
+    return range(start, stop)
+
+
+def save_npz_atomic(path, **arrays):
+    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as stream:
+        temporary = Path(stream.name)
+        try:
+            np.savez_compressed(stream, **arrays)
+            stream.flush()
+            os.fsync(stream.fileno())
+            os.replace(temporary, path)
+        finally:
+            temporary.unlink(missing_ok=True)
+
+
+def read_records(stream):
+    stream.seek(0)
+    records = {}
+    for line in stream:
+        try:
+            row = json.loads(line)
+        except ValueError:
+            continue  # Preserve an interrupted trailing write; next append separates it.
+        if row.get("completed") is not True or type(row.get("seed")) is not int:
+            raise ValueError("Invalid completed episode summary")
+        if row["seed"] in records:
+            raise ValueError(f"Duplicate seed in summary: {row['seed']}")
+        records[row["seed"]] = row
+    return records
+
+
+def append_summary(path, record):
+    """Short shared-log lock: two collectors can share a directory and JSONL."""
+    with path.open("a+", encoding="utf-8") as stream:
+        fcntl.flock(stream, fcntl.LOCK_EX)
+        records = read_records(stream)
+        if record["seed"] in records:
+            if records[record["seed"]] != record:
+                raise ValueError(f"Conflicting summary for seed {record['seed']}")
+            return
+        stream.seek(0, os.SEEK_END)
+        if stream.tell():
+            stream.seek(stream.tell() - 1)
+            if stream.read(1) != "\n":
+                stream.write("\n")
+        stream.write(json.dumps(record, allow_nan=False) + "\n")
+        stream.flush()
+        os.fsync(stream.fileno())
+
+
+def collect_episode(env, process, seed, *, max_steps, stop_after_placed, relabel_execute):
+    started = time.monotonic()
+    ts = env.reset(seed=seed)
+    process.reset()
+    sensors = PrivilegedSensors(env.inner_env)
+    initial = end = sensors.snapshot(0)
+    start_z = initial["pose"][2]
+    rgb, states, actions, executed, masks = [], [], [], [], []
+    steps, max_lift, held_steps = 0, 0.0, 0
+    first_held = first_placed = None
+    counts = {"open": 0, "closed": 0, "undefined": 0}
+    termination = None
+    while not ts.last() and termination is None:
+        # Same call cadence and full returned chunk execution as evaluator.runner.
+        chunk = validate_actions(process.act(observation(ts)))
+        for student_action in chunk:
+            label = gripper_label(end, start_z)
+            if label == -1 and first_placed is None:
+                first_placed = steps
+            action = student_action.copy()
+            label_mask = np.zeros(20, dtype=bool)
+            if label is not None:
+                action[GRIPPER_DIM] = label
+                label_mask[GRIPPER_DIM] = True
+            action_executed = action.copy() if relabel_execute else student_action.copy()
+            states.append(observation(ts)["state"].copy())
+            actions.append(action)
+            executed.append(action_executed)
+            masks.append(label_mask)
+            if steps % RGB_STRIDE == 0:
+                rgb.append(observation(ts)["rgb"].copy())
+            counts["undefined" if label is None else "open" if label == -1 else "closed"] += 1
+            ts = env.step(action_executed)
+            steps += 1
+            end = sensors.snapshot(steps)
+            max_lift = max(max_lift, end["pose"][2] - start_z)
+            if end["held"]:
+                held_steps += 1
+                if first_held is None:
+                    first_held = steps
+            if gripper_label(end, start_z) == -1 and first_placed is None:
+                first_placed = steps
+            if ts.last():
+                break
+            if first_placed is not None and steps >= first_placed + stop_after_placed:
+                termination = "stop_after_placed"
+            elif steps >= max_steps:
+                termination = "max_steps"
+            if termination is not None:
+                break
+    fell = bool(env.episode_fell())
+    success = bool(env.episode_succeeded() and not fell and termination is None)
+    record = {
+        "seed": seed,
+        "slot": int(observed_source_slot(env)),
+        "completed": True,
+        "success": success,
+        "fell": fell,
+        "steps": steps,
+        "termination": termination or env.episode_termination(),
+        "relabel_execute": relabel_execute,
+        "outcome_category": outcome_category(
+            success, fell, max_lift, first_placed, end, start_z
+        ),
+        "max_lift_m": max_lift,
+        "first_held": first_held,
+        "held_steps": held_steps,
+        "first_placed": first_placed,
+        "label_counts": counts,
+        "label_fractions": {key: value / steps for key, value in counts.items()},
+        "initial": initial,
+        "end": end,
+        "wall_time": time.monotonic() - started,
+    }
+    arrays = {
+        "rgb": np.asarray(rgb, dtype=np.uint8),
+        "rgb_stride": np.int64(RGB_STRIDE),
+        "state": np.asarray(states, dtype=np.float32),
+        "action": np.asarray(actions, dtype=np.float32),
+        "action_executed": np.asarray(executed, dtype=np.float32),
+        "label_mask": np.asarray(masks, dtype=bool),
+        "seed": np.int64(seed),
+        "slot": np.int64(record["slot"]),
+        "success": np.bool_(success),
+        "relabel_execute": np.bool_(relabel_execute),
+    }
+    return record, arrays
+
+
+def run_config(args):
+    digest = hashlib.sha256()
+    with args.checkpoint.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    config = {
+        "checkpoint": str(args.checkpoint.resolve()),
+        "checkpoint_sha256": digest.hexdigest(),
+        "max_steps": args.max_steps,
+        "stop_after_placed": args.stop_after_placed,
+        "relabel_execute": args.relabel_execute,
+        "oracle": {"distance_m": OPEN_DISTANCE_M, "tilt_deg": OPEN_TILT_DEG, "lift_m": CLOSED_LIFT_M},
+        "source_sha256": {
+            str(path.relative_to(REPO_ROOT)): hashlib.sha256(path.read_bytes()).hexdigest()
+            for path in (
+                Path(__file__),
+                Path(__file__).with_name("diagnostics.py"),
+                REPO_ROOT / "submission/policy.py",
+                REPO_ROOT / "submission/model.py",
+                REPO_ROOT / "src/advaitic_eval/environment.py",
+                REPO_ROOT / "src/advaitic_eval/policy_process.py",
+                REPO_ROOT / "src/advaitic_eval/worker.py",
+            )
+        },
+    }
+    run_id = hashlib.sha256(json.dumps(config, sort_keys=True).encode()).hexdigest()
+    with (args.out / ".collect.lock").open("a") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        path = args.out / "collector_config.json"
+        if path.exists():
+            if json.loads(path.read_text()) != config:
+                raise ValueError("Collector/checkpoint configuration changed; choose a new --out")
+        else:
+            with tempfile.NamedTemporaryFile(mode="w", dir=args.out, delete=False) as stream:
+                temporary = Path(stream.name)
+                try:
+                    json.dump(config, stream, indent=2)
+                    stream.flush()
+                    os.fsync(stream.fileno())
+                    os.replace(temporary, path)
+                finally:
+                    temporary.unlink(missing_ok=True)
+    return run_id
+
+
+def run(args):
+    seeds = parse_seeds(args.seeds)
+    if args.max_steps < 1 or args.stop_after_placed < 1 or args.policy_timeout <= 0:
+        raise ValueError("max-steps, stop-after-placed and policy-timeout must be positive")
+    args.out.mkdir(parents=True, exist_ok=True)
+    run_id = run_config(args)
+    os.environ["ADV_CKPT"] = str(args.checkpoint.resolve())
+    summary = args.out / "summary.jsonl"
+    env = process = None
+    try:
+        for seed in seeds:
+            # Episode lock prevents duplicate work/publication even on overlapping ranges.
+            with (args.out / f".ep_{seed}.lock").open("a") as lock:
+                fcntl.flock(lock, fcntl.LOCK_EX)
+                path = args.out / f"ep_{seed}.npz"
+                if path.exists():
+                    with np.load(path, allow_pickle=False) as episode:
+                        if str(episode["run_id"].item()) != run_id or int(episode["seed"]) != seed:
+                            raise ValueError(f"Incompatible existing episode: {path}")
+                        record = json.loads(str(episode["summary_json"].item()))
+                    # Recover a crash after npz publication and before JSONL append.
+                    append_summary(summary, record)
+                    print(f"seed={seed} skipped (already saved)", flush=True)
+                    continue
+                if env is None:
+                    env = make_environment()
+                    process = PolicyProcess(
+                        "submission.policy:make_policy",
+                        REPO_ROOT,
+                        args.out / f"policy.{os.getpid()}.stderr.log",
+                        timeout=args.policy_timeout,
+                        python=args.policy_python,
+                    )
+                record, arrays = collect_episode(
+                    env,
+                    process,
+                    seed,
+                    max_steps=args.max_steps,
+                    stop_after_placed=args.stop_after_placed,
+                    relabel_execute=args.relabel_execute,
+                )
+                record["run_id"] = run_id
+                save_npz_atomic(
+                    path,
+                    **arrays,
+                    run_id=np.asarray(run_id),
+                    summary_json=np.asarray(json.dumps(record, allow_nan=False)),
+                )
+                append_summary(summary, record)
+                print(json.dumps(record, allow_nan=False), flush=True)
+    finally:
+        if process is not None:
+            process.close()
+        if env is not None:
+            env.close()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--checkpoint", required=True, type=Path)
+    parser.add_argument("--seeds", required=True, help="A:B; stop exclusive; training block only")
+    parser.add_argument("--out", required=True, type=Path, help="Episode directory and shared JSONL")
+    parser.add_argument("--policy-python", default="/home/keyu/advaitic/mlenv/bin/python")
+    parser.add_argument("--policy-timeout", type=float, default=120.0)
+    parser.add_argument("--relabel-execute", action="store_true")
+    parser.add_argument("--max-steps", type=int, default=1700)
+    parser.add_argument("--stop-after-placed", type=int, default=150)
+    args = parser.parse_args()
+    try:
+        run(args)
+    except KeyboardInterrupt:
+        parser.exit(130, "Interrupted; rerun the same command to resume completed episodes.\n")
+    except (ValueError, RuntimeError, OSError, KeyError) as exc:
+        parser.exit(2, f"{type(exc).__name__}: {exc}\n")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/method/dagger/diagnostics.py b/method/dagger/diagnostics.py
new file mode 100644
index 0000000000000000000000000000000000000000..08b478c0f0907d43d63a79e792a310e4ae7a3127
--- /dev/null
+++ b/method/dagger/diagnostics.py
@@ -0,0 +1,85 @@
+"""Training-only, read-only subset of the teacher's privileged sensors.
+
+Copied from method/teacher/diagnostics.py in the teacher worktree. No cross-worktree
+imports or simulator writes. Tilt follows the fixed task's plate convention.
+"""
+
+import numpy as np
+
+OPEN_DISTANCE_M = 0.05
+OPEN_TILT_DEG = 20.0
+CLOSED_LIFT_M = 0.03
+GRIPPER_DIM = 18
+
+
+def plate_up(quaternion):
+    q = np.asarray(quaternion, dtype=float)
+    w, x, y, z = q / np.linalg.norm(q)
+    return np.array([2 * (x * z + w * y), 2 * (y * z - w * x), 1 - 2 * (x * x + y * y)])
+
+
+class PrivilegedSensors:
+    def __init__(self, inner):
+        self.inner = inner
+        self.plate = inner.plates[0]
+
+    def snapshot(self, step):
+        inner, plate = self.inner, self.plate
+        pose = np.asarray(plate.get_pose(), dtype=float)
+        sites = np.array([inner.data.bind(s).xpos.copy() for s in inner.rack_target.sites])
+        if pose.shape != (7,) or sites.shape != (6, 3):
+            raise ValueError("Expected one xyz/wxyz plate pose and six xyz destination sites")
+        if not np.isfinite(pose).all() or not np.isfinite(sites).all():
+            raise ValueError("Nonfinite privileged pose/sites")
+        nearest = int(np.argmin(np.linalg.norm(sites - pose[:3], axis=1)))
+        up = plate_up(pose[3:])
+        return {
+            "step": step,
+            "pose": pose.tolist(),
+            "nearest_site": nearest,
+            "site_xyz": sites[nearest].tolist(),
+            "site_distance": float(np.linalg.norm(sites[nearest] - pose[:3])),
+            "site_xy_distance": float(np.linalg.norm(sites[nearest, :2] - pose[:2])),
+            "tilt_deg": float(np.degrees(np.arccos(np.clip(-up[1], -1, 1)))),
+            "held": any(
+                inner.robot.is_gripper_holding_object(plate, side) for side in inner.robot.grippers
+            ),
+            "contacts": {
+                "target_rack": bool(plate.is_colliding(inner.rack_target)),
+                "table": bool(plate.is_colliding(inner.table)),
+                "floor": bool(plate.is_colliding(inner.floor)),
+            },
+        }
+
+
+def gripper_label(snapshot, start_z):
+    """Return -1/open, +1/closed, or None/undefined at this pre-action state."""
+    touching = snapshot["contacts"]["target_rack"]
+    if (
+        touching
+        and snapshot["site_distance"] <= OPEN_DISTANCE_M
+        and snapshot["tilt_deg"] <= OPEN_TILT_DEG
+    ):
+        return -1.0
+    if (
+        snapshot["held"]
+        and snapshot["pose"][2] - start_z >= CLOSED_LIFT_M
+        and not touching
+    ):
+        return 1.0
+    return None
+
+
+def outcome_category(success, fell, max_lift, first_placed, end, start_z):
+    """Replay-style categories; raw geometry remains in the episode summary."""
+    if success:
+        return "success"
+    if fell or end["contacts"]["floor"]:
+        return "fell"
+    if max_lift < CLOSED_LIFT_M:
+        return "no_grasp"
+    if gripper_label(end, start_z) == -1 and end["held"]:
+        return "placed_not_released"
+    if first_placed is not None:
+        return "reached_target_then_failed"
+    return "other"
diff --git a/method/dagger/smoke_test.py b/method/dagger/smoke_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..e24a0b2c4f9aa7d5612185e9ecbffed2bd95055c
--- /dev/null
+++ b/method/dagger/smoke_test.py
@@ -0,0 +1,149 @@
+"""CPU synthetic collector checks. Fake sensors are not policy rollout evidence."""
+
+import copy
+import json
+import tempfile
+from pathlib import Path
+from unittest.mock import patch
+
+import numpy as np
+
+from .collect import append_summary, collect_episode, parse_seeds, save_npz_atomic
+from .diagnostics import gripper_label, outcome_category
+
+
+def snapshot(step):
+    return {
+        "step": step,
+        "pose": [0, 0, 0 if step == 0 else 0.04, 1, 0, 0, 0],
+        "site_distance": 0.05 if step >= 2 else 0.2,
+        "site_xy_distance": 0.02,
+        "tilt_deg": 20,
+        "held": step in (1, 2),
+        "contacts": {"target_rack": step >= 2, "floor": False, "table": False},
+    }
+
+
+class FakeSensors:
+    def __init__(self, inner):
+        pass
+
+    def snapshot(self, step):
+        return snapshot(step)
+
+
+class FakeTimestep:
+    def __init__(self, step):
+        self.low_dim_obs = np.full(50, step, np.float32)
+        self.rgb_obs = np.full((3, 3, 84, 84), step, np.uint8)
+
+    def last(self):
+        return False
+
+
+class FakeEnvironment:
+    def __init__(self):
+        self.inner_env = self
+        self._advaitic_initial_slot = 3
+        self.actions = []
+
+    def reset(self, seed):
+        self.actions = []
+        return FakeTimestep(0)
+
+    def step(self, action):
+        self.actions.append(action.copy())
+        return FakeTimestep(len(self.actions))
+
+    def episode_fell(self):
+        return False
+
+    def episode_succeeded(self):
+        return False
+
+    def episode_termination(self):
+        return "fake_timeout"
+
+
+class FakeProcess:
+    def reset(self):
+        self.calls = []
+
+    def act(self, obs):
+        self.calls.append(int(obs["state"][0]))
+        return np.full((3, 20), 0.2, np.float32)
+
+
+def main():
+    assert list(parse_seeds("2400000:2400002")) == [2400000, 2400001]
+    for spec in ("1999999:2000001", "7310000:7310030", "3000000:3000001", "2400001:2400000"):
+        try:
+            parse_seeds(spec)
+        except ValueError:
+            pass
+        else:
+            raise AssertionError(f"Accepted non-training seeds: {spec}")
+    s = snapshot(1)
+    s["pose"][2] = 0.03
+    assert gripper_label(s, 0) == 1
+    s["pose"][2] = 0.029
+    assert gripper_label(s, 0) is None
+    s["pose"][2] = 0.04
+    s["held"] = False
+    assert gripper_label(s, 0) is None
+    s = snapshot(2)
+    assert gripper_label(s, 0) == -1  # Equality on both open thresholds.
+    for key, value in (("site_distance", 0.05001), ("tilt_deg", 20.001)):
+        bad = copy.deepcopy(s)
+        bad[key] = value
+        assert gripper_label(bad, 0) is None  # Rack contact excludes the closed label.
+    s["contacts"]["target_rack"] = False
+    assert gripper_label(s, 0) == 1
+    assert outcome_category(False, False, 0, None, snapshot(0), 0) == "no_grasp"
+    assert outcome_category(False, False, 0.04, 2, snapshot(2), 0) == "placed_not_released"
+    assert outcome_category(False, False, 0.04, 2, snapshot(3), 0) == "reached_target_then_failed"
+
+    with patch("method.dagger.collect.PrivilegedSensors", FakeSensors):
+        for mode in (False, True):
+            env, process = FakeEnvironment(), FakeProcess()
+            record, arrays = collect_episode(
+                env, process, 2400000, max_steps=10, stop_after_placed=2, relabel_execute=mode
+            )
+            assert process.calls == [0, 3]  # Full chunks; stop in the second chunk.
+            assert record["steps"] == 4 and record["termination"] == "stop_after_placed"
+            assert record["label_counts"] == {"open": 2, "closed": 1, "undefined": 1}
+            assert record["label_fractions"] == {"open": 0.5, "closed": 0.25, "undefined": 0.25}
+            assert arrays["state"][:, 0].tolist() == [0, 1, 2, 3]
+            assert arrays["rgb"][:, 0, 0, 0, 0].tolist() == [0, 2]
+            assert arrays["action"][:, 18].tolist()[1:] == [1, -1, -1]
+            assert arrays["label_mask"][:, 18].tolist() == [False, True, True, True]
+            assert arrays["label_mask"].sum() == 3
+            np.testing.assert_array_equal(arrays["action_executed"], env.actions)
+            if mode:
+                np.testing.assert_array_equal(arrays["action_executed"], arrays["action"])
+            else:
+                assert (arrays["action_executed"] == np.float32(0.2)).all()
+            assert bool(arrays["relabel_execute"]) == mode
+        record, _ = collect_episode(
+            FakeEnvironment(), FakeProcess(), 2400001,
+            max_steps=1, stop_after_placed=150, relabel_execute=False,
+        )
+        assert record["steps"] == 1 and record["termination"] == "max_steps"
+    with tempfile.TemporaryDirectory(prefix="dagger-smoke-") as temporary:
+        root = Path(temporary)
+        path = root / "ep_2400001.npz"
+        save_npz_atomic(path, **arrays, summary_json=np.asarray(json.dumps(record)))
+        with np.load(path, allow_pickle=False) as episode:
+            assert episode["label_mask"].dtype == np.bool_
+            recovered = json.loads(episode["summary_json"].item())
+        summary = root / "summary.jsonl"
+        summary.write_text('{"interrupted":')
+        append_summary(summary, recovered)
+        append_summary(summary, recovered)
+        assert len(summary.read_text().splitlines()) == 2
+        assert json.loads(summary.read_text().splitlines()[-1]) == recovered
+    print("DAgger synthetic smoke passed: oracle, chunks, pre-action alignment, execution modes, cutoffs, atomic save/log recovery. No task-success evidence.")
+
+
+if __name__ == "__main__":
+    main()
