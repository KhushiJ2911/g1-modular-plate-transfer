   153	def to_device(batch, device):
   154	    return {key: value.to(device, non_blocking=True) for key, value in batch.items()}
   155	
   156	
   157	@torch.inference_mode()
   158	def validate(model, loader, device, cuda):
   159	    model.eval()
   160	    total, count, aux_total, aux_count = 0.0, 0, 0.0, 0
   161	    for batch in loader:
   162	        batch = to_device(batch, device)
   163	        with torch.autocast(device_type=device.type, dtype=torch.float16, enabled=cuda):
   164	            prediction, aux = model(batch["rgb"], batch["proprio"], return_aux=True)
   165	            loss = masked_l1(
   166	                prediction.float(), batch["target"], batch["pad_mask"], batch["label_mask"]
   167	            )
   168	            if aux is not None:
   169	                labeled = int(batch["aux_mask"].sum())
   170	                aux_total += (
   171	                    float(auxiliary_loss(aux.float(), batch["aux_target"], batch["aux_mask"]))
   172	                    * labeled
   173	                )
   174	                aux_count += labeled
   175	        valid = int((batch["label_mask"] & ~batch["pad_mask"].unsqueeze(-1)).sum())
   176	        total += float(loss) * valid
   177	        count += valid
   178	    return total / max(count, 1), aux_total / aux_count if aux_count else 0.0
