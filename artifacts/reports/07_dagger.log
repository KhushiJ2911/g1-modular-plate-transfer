"""Observation-only BC policy. Set ADV_CKPT to an EMA training checkpoint."""

import os
from pathlib import Path

import numpy as np
import torch

from .model import ACTIVE_DIMS, PROPRIO_DIMS, BCModel, load_bc_weights, validate_proprio_dims


class BCPolicy:
    def __init__(self, checkpoint):
        self.device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        # Our own checkpoints contain optimizer/RNG objects as well as tensors.
        checkpoint = torch.load(checkpoint, map_location="cpu", weights_only=False)
        config = checkpoint["config"]
        self.horizon = config["horizon"]
        self.exec_steps = config["exec_steps"]
        if not 1 <= self.exec_steps <= self.horizon <= 50:
            raise ValueError("Require 1 <= exec_steps <= horizon <= 50")
        self.proprio_dims = validate_proprio_dims(config.get("proprio_dims", PROPRIO_DIMS))
        # The auxiliary head never participates in inference, even when saved.
        self.model = BCModel(self.horizon, pretrained=False, proprio_dims=self.proprio_dims)
        load_bc_weights(self.model, checkpoint["ema"])
        self.model.to(self.device).eval()
        stats = checkpoint["stats"]
        self.mean = np.asarray(stats["proprio_mean"], dtype=np.float32)
        self.std = np.asarray(stats["proprio_std"], dtype=np.float32)
        self.action_mean = np.asarray(stats["action_mean"], dtype=np.float32)
        shape = (len(self.proprio_dims),)
        if self.mean.shape != shape or self.std.shape != shape or self.action_mean.shape != (20,):
            raise ValueError("Checkpoint normalization shapes do not match this policy")
        self.temporal_ensemble = config.get("temporal_ensemble", False)
        self.ensemble_decay = config.get("ensemble_decay", 0.01)
        self.reset()

    def reset(self):
        self.time = 0
        self.predictions = []

    @torch.inference_mode()
    def __call__(self, obs):
        rgb = np.asarray(obs["rgb"], dtype=np.uint8)
        state = np.asarray(obs["state"], dtype=np.float32)
        if rgb.shape != (3, 3, 84, 84) or state.shape != (50,):
            raise ValueError("Expected RGB (3,3,84,84) and state (50,)")
        proprio = (state[list(self.proprio_dims)] - self.mean) / self.std
        chunk = (
            self.model(
                torch.from_numpy(rgb.copy())[None].to(self.device),
                torch.from_numpy(proprio)[None].to(self.device),
            )[0]
            .float()
            .cpu()
            .numpy()
        )
        active = chunk[: self.exec_steps].copy()
        if self.temporal_ensemble:
            # Observations still arrive only every exec_steps control steps.
            self.predictions = [(t, p) for t, p in self.predictions if t + self.horizon > self.time]
            self.predictions.append((self.time, chunk))
            for offset in range(self.exec_steps):
                candidates = [
                    p[self.time + offset - t]
                    for t, p in self.predictions
                    if 0 <= self.time + offset - t < self.horizon
                ]
                # ACT convention: older overlapping predictions get more weight.
                weights = np.exp(-self.ensemble_decay * np.arange(len(candidates)))
                active[offset] = np.average(candidates, axis=0, weights=weights)
        self.time += self.exec_steps
        actions = np.broadcast_to(self.action_mean, (self.exec_steps, 20)).copy()
        actions[:, ACTIVE_DIMS] = active
        actions[:, 18] = np.where(actions[:, 18] >= 0, 1.0, -1.0)
        if not np.isfinite(actions).all():
            raise ValueError("BC prediction contains nonfinite actions")
        return np.clip(actions, -1, 1).astype(np.float32)


def make_policy():
    path = os.environ.get("ADV_CKPT") or Path(__file__).parent / "weights" / "policy.pt"
    return BCPolicy(path)
"""CPU-only synthetic wiring check; no policy/task-success evidence."""

import argparse
import csv
import math
import os
import tempfile
from dataclasses import replace
from pathlib import Path

import numpy as np
import torch

from submission.policy import BCPolicy, make_policy

from .dataset import PRIV_LABELS, EpisodeStore
from .model import ACTIVE_DIMS, PROPRIO_DIMS, BCModel, auxiliary_loss, masked_l1
from .train import Config, StepBatches, atomic_save, initialize_from, train


def fake_data(root):
    rng = np.random.default_rng(7)
    directories, episodes = [], {}
    for group, lengths in enumerate(((7, 9, 5), (3, 5, 7), (5, 7, 9))):
        directory = root / ("human60", "teacher_v1", "teacher_v2")[group]
        directory.mkdir()
        directories.append(str(directory))
        for index, length in enumerate(lengths):
            state = rng.normal(size=(length, 50)).astype(np.float32) + 10 * index
            action = np.broadcast_to(np.linspace(-0.8, 0.8, 20), (length, 20)).copy()
            action[:, ACTIVE_DIMS] = rng.uniform(-1, 1, (length, 10))
            action[:, 18] = np.where(np.arange(length) < 4, -1, 1)
            action = action.astype(np.float32)
            rgb = rng.integers(0, 256, ((length + 1) // 2, 3, 3, 84, 84), dtype=np.uint8)
            labels = {
                "priv_plate_rel": rng.normal(size=(length, 3)).astype(np.float32),
                "priv_target_site_rel": rng.normal(size=(length, 3)).astype(np.float32),
                "priv_plate_tilt_deg": rng.uniform(0, 90, length).astype(np.float32),
                "priv_held": (np.arange(length) >= 4).astype(np.float32),
                "priv_target_rack_offset": np.asarray([index, group], np.float32),
                "priv_start_rack_offset": np.asarray([group, index], np.float32),
            }
            if index == 0:  # Validation-only outliers must not affect normalization.
                labels["priv_plate_rel"] += 1000
            if (group, index) in ((0, 2), (2, 0)):
                labels = {}
            if (group, index) == (1, 2):
                labels = {"priv_held": labels["priv_held"]}
            path = directory / f"ep_{index}.npz"
            np.savez_compressed(
                path,
                rgb=rgb,
                rgb_stride=2,
                state=state,
                action=action,
                action_executed=np.full_like(action, 0.99),
                **(labels if group else {}),
            )
            if not group and labels:
                np.savez(path.with_suffix(".priv.npz"), **labels)
            if (group, index) == (1, 1):
                np.savez(
                    path.with_suffix(".priv.npz"), priv_plate_rel=labels["priv_plate_rel"] + 900
                )
            episodes[group, index] = (rgb, state, action, labels)
    return directories, episodes


def check_dataset(root, directories, episodes):
    store = EpisodeStore(directories, root / "cache", val_episodes=1)
    cached = EpisodeStore(directories, root / "cache", val_episodes=1)
    assert store.image_path == cached.image_path
    assert len(list((root / "cache").glob("*.u8"))) == 1
    assert store.val_ids == [0, 3, 6] and store.train_ids == [1, 2, 4, 5, 7, 8]
    dataset = store.dataset("train", horizon=20)
    # Last stored frame of human ep_1 is aligned with its final clean action.
    last = dataset[4]
    assert np.array_equal(last["rgb"], episodes[0, 1][0][-1])
    assert last["pad_mask"].tolist() == [False] + [True] * 19
    expected = np.broadcast_to(episodes[0, 1][2][-1, list(ACTIVE_DIMS)], (20, 10))
    np.testing.assert_array_equal(last["target"], expected)
    assert last["aux_mask"].all() and last["aux_target"][-1] == 1
    assert not dataset[5]["aux_mask"].any() and not dataset[5]["aux_target"].any()
    # Partial episodes retain supervision on their available held label only.
    assert dataset[11]["aux_mask"].tolist() == [False] * 8 + [True]
    states = np.concatenate([episodes[g, i][1] for g in range(3) for i in (1, 2)])
    np.testing.assert_allclose(
        store.stats["proprio_mean"], states[:, PROPRIO_DIMS].mean(0), rtol=1e-6
    )
    plate = np.concatenate(
        [episodes[g, i][3]["priv_plate_rel"] for g, i in ((0, 1), (1, 1), (2, 1), (2, 2))]
    )
    np.testing.assert_allclose(store.stats["aux_mean"][:3], plate.mean(0), rtol=1e-6, atol=1e-7)
    np.testing.assert_allclose(store.stats["aux_std"][:3], plate.std(0), rtol=1e-6)
    assert store.stats["aux_mean"][8] == 0 and store.stats["aux_std"][8] == 1
    assert set(store.priv) == set(PRIV_LABELS)
    # Sidecars are excluded from episode enumeration and included in cache identity.
    sidecar = Path(directories[0]) / "ep_2.priv.npz"
    np.savez(sidecar, priv_held=np.zeros(5, np.float32))
    changed = EpisodeStore(directories, root / "cache", val_episodes=1)
    assert changed.digest != store.digest and changed.dataset("train", 20)[5]["aux_mask"][-1]
    sidecar.unlink()
    # Default weights are uniform over frames; explicit weights allocate source mass.
    np.testing.assert_allclose(dataset.sample_weights(), 1 / len(dataset))
    counts = np.diff(np.r_[0, dataset.ends])
    groups = np.repeat(store.directory_ids[dataset.episode_ids], counts)
    weights = dataset.sample_weights((2, 1, 1))
    np.testing.assert_allclose([weights[groups == i].sum() for i in range(3)], (0.5, 0.25, 0.25))
    assert not dataset.sample_weights((1, 0, 0))[groups != 0].any()
    for invalid in ((1, 2), (0, 0, 0), (-1, 1, 1), (float("nan"), 1, 1)):
        try:
            dataset.sample_weights(invalid)
        except ValueError:
            pass
        else:
            raise AssertionError(f"Accepted bad data_weights: {invalid}")
    draws = list(StepBatches(weights, 10000, 0, 1, 9))[0]
    np.testing.assert_allclose(
        np.bincount(groups[draws]) / len(draws), (0.5, 0.25, 0.25), atol=0.02
    )
    all_batches = list(StepBatches(weights, 8, 0, 4, 7))
    assert list(StepBatches(weights, 8, 2, 4, 7)) == all_batches[2:]
    return store


def check_losses():
    prediction = torch.tensor([[[1.0] * 10, [1000.0] * 10]])
    assert masked_l1(prediction, torch.zeros_like(prediction), torch.tensor([[False, True]])) == 1
    aux = torch.zeros(3, 9, requires_grad=True)
    target = torch.ones_like(aux)
    mask = torch.tensor([[True] * 9, [False] * 9, [False] * 8 + [True]])
    loss = auxiliary_loss(aux, target, mask)
    torch.testing.assert_close(loss, torch.tensor((8 + 2 * math.log(2)) / 10))
    loss.backward()
    assert (aux.grad[~mask] == 0).all() and (aux.grad[mask] != 0).all()
    # Accumulation must use the labeled count, independently of action padding.
    accumulated = sum(
        auxiliary_loss(aux[i : i + 1], target[i : i + 1], mask[i : i + 1])
        * mask[i].sum()
        / mask.sum()
        for i in range(3)
    )
    torch.testing.assert_close(accumulated, loss)
    assert auxiliary_loss(aux, target, torch.zeros_like(mask)) == 0


def check_initialization(checkpoint, path, legacy_path):
    stats = {key: value.copy() for key, value in checkpoint["stats"].items()}
    stats["proprio_mean"] += 0.5
    stats["proprio_std"] *= 1.3
    stats["aux_mean"][:8] += 0.2
    stats["aux_std"][:8] *= 1.2
    original = BCModel(pretrained=False, aux_head=True).eval()
    original.load_state_dict(checkpoint["ema"])
    initialized = BCModel(pretrained=False, aux_head=True).eval()
    initialize_from(initialized, path, stats)
    rgb = torch.zeros(1, 3, 3, 84, 84, dtype=torch.uint8)
    raw = np.zeros(19, np.float32)
    with torch.inference_mode():
        old_action, old_aux = original(
            rgb,
            torch.from_numpy(
                (raw - checkpoint["stats"]["proprio_mean"]) / checkpoint["stats"]["proprio_std"]
            )[None],
            return_aux=True,
        )
        new_action, new_aux = initialized(
            rgb,
            torch.from_numpy((raw - stats["proprio_mean"]) / stats["proprio_std"])[None],
            return_aux=True,
        )
    torch.testing.assert_close(old_action, new_action, atol=2e-6, rtol=2e-5)
    torch.testing.assert_close(
        old_aux * torch.from_numpy(checkpoint["stats"]["aux_std"])
        + torch.from_numpy(checkpoint["stats"]["aux_mean"]),
        new_aux * torch.from_numpy(stats["aux_std"]) + torch.from_numpy(stats["aux_mean"]),
        atol=2e-6,
        rtol=2e-5,
    )
    initialize_from(initialized, legacy_path, checkpoint["stats"])
    for name, value in initialized.state_dict().items():
        if not name.startswith("aux_head."):
            torch.testing.assert_close(value, checkpoint["ema"][name], rtol=0, atol=0)
    # An architectural mismatch must fail explicitly, rather than silently drop weights.
    try:
        initialize_from(BCModel(horizon=10, pretrained=False), path, stats)
    except ValueError:
        pass
    else:
        raise AssertionError("Accepted incompatible init horizon")


def check_policy(root, store, checkpoint, path, episodes):
    previous = os.environ.get("ADV_CKPT")
    os.environ["ADV_CKPT"] = str(path)
    try:
        policy = make_policy()
        assert policy.model.aux_head is None
        obs = {"rgb": episodes[0, 0][0][0], "state": episodes[0, 0][1][0]}
        actions = policy(obs)
        assert actions.shape == (10, 20) and actions.dtype == np.float32
        assert np.isfinite(actions).all() and np.abs(actions).max() <= 1
        assert set(np.unique(actions[:, 18])) <= {-1, 1}
        inactive = [i for i in range(20) if i not in ACTIVE_DIMS]
        np.testing.assert_allclose(
            actions[:, inactive],
            np.broadcast_to(store.stats["action_mean"][inactive], (10, len(inactive))),
        )
        policy.reset()
        np.testing.assert_array_equal(policy(obs), actions)
        # Exactly the old inference schema: no aux tensors, dims or new config keys.
        legacy = {
            "version": 1,
            "config": {"horizon": 20, "exec_steps": 10},
            "ema": {
                key: value
                for key, value in checkpoint["ema"].items()
                if not key.startswith("aux_head.")
            },
            "stats": {
                key: value
                for key, value in checkpoint["stats"].items()
                if not key.startswith("aux_")
            },
        }
        legacy_path = root / "legacy.pt"
        atomic_save(legacy, legacy_path)
        np.testing.assert_array_equal(BCPolicy(legacy_path)(obs), actions)
        legacy["config"]["temporal_ensemble"] = True
        ensemble_path = root / "ensemble.pt"
        atomic_save(legacy, ensemble_path)
        ensemble = BCPolicy(ensemble_path)
        for _ in range(4):
            assert ensemble(obs).shape == (10, 20)
        ensemble.reset()
        assert ensemble.time == 0 and not ensemble.predictions
    finally:
        if previous is None:
            os.environ.pop("ADV_CKPT", None)
        else:
            os.environ["ADV_CKPT"] = previous
    return legacy_path, obs


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--num-workers", type=int, choices=(0, 1, 2), default=0)
    workers = parser.parse_args().num_workers
    os.environ["CUDA_VISIBLE_DEVICES"] = ""
    torch.set_num_threads(2)
    with tempfile.TemporaryDirectory(prefix="bc-smoke-") as temporary:
        root = Path(temporary)
        directories, episodes = fake_data(root)
        store = check_dataset(root, directories, episodes)
        check_losses()
        config = Config(
            data_dirs=tuple(directories),
            data_weights=(2, 1, 1),
            cache_dir=str(root / "cache"),
            run_dir=str(root / "interrupted"),
            device="cpu",
            steps=20,
            batch_size=2,
            microbatch_size=1,
            num_workers=workers,
            val_episodes=1,
            warmup_steps=3,
            save_every=10,
            val_every=10,
            log_every=10,
            pretrained=False,
        )
        train(config, stop_after=10)
        checkpoint_path = train(replace(config, num_workers=0))
        checkpoint = torch.load(checkpoint_path, map_location="cpu", weights_only=False)
        assert checkpoint["step"] == 20 and checkpoint["optimizer"]["state"]
        reference_path = train(replace(config, run_dir=str(root / "uninterrupted")))
        reference = torch.load(reference_path, map_location="cpu", weights_only=False)
        for key in ("model", "ema"):
            for name, value in checkpoint[key].items():
                torch.testing.assert_close(value, reference[key][name], rtol=0, atol=0)
        del reference
        with (root / "interrupted" / "log.csv").open() as stream:
            rows = list(csv.DictReader(stream))
        assert [row["step"] for row in rows] == ["10", "20"]
        assert all(
            float(row["train_aux_loss"]) > 0 and float(row["val_aux_loss"]) > 0 for row in rows
        )
        assert any(
            not torch.equal(checkpoint["model"][key], value)
            for key, value in checkpoint["ema"].items()
        )
        legacy_path, obs = check_policy(root, store, checkpoint, checkpoint_path, episodes)
        check_initialization(checkpoint, checkpoint_path, legacy_path)
        # Fine-tuning an old checkpoint creates fresh optimizer state and step count.
        init_path = train(
            replace(
                config, run_dir=str(root / "finetune"), steps=1, num_workers=0, pretrained=True
            ),
            init_from=legacy_path,
        )
        initialized = torch.load(init_path, map_location="cpu", weights_only=False)
        assert initialized["step"] == 1 and "aux_head.weight" in initialized["ema"]
        assert all(int(state["step"]) == 1 for state in initialized["optimizer"]["state"].values())
        del initialized
        # Training with aux disabled and a reordered proprio subset also serves inference.
        reduced_path = train(
            replace(
                config,
                run_dir=str(root / "reduced"),
                steps=1,
                num_workers=0,
                aux_weight=0,
                proprio_dims=(44, 0, 18),
            )
        )
        reduced = BCPolicy(reduced_path)
        assert reduced.proprio_dims == (44, 0, 18) and reduced(obs).shape == (10, 20)
        saved = torch.load(reduced_path, map_location="cpu", weights_only=False)
        assert "aux_head.weight" not in saved["ema"] and saved["val_aux_loss"] == 0
        print(
            f"CPU smoke passed: mixed/partial labels, weighted sources, 20-step exact resume with {workers}/0 workers, init-from, old/new policies and custom proprio. Wiring only; no task-success evidence."
        )


if __name__ == "__main__":
    main()
# BC and student v1

Run commands from the repository root. Export/evaluation use the committed uv
lock; training/inference use `/home/keyu/advaitic/mlenv/bin/python`. Candidate
implementation is in `method/bc/` and `submission/`.

Measured human-only baseline: validation L1 0.019 and closed-loop dev score
**0/30**, all timeouts with no gripper closure. Offline held-out gripper timing
was within about 20 steps. These observations motivate teacher data and auxiliary
supervision; student v1 has no measured task-success result yet.

## Data and export

```bash
uv sync --locked
ORT_DISABLE_TELEMETRY=1 MUJOCO_GL=egl uv run --locked python -m method.bc.export_human \
  --out /home/keyu/advaitic/data/human60 --metadata method/data/demo_meta.json
```

`get_demos(60)` runs once (about 2.5 GB RAM); existing episodes are skipped.
Export uses atomic replacement. Optional metadata supplies seed/slot, otherwise
both are `-1`. Seed, slot and success never enter the network. Unsuccessful
human/teacher episodes are retained.

Each `ep_<index>.npz` contains `rgb` uint8 `(ceil(T/2),3,3,84,84)`,
`rgb_stride=2`, `state` float32 `(T,50)` and clean `action` float32 `(T,20)`.
Camera order is head/right wrist/left wrist. Frame `j` corresponds to control
step `2*j`; actions are supervised at every control step, without a transition
shift. The terminal observation at `T` is omitted. `action_executed` is ignored:
controller corrections must not replace clean teacher targets.

Optional labels can be embedded in the episode or stored in
`ep_<index>.priv.npz`. Embedded values take precedence **per key**. Sidecars are
never enumerated as episodes. Known optional fields cached in the index are:

| Field | Shape |
| --- | --- |
| `priv_plate_rel`, `priv_target_site_rel` | `(T,3)` |
| `priv_plate_tilt_deg`, `priv_held` | `(T,)` |
| `priv_target_rack_offset`, `priv_start_rack_offset` | `(2,)` |

Present arrays must have the exact shape and finite values; held must be 0/1.
Missing labels remain masked. The nine-dimensional auxiliary target at sample
step `t` is `[plate_rel[t], target_site_rel[t], target_rack_offset, held[t]]`.
The mask is boolean `(9,)`: missing keys disable only their own dimensions;
an unlabeled episode has an entirely zero mask. Tilt/start-offset labels are
preserved in the index for future use but do not enter this target.

Normalization uses **training episodes only**, at every control step, ignoring
missing dimensions. The first eight auxiliary dimensions and configured proprio
indices get mean/std normalization (std floor `1e-3`). Held remains binary, with
mean 0/std 1. An auxiliary dimension absent throughout training uses mean 0/std 1.
Masked normalized targets are zero. Stats are stored in the checkpoint.

The cache streams one compressed episode at a time into one uint8 `<hash>.u8`
image file and a small `<hash>.npz` state/action/privileged-label/offset index.
Splits/workers share a read-only memmap; they do not hold the full RGB dataset
in RAM. The versioned key includes resolved episode and sidecar paths, sizes,
and modification times, including sidecar additions/removals. Sidecars arriving
after training starts require a new run, initialized from the previous weights.
A file lock and atomic index publication protect concurrent cache construction.
Do not change input files during a job. Old cache hashes can be removed later.

## Student configuration and sampling

`student_v1.yaml` supplies human60, teacher_v1 and teacher_v2; `H=20`,
`exec_steps=10`, 15,000 steps, batch 64/microbatch 8, auxiliary weight 0.1,
2 workers and default 19 proprio indices. `data_weights: [2, 1, 1]` assigns
50% of training draws to humans and 25% to each teacher directory, so teacher
growth cannot drown out human data. These weights specify **directory mass**,
not per-episode or per-frame weights. Sampling is uniform over stored frames
within each source, with replacement via `WeightedRandomSampler`. Omitted or
empty `data_weights` defaults to source training-frame counts, reproducing a
uniform mixture over all training frames. Zero weight disables a training source;
weights must be finite/nonnegative, one per directory, with positive total.

`val_episodes` is held out **per directory** using
`np.linspace(0, N-1, val_episodes, dtype=int)` within its numerically sorted files.
Every source must contain more than `val_episodes` episodes (at least 7 for the
example). For human60 alone, the six held-out indices remain
`0, 11, 23, 35, 47, 59`. Validation enumerates all held-out frames without weighted
sampling and aggregates action loss by valid action elements and auxiliary loss
by labeled dimensions. It measures an episode holdout, not simulator success.

## Training, initialization and resume

Operator training command (requires a GPU; not executed during this change):

```bash
ORT_DISABLE_TELEMETRY=1 /home/keyu/advaitic/mlenv/bin/python -m method.bc.train \
  --config method/bc/student_v1.yaml \
  --init-from method/bc/checkpoints/human60/last.pt
```

Omit `--init-from` to train from ImageNet initialization. Fine-tuning loads the
source **EMA model weights only**, with a fresh optimizer, scaler, EMA copy,
step 0 and RNG seed. It never downloads ImageNet weights when initializing from
a checkpoint. Horizon and ordered proprio dimensions must match the source;
architecture mismatches fail explicitly. Missing auxiliary weights initialize a
new head; a saved auxiliary head can also be discarded with `--aux-weight 0`.
Training-split normalization is recomputed for the new mixture. The first
proprio linear layer and existing auxiliary output layer are algebraically
rebased to preserve the source function in physical coordinates under those
new statistics. The initialization source path is saved for traceability.

Resume with the same config **without** `--init-from`:

```bash
ORT_DISABLE_TELEMETRY=1 /home/keyu/advaitic/mlenv/bin/python -m method.bc.train \
  --config method/bc/student_v1.yaml
```

`last.pt` automatically restores online/EMA weights, AdamW state, GradScaler,
step and Python/NumPy/torch/CUDA RNG. Each weighted batch uses an independent
seed derived from its absolute step, preserving the sample sequence across
prefetch/restarts. Run/cache paths, worker count and device may change on resume;
training settings and data identity must match. CUDA benchmarking can select
nondeterministic kernels; bitwise resume is checked on CPU only. Version-1
checkpoints remain valid for inference and `--init-from`; resuming their old
training state is rejected because cache/sampling semantics changed.

All settings have CLI flags; CLI overrides flat YAML/JSON. Inline lists support
`data_dirs`, `data_weights` and `proprio_dims`. For example,
`--proprio-dims 44 0 18` changes both the selected state indices and their order.
The default remains `0:9,18:22,40:44,44:46` (19 dims). The ordered indices are
stored in config/checkpoints and read by the policy. A different proprio
architecture requires a fresh run without an incompatible `--init-from`.

## Model, losses and speed

- Shared ResNet-18 through layer3, ImageNet initialization, 32 spatial-softmax
  keypoints per camera, and a learned 16-dimensional camera embedding retain
  the existing visual architecture. BatchNorm statistics stay frozen.
- The 128-dimensional GELU proprio embedding joins all camera features. The
  existing two-layer 512-wide GELU/dropout action head predicts `H x 10` actions.
  A separate **linear 368-to-9 head** reads the same fused feature, encouraging
  observation features to encode privileged geometry without using it as input.
- Total optimization loss is action L1 plus `aux_weight * auxiliary_loss`.
  Auxiliary loss averages eight MSE terms and one held BCE-with-logits term over
  the **available dimensions**. Each microbatch is scaled by its valid action
  count for L1 and independently by its labeled-dimension count for auxiliary
  loss, preserving the logical batch objective with partial/missing labels.
  `aux_weight=0` omits the head and its loss entirely.
- Action end-padding repeats the final clean action and is excluded from L1.
  Samples begin at stored even steps. Aux labels refer to the current sample
  step, not the predicted future action chunk.
- Training-only DrQ shifts and ImageNet normalization are unchanged. Backbone
  input is contiguous `channels_last`; cuDNN benchmarking is enabled in training.
  Default workers are 2; CUDA loaders pin memory and transfers are nonblocking.
- AdamW head/backbone LR `3e-4`/`1e-4`, weight decay `1e-4`, 500-step warmup then
  cosine, fp16 autocast/scaling on CUDA, gradient clipping 1.0, EMA decay 0.999.
  CPU uses fp32. EMA validates and serves inference.

`last.pt` is atomically replaced every 1,000 steps and at completion, with full
validation on each save. `log.csv` columns are
`step,train_loss,val_loss,train_aux_loss,val_aux_loss,lr,it/s`. Action and auxiliary
losses are logged separately, before multiplying by `aux_weight`; auxiliary
loss is zero when disabled or no labels are available. Train action loss averages
batches since the last log; train auxiliary loss averages labeled dimensions.
Validation fields retain the latest result (NaN before first validation).
Throughput includes validation/checkpoint overhead. Logs append across resume;
entries after the last durable checkpoint can repeat following a crash.

The trainer reports allocated/reserved CUDA peaks and rejects reserved peak
>=3 GB. Existing human-only measurements were about 5 it/s, 0.43 GB peak; these
are **not student-v1 measurements**. Student GPU throughput/memory, CUDA numerics,
cuDNN benchmarking and pinned-memory behavior remain unverified here.

