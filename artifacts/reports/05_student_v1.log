"""Shared BC network; kept in submission so evaluator digests cover inference code."""

import torch
from torch import nn
from torch.nn import functional as F
from torchvision.models import ResNet18_Weights, resnet18

ACTIVE_DIMS = (0, 1, 4, 5, 6, 7, 8, 9, 10, 18)
PROPRIO_DIMS = (*range(9), *range(18, 22), *range(40, 44), 44, 45)


def validate_proprio_dims(dims):
    dims = tuple(dims)
    if (
        not dims
        or any(type(i) is not int or not 0 <= i < 50 for i in dims)
        or len(set(dims)) != len(dims)
    ):
        raise ValueError("proprio_dims must be unique integer state indices in [0, 50)")
    return dims


def load_bc_weights(model, state):
    """Allow only the optional auxiliary head to differ between checkpoints."""
    state = dict(state)
    aux_keys = {"aux_head.weight", "aux_head.bias"}
    if aux_keys.intersection(state) not in (set(), aux_keys):
        raise ValueError("Checkpoint has an incomplete auxiliary head")
    if model.aux_head is None:
        state.pop("aux_head.weight", None)
        state.pop("aux_head.bias", None)
    missing, unexpected = model.load_state_dict(state, strict=False)
    allowed = aux_keys if model.aux_head is not None else set()
    if set(missing) - allowed or unexpected:
        raise ValueError(f"Checkpoint weights mismatch: missing={missing}, unexpected={unexpected}")


class SpatialSoftmax(nn.Module):
    def __init__(self):
        super().__init__()
        self.project = nn.Conv2d(256, 32, 1)

    def forward(self, features):
        features = self.project(features)
        h, w = features.shape[-2:]
        # Accumulate probabilities in fp32 even under autocast.
        probabilities = features.flatten(2).float().softmax(-1)
        y, x = torch.meshgrid(
            torch.linspace(-1, 1, h, device=features.device),
            torch.linspace(-1, 1, w, device=features.device),
            indexing="ij",
        )
        return torch.stack(
            (probabilities @ x.flatten(), probabilities @ y.flatten()), dim=-1
        ).flatten(1)


def random_shift(images, pad=4):
    """DrQ replication padding + independent integer translation per camera image."""
    n, _, h, w = images.shape
    padded = F.pad(images, (pad, pad, pad, pad), mode="replicate")
    offsets = torch.randint(2 * pad + 1, (n, 2), device=images.device)
    ys = offsets[:, 0, None, None] + torch.arange(h, device=images.device)[None, :, None]
    xs = offsets[:, 1, None, None] + torch.arange(w, device=images.device)[None, None, :]
    return padded.permute(0, 2, 3, 1)[
        torch.arange(n, device=images.device)[:, None, None], ys, xs
    ].permute(0, 3, 1, 2)


class BCModel(nn.Module):
    def __init__(self, horizon=20, pretrained=True, proprio_dims=PROPRIO_DIMS, aux_head=False):
        super().__init__()
        if not 1 <= horizon <= 50:
            raise ValueError("horizon must be in [1, 50]")
        self.horizon = horizon
        self.proprio_dims = validate_proprio_dims(proprio_dims)
        network = resnet18(weights=ResNet18_Weights.DEFAULT if pretrained else None)
        self.backbone = nn.Sequential(*list(network.children())[:7])  # through layer3
        self.spatial = SpatialSoftmax()
        self.camera_embedding = nn.Embedding(3, 16)
        self.proprio = nn.Sequential(nn.Linear(len(self.proprio_dims), 128), nn.GELU())
        self.head = nn.Sequential(
            nn.Linear(3 * (64 + 16) + 128, 512),
            nn.GELU(),
            nn.Dropout(0.1),
            nn.Linear(512, 512),
            nn.GELU(),
            nn.Dropout(0.1),
            nn.Linear(512, horizon * len(ACTIVE_DIMS)),
        )
        self.aux_head = nn.Linear(3 * (64 + 16) + 128, 9) if aux_head else None
        self.register_buffer("image_mean", torch.tensor([0.485, 0.456, 0.406])[None, :, None, None])
        self.register_buffer("image_std", torch.tensor([0.229, 0.224, 0.225])[None, :, None, None])
        self.train()

    def train(self, mode=True):
        super().train(mode)
        # Freeze ImageNet BN statistics: small correlated robot batches give noisy
        # estimates. Affine parameters and all convolution weights still train.
        for layer in self.backbone.modules():
            if isinstance(layer, nn.BatchNorm2d):
                layer.eval()
        return self

    def forward(self, rgb, proprio, *, return_aux=False):
        batch = rgb.shape[0]
        images = rgb.reshape(-1, 3, 84, 84).float().div(255)
        if self.training:
            images = random_shift(images)
        images = (images - self.image_mean) / self.image_std
        images = images.contiguous(memory_format=torch.channels_last)
        features = self.spatial(self.backbone(images)).reshape(batch, 3, 64)
        cameras = self.camera_embedding.weight[None].expand(batch, -1, -1)
        vision = torch.cat((features, cameras), dim=-1).flatten(1)
        fused = torch.cat((vision, self.proprio(proprio)), dim=-1)
        actions = self.head(fused).reshape(batch, self.horizon, len(ACTIVE_DIMS))
        if return_aux:
            return actions, self.aux_head(fused) if self.aux_head is not None else None
        return actions


def masked_l1(prediction, target, pad_mask):
    """True means padding; padding contributes neither loss nor denominator."""
    valid = (~pad_mask).unsqueeze(-1)
    return ((prediction - target).abs() * valid).sum() / (
        valid.sum().clamp_min(1) * prediction.shape[-1]
    )


def auxiliary_loss(prediction, target, mask):
    """Mean over labeled dimensions: eight MSE terms and a held BCE logit."""
    errors = torch.cat(
        (
            (prediction[..., :8] - target[..., :8]).square(),
            F.binary_cross_entropy_with_logits(
                prediction[..., 8:], target[..., 8:], reduction="none"
            ),
        ),
        dim=-1,
    )
    return (errors * mask).sum() / mask.sum().clamp_min(1)
"""Observation-only BC policy. Set ADV_CKPT to an EMA training checkpoint."""

import os
from pathlib import Path

import numpy as np
import torch

from .model import ACTIVE_DIMS, PROPRIO_DIMS, BCModel, load_bc_weights, validate_proprio_dims


class BCPolicy:
    def __init__(self, checkpoint):
        self.device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        # Our own checkpoints contain optimizer/RNG objects as well as tensors.
        checkpoint = torch.load(checkpoint, map_location="cpu", weights_only=False)
        config = checkpoint["config"]
        self.horizon = config["horizon"]
        self.exec_steps = config["exec_steps"]
        if not 1 <= self.exec_steps <= self.horizon <= 50:
            raise ValueError("Require 1 <= exec_steps <= horizon <= 50")
        self.proprio_dims = validate_proprio_dims(config.get("proprio_dims", PROPRIO_DIMS))
        # The auxiliary head never participates in inference, even when saved.
        self.model = BCModel(self.horizon, pretrained=False, proprio_dims=self.proprio_dims)
        load_bc_weights(self.model, checkpoint["ema"])
        self.model.to(self.device).eval()
        stats = checkpoint["stats"]
        self.mean = np.asarray(stats["proprio_mean"], dtype=np.float32)
        self.std = np.asarray(stats["proprio_std"], dtype=np.float32)
        self.action_mean = np.asarray(stats["action_mean"], dtype=np.float32)
        shape = (len(self.proprio_dims),)
        if self.mean.shape != shape or self.std.shape != shape or self.action_mean.shape != (20,):
            raise ValueError("Checkpoint normalization shapes do not match this policy")
        self.temporal_ensemble = config.get("temporal_ensemble", False)
        self.ensemble_decay = config.get("ensemble_decay", 0.01)
        self.reset()

    def reset(self):
        self.time = 0
        self.predictions = []

    @torch.inference_mode()
    def __call__(self, obs):
        rgb = np.asarray(obs["rgb"], dtype=np.uint8)
        state = np.asarray(obs["state"], dtype=np.float32)
        if rgb.shape != (3, 3, 84, 84) or state.shape != (50,):
            raise ValueError("Expected RGB (3,3,84,84) and state (50,)")
        proprio = (state[list(self.proprio_dims)] - self.mean) / self.std
        chunk = (
            self.model(
                torch.from_numpy(rgb.copy())[None].to(self.device),
                torch.from_numpy(proprio)[None].to(self.device),
            )[0]
            .float()
            .cpu()
            .numpy()
        )
        active = chunk[: self.exec_steps].copy()
        if self.temporal_ensemble:
            # Observations still arrive only every exec_steps control steps.
            self.predictions = [(t, p) for t, p in self.predictions if t + self.horizon > self.time]
            self.predictions.append((self.time, chunk))
            for offset in range(self.exec_steps):
                candidates = [
                    p[self.time + offset - t]
                    for t, p in self.predictions
                    if 0 <= self.time + offset - t < self.horizon
                ]
                # ACT convention: older overlapping predictions get more weight.
                weights = np.exp(-self.ensemble_decay * np.arange(len(candidates)))
                active[offset] = np.average(candidates, axis=0, weights=weights)
        self.time += self.exec_steps
        actions = np.broadcast_to(self.action_mean, (self.exec_steps, 20)).copy()
        actions[:, ACTIVE_DIMS] = active
        actions[:, 18] = np.where(actions[:, 18] >= 0, 1.0, -1.0)
        if not np.isfinite(actions).all():
            raise ValueError("BC prediction contains nonfinite actions")
        return np.clip(actions, -1, 1).astype(np.float32)


def make_policy():
    path = os.environ.get("ADV_CKPT") or Path(__file__).parent / "weights" / "policy.pt"
    return BCPolicy(path)
        torch.cuda.set_rng_state_all(state["cuda"])


def lr_factor(step, config):
    if step < config.warmup_steps:
        return (step + 1) / config.warmup_steps
    progress = (step - config.warmup_steps) / max(1, config.steps - config.warmup_steps)
    return 0.5 * (1 + math.cos(math.pi * min(progress, 1)))


@torch.no_grad()
def update_ema(ema, model, decay):
    for average, current in zip(ema.parameters(), model.parameters(), strict=True):
        average.lerp_(current.detach(), 1 - decay)
    for average, current in zip(ema.buffers(), model.buffers(), strict=True):
        average.copy_(current)


def to_device(batch, device):
    return {key: value.to(device, non_blocking=True) for key, value in batch.items()}


@torch.inference_mode()
def validate(model, loader, device, cuda):
    model.eval()
    total, count, aux_total, aux_count = 0.0, 0, 0.0, 0
    for batch in loader:
        batch = to_device(batch, device)
        with torch.autocast(device_type=device.type, dtype=torch.float16, enabled=cuda):
            prediction, aux = model(batch["rgb"], batch["proprio"], return_aux=True)
            loss = masked_l1(prediction.float(), batch["target"], batch["pad_mask"])
            if aux is not None:
                labeled = int(batch["aux_mask"].sum())
                aux_total += (
                    float(auxiliary_loss(aux.float(), batch["aux_target"], batch["aux_mask"]))
                    * labeled
                )
                aux_count += labeled
        valid = int((~batch["pad_mask"]).sum()) * prediction.shape[-1]
        total += float(loss) * valid
        count += valid
    return total / count, aux_total / aux_count if aux_count else 0.0


@torch.no_grad()
def initialize_from(model, path, stats):
    """Start from EMA weights, preserving their meaning under new normalization."""
    checkpoint = torch.load(path, map_location="cpu", weights_only=False)
    source = checkpoint["config"]
    if (
        source["horizon"] != model.horizon
        or tuple(source.get("proprio_dims", PROPRIO_DIMS)) != model.proprio_dims
    ):
        raise ValueError("--init-from requires matching horizon and proprio_dims")
    load_bc_weights(model, checkpoint["ema"])
    old = checkpoint["stats"]
    layer = model.proprio[0]
    mean_shift = torch.as_tensor(
        (stats["proprio_mean"] - old["proprio_mean"]) / old["proprio_std"],
        device=layer.weight.device,
    )
    scale = torch.as_tensor(stats["proprio_std"] / old["proprio_std"], device=layer.weight.device)
    layer.bias.add_(layer.weight @ mean_shift)
    layer.weight.mul_(scale)
    if model.aux_head is not None and "aux_head.weight" in checkpoint["ema"]:
        # New normalized predictions correspond to the same physical labels.
        layer = model.aux_head
        scale = torch.as_tensor(old["aux_std"] / stats["aux_std"], device=layer.weight.device)
        shift = torch.as_tensor(
            (old["aux_mean"] - stats["aux_mean"]) / stats["aux_std"], device=layer.weight.device
        )
        layer.weight.mul_(scale[:, None])
        layer.bias.mul_(scale).add_(shift)


def train(config, *, stop_after=None, init_from=None):
    """stop_after tests interruption without changing the total LR schedule."""
    validate_config(config)
    torch.backends.cudnn.benchmark = True
    device = torch.device(config.device)
    cuda = device.type == "cuda"
    if cuda and not torch.cuda.is_available():
        raise RuntimeError("CUDA is unavailable; pass --device cpu for a CPU run")
    random.seed(config.seed)
    np.random.seed(config.seed)
    torch.manual_seed(config.seed)
    if cuda:
        torch.cuda.reset_peak_memory_stats(device)
    run_dir = Path(config.run_dir)
    run_dir.mkdir(parents=True, exist_ok=True)
    checkpoint_path = run_dir / "last.pt"
    previous = (
        torch.load(checkpoint_path, map_location="cpu", weights_only=False)
        if checkpoint_path.exists()
        else None
    )
    if previous is not None and init_from is not None:
        raise ValueError("--init-from requires a new run directory; omit it to resume")
    init_source = previous.get("init_from") if previous else str(init_from) if init_from else None
    store = EpisodeStore(
        config.data_dirs, config.cache_dir, config.val_episodes, config.proprio_dims
    )
    train_data, val_data = (
        store.dataset("train", config.horizon),
        store.dataset("val", config.horizon),
    )
    sample_weights = train_data.sample_weights(config.data_weights)
    if previous is not None:
        if previous.get("version") != 2:
            raise ValueError("Legacy training checkpoint: use --init-from in a new run directory")
        allowed_changes = {"run_dir", "cache_dir", "num_workers", "device"}
        for key, value in asdict(config).items():
            if key not in allowed_changes and value != previous["config"][key]:
                raise ValueError(f"Resume config changed: {key}; use a new run directory")
        if previous["data_digest"] != store.digest:
            raise ValueError("Resume data changed; use a new run directory")
    assert (aux.grad[~mask] == 0).all() and (aux.grad[mask] != 0).all()
    # Accumulation must use the labeled count, independently of action padding.
    accumulated = sum(
        auxiliary_loss(aux[i : i + 1], target[i : i + 1], mask[i : i + 1])
        * mask[i].sum()
        / mask.sum()
        for i in range(3)
    )
    torch.testing.assert_close(accumulated, loss)
    assert auxiliary_loss(aux, target, torch.zeros_like(mask)) == 0


def check_initialization(checkpoint, path, legacy_path):
    stats = {key: value.copy() for key, value in checkpoint["stats"].items()}
    stats["proprio_mean"] += 0.5
    stats["proprio_std"] *= 1.3
    stats["aux_mean"][:8] += 0.2
    stats["aux_std"][:8] *= 1.2
    original = BCModel(pretrained=False, aux_head=True).eval()
    original.load_state_dict(checkpoint["ema"])
    initialized = BCModel(pretrained=False, aux_head=True).eval()
    initialize_from(initialized, path, stats)
    rgb = torch.zeros(1, 3, 3, 84, 84, dtype=torch.uint8)
    raw = np.zeros(19, np.float32)
    with torch.inference_mode():
        old_action, old_aux = original(
            rgb,
            torch.from_numpy(
                (raw - checkpoint["stats"]["proprio_mean"]) / checkpoint["stats"]["proprio_std"]
            )[None],
            return_aux=True,
        )
        new_action, new_aux = initialized(
            rgb,
            torch.from_numpy((raw - stats["proprio_mean"]) / stats["proprio_std"])[None],
            return_aux=True,
        )
    torch.testing.assert_close(old_action, new_action, atol=2e-6, rtol=2e-5)
    torch.testing.assert_close(
        old_aux * checkpoint["stats"]["aux_std"] + checkpoint["stats"]["aux_mean"],
        new_aux * stats["aux_std"] + stats["aux_mean"],
        atol=2e-6,
        rtol=2e-5,
    )
    initialize_from(initialized, legacy_path, checkpoint["stats"])
    # An architectural mismatch must fail explicitly, rather than silently drop weights.
    try:
        initialize_from(BCModel(horizon=10, pretrained=False), path, stats)
    except ValueError:
        pass
    else:
        raise AssertionError("Accepted incompatible init horizon")


def check_policy(root, store, checkpoint, path, episodes):
    previous = os.environ.get("ADV_CKPT")
    os.environ["ADV_CKPT"] = str(path)
    try:
        policy = make_policy()
        assert policy.model.aux_head is None
        obs = {"rgb": episodes[0, 0][0][0], "state": episodes[0, 0][1][0]}
        actions = policy(obs)
        assert actions.shape == (10, 20) and actions.dtype == np.float32
        assert np.isfinite(actions).all() and np.abs(actions).max() <= 1
        assert set(np.unique(actions[:, 18])) <= {-1, 1}
        inactive = [i for i in range(20) if i not in ACTIVE_DIMS]
        np.testing.assert_allclose(
            actions[:, inactive],
            np.broadcast_to(store.stats["action_mean"][inactive], (10, len(inactive))),
        )
        policy.reset()

