+"""Hybrid Muon/AdamW for microVLA, without requiring torch.optim.Muon.
+
+Credit: Keller Jordan's Muon (https://github.com/KellerJordan/Muon) for
+Nesterov + quintic Newton--Schulz; Moonlight (https://arxiv.org/abs/2502.16982)
+for the 0.2 * sqrt(max(rows, cols)) update-RMS matching rule.
+"""
+
+import math
+
+import torch
+
+
+@torch.no_grad()
+def newton_schulz(update, steps=5):
+    """Approximate the polar factor; fp32 CPU, bf16 CUDA, rows <= columns.
+
+    The deliberately nonconvergent quintic gives approximate unit singular
+    values, not an exact SVD. Near-zero singular values may need more steps.
+    """
+    if update.ndim != 2 or steps < 1:
+        raise ValueError("Newton--Schulz requires a matrix and positive steps")
+    with torch.autocast(device_type=update.device.type, enabled=False):
+        x = update.to(torch.bfloat16 if update.is_cuda else torch.float32)
+        transposed = x.shape[0] > x.shape[1]
+        if transposed:
+            x = x.T
+        x = x / (x.norm() + 1e-7)
+        for _ in range(steps):
+            gram = x @ x.T
+            polynomial = -4.7750 * gram + 2.0315 * (gram @ gram)
+            x = 3.4445 * x + polynomial @ x
+        return x.T if transposed else x
+
+
+@torch.no_grad()
+def muon_update(update, steps=5, split_sizes=None):
+    """Orthogonalise/scale each projection independently, including fused QKV."""
+    pieces = (update,) if split_sizes is None else update.split(split_sizes, dim=0)
+    result = [newton_schulz(p, steps) * (0.2 * math.sqrt(max(p.shape))) for p in pieces]
+    return result[0] if split_sizes is None else torch.cat(result, dim=0)
+
+
+class HybridMuon(torch.optim.AdamW):
+    """One serialisable optimizer: Muon matrices and ordinary AdamW fallback.
+
+    Reuse PyTorch's AdamW implementation and state format for fallback groups.
+    Muon momentum buffers live in the same state dict, so ordinary optimizer
+    checkpoint loading restores both algorithms and their group learning rates.
+    """
+
+    def __init__(self, groups, *, lr, weight_decay, momentum=0.95, ns_steps=5):
+        if not 0 <= momentum < 1 or not isinstance(ns_steps, int) or ns_steps < 1:
+            raise ValueError("Invalid Muon momentum or Newton--Schulz steps")
+        super().__init__(groups, lr=lr, weight_decay=weight_decay)
+        for group in self.param_groups:
+            group.setdefault("use_muon", False)
+            group.setdefault("momentum", momentum)
+            group.setdefault("ns_steps", ns_steps)
+            if group["use_muon"] and any(p.ndim != 2 for p in group["params"]):
+                raise ValueError("Muon groups must contain only matrices")
+
+    @torch.no_grad()
+    def step(self, closure=None):
+        loss = None
+        if closure is not None:
+            with torch.enable_grad():
+                loss = closure()
+        groups = self.param_groups
+        for group in groups:
+            if not group["use_muon"]:
+                continue
+            for p in group["params"]:
+                if p.grad is None:
+                    continue
+                grad = p.grad
+                if grad.is_sparse:
+                    raise RuntimeError("Muon does not support sparse gradients")
+                state = self.state[p]
+                if "momentum_buffer" not in state:
+                    state["momentum_buffer"] = torch.zeros_like(p)
+                    # AdamW's checkpoint loader expects a scalar step in every
+                    # nonempty state; it is also useful for resume inspection.
+                    state["step"] = torch.tensor(0.0)
+                state["step"] += 1
+                buffer = state["momentum_buffer"]
+                buffer.lerp_(grad, 1 - group["momentum"])
+                # Nesterov lookahead, without modifying the accumulated gradient.
+                nesterov = grad.lerp(buffer, group["momentum"])
+                update = muon_update(nesterov, group["ns_steps"], group.get("split_sizes"))
+                p.mul_(1 - group["lr"] * group["weight_decay"])
+                p.add_(update.to(p.dtype), alpha=-group["lr"])
+        try:
+            self.param_groups = [g for g in groups if not g["use_muon"]]
+            super().step()
+        finally:
+            self.param_groups = groups
+        return loss
+
+
+def hybrid_groups(model, *, distill_head=None):
+    """Explicit structural whitelist; every other trainable tensor uses AdamW.
+
+    Modulation stays on AdamW: zero-initialised scale/shift/gate projections
+    control conditioning rather than transformer feature mixing.
+    """
+    candidates = {}
+
+    def matrix(p, component, split_sizes=None):
+        if p.ndim != 2 or id(p) in candidates:
+            raise ValueError("Invalid or duplicate Muon matrix")
+        candidates[id(p)] = (component, split_sizes)
+
+    for block in model.vision.blocks:
+        d = block.self_attn.embed_dim
+        matrix(block.self_attn.in_proj_weight, "vision", (d, d, d))
+        for p in (block.self_attn.out_proj.weight, block.linear1.weight, block.linear2.weight):
+            matrix(p, "vision")
+    if distill_head is None:
+        for block in model.layers:
+            for component, expert in (("prefix", block.prefix), ("expert", block.action)):
+                h, d = expert.heads, expert.head_dim
+                matrix(expert.qkv.weight, component, (h * d, d, d))
+                for p in (expert.out.weight, expert.ffn.up.weight, expert.ffn.down.weight):
+                    matrix(p, component)
+
+    named = (
+        [("vision." + n, p) for n, p in model.vision.named_parameters()]
+        + [("distill_head." + n, p) for n, p in distill_head.named_parameters()]
+        if distill_head is not None
+        else list(model.named_parameters())
+    )
+    groups, assigned = {}, set()
+    for name, p in named:
+        if not p.requires_grad:
+            continue
+        if id(p) in assigned:
+            raise ValueError(f"Duplicate parameter: {name}")
+        assigned.add(id(p))
+        if id(p) in candidates:
+            component, split = candidates[id(p)]
+            kind = "qkv" if split else "matrices"
+            key = (True, component, kind)
+        else:
+            component = (
+                "vision"
+                if name.startswith("vision.")
+                else "prefix"
+                if name.startswith("layers.") and ".prefix." in name
+                else "expert"
+                if name.startswith("layers.") and ".action." in name
+                else "distill_head"
+                if name.startswith("distill_head.")
+                else "embeddings_heads"
+            )
+            split, kind = None, "fallback"
+            key = (False, component, kind)
+        if key not in groups:
+            groups[key] = dict(
+                params=[], use_muon=key[0], group_name=f"{component}/{kind}", split_sizes=split
+            )
+        groups[key]["params"].append(p)
+    if not assigned or not set(candidates).issubset(assigned):
+        raise ValueError("Missing trainable Muon parameters")
+    return list(groups.values())
+
+
+def build_optimizer(
+    model,
+    *,
+    optimizer="adamw",
+    lr=3e-4,
+    weight_decay=0.01,
+    muon_lr=None,
+    momentum=0.95,
+    ns_steps=5,
+    distill_head=None,
+):
+    if optimizer == "adamw":
+        # Preserve legacy parameter order, one group, and the AdamW state format.
+        parameters = (
+            [*model.vision.parameters(), *distill_head.parameters()]
+            if distill_head is not None
+            else list(model.parameters())
+        )
+        return torch.optim.AdamW(parameters, lr=lr, weight_decay=weight_decay)
+    if optimizer != "muon":
+        raise ValueError(f"Unknown optimizer: {optimizer}")
+    groups = hybrid_groups(model, distill_head=distill_head)
+    for group in groups:
+        group["lr"] = muon_lr if group["use_muon"] and muon_lr is not None else lr
+        group["base_lr"] = group["lr"]
+    return HybridMuon(groups, lr=lr, weight_decay=weight_decay, momentum=momentum, ns_steps=ns_steps)
+
+
+def optimizer_counts(optimizer):
+    return [
+        dict(
+            optimizer="muon" if g.get("use_muon", False) else "adamw",
+            group=g.get("group_name", "all"),
+            tensors=len(g["params"]),
+            parameters=sum(p.numel() for p in g["params"]),
+        )
+        for g in optimizer.param_groups
+    ]
+
+
+def print_optimizer_table(optimizer, phase):
+    rows = optimizer_counts(optimizer)
+    print(f"Optimizer parameters ({phase})", flush=True)
+    print(f"{'optimizer':<10} {'group':<30} {'tensors':>8} {'parameters':>14}", flush=True)
+    for row in rows:
+        print(
+            f"{row['optimizer']:<10} {row['group']:<30} {row['tensors']:>8} "
+            f"{row['parameters']:>14,}",
+            flush=True,
+        )
+    for name in ("muon", "adamw"):
+        count = sum(row["parameters"] for row in rows if row["optimizer"] == name)
+        print(f"{name:<10} {'TOTAL':<30} {'':>8} {count:>14,}", flush=True)
diff --git a/method/vla/smoke_large.py b/method/vla/smoke_large.py
new file mode 100644
index 0000000000000000000000000000000000000000..5d9efec4a8972a65e1d68bdf2cd1081f0717d2c9
--- /dev/null
+++ b/method/vla/smoke_large.py
@@ -0,0 +1,110 @@
+"""CPU large-config forward/backward and analytical memory accounting.
+
+No real data, cache, teacher weights, GPU, or simulator is accessed.
+"""
+
+import json
+import os
+import time
+from pathlib import Path
+
+import torch
+from torch import nn
+
+from method.bc.train import read_config
+from method.vla.model import (
+    MicroVLA,
+    flow_loss_terms,
+    instruction_tokens,
+    model_config,
+    parameter_counts,
+    token_counts,
+)
+from method.vla.muon import build_optimizer, optimizer_counts
+from method.vla.train import Config, validate_config
+
+
+def main():
+    if os.environ.get("CUDA_VISIBLE_DEVICES") != "":
+        raise RuntimeError("Set CUDA_VISIBLE_DEVICES='' for CPU-only checks")
+    torch.set_num_threads(2)
+    torch.manual_seed(42)
+    values = read_config(Path(__file__).with_name("microvla_large.yaml"))
+    config = Config(**{**values, "device": "cpu"})
+    validate_config(config)
+    model = MicroVLA(model_config(config.horizon, **config.model_overrides))
+    counts, tokens = parameter_counts(model), token_counts(model.config)
+    assert 35_000_000 <= counts["total"] <= 45_000_000
+    assert tokens["total"] == 482
+    images = torch.randint(0, 256, (1, 3, 3, 96, 96), dtype=torch.uint8)
+    state = torch.zeros(1, 19)
+    actions = torch.zeros(1, config.horizon, 10)
+    parameter_storage = {p.untyped_storage().data_ptr() for p in model.parameters()}
+    saved_storage = {}
+
+    def pack(tensor):
+        storage = tensor.untyped_storage()
+        pointer = storage.data_ptr()
+        if pointer not in parameter_storage:
+            saved_storage[pointer] = storage.nbytes()
+        return tensor
+
+    started = time.perf_counter()
+    with torch.autograd.graph.saved_tensors_hooks(pack, lambda tensor: tensor):
+        total, n = flow_loss_terms(
+            model,
+            images,
+            state,
+            instruction_tokens(1, "cpu"),
+            actions,
+            torch.ones_like(actions, dtype=torch.bool),
+        )
+    (total / n).backward()
+    elapsed = time.perf_counter() - started
+    assert any(p.grad is not None for p in model.parameters())
+    assert all(p.grad is None or torch.isfinite(p.grad).all() for p in model.parameters())
+    optimizer = build_optimizer(model, optimizer="muon", lr=config.lr)
+    # Exercise the real large matrices, not just the tiny unit-test geometry.
+    optimizer.step()
+    assert all(torch.isfinite(p).all() for p in model.parameters())
+    results = dict(
+        params=counts,
+        tokens=tokens,
+        flow_optimizer_groups=optimizer_counts(optimizer),
+        distill_optimizer_groups=optimizer_counts(
+            build_optimizer(
+                model, optimizer="muon", distill_head=nn.Linear(model.config.width, 768)
+            )
+        ),
+        cpu_microbatch_1_forward_backward_seconds=elapsed,
+        flow_loss=float(total.detach() / n),
+        # The final prefix finish result is unused by the vendor action path.
+        unused_gradient_parameters=[name for name, p in model.named_parameters() if p.grad is None],
+        cpu_saved_nonparameter_storage_bytes_microbatch_1=sum(saved_storage.values()),
+    )
+    muon_params = sum(
+        row["parameters"] for row in results["flow_optimizer_groups"] if row["optimizer"] == "muon"
+    )
+    adam_params = counts["total"] - muon_params
+    # fp32 model, EMA, grads (12 B/param), one Muon / two AdamW moment buffers.
+    results["static_training_gib"] = (
+        12 * counts["total"] + 4 * muon_params + 8 * adam_params
+    ) / 2**30
+    # Approximation only: CPU kernels and CUDA bf16 save different intermediates.
+    results["saved_activation_bf16_batch64_proxy_gib"] = sum(saved_storage.values()) * 32 / 2**30
+    results["one_dense_fp32_joint_score_all_layers_batch64_gib"] = (
+        64 * model.config.heads * tokens["total"] ** 2 * model.config.depth * 4 / 2**30
+    )
+    v1 = MicroVLA(model_config())
+    results["v1"] = dict(
+        params=parameter_counts(v1),
+        flow_optimizer_groups=optimizer_counts(build_optimizer(v1, optimizer="muon")),
+        distill_optimizer_groups=optimizer_counts(
+            build_optimizer(v1, optimizer="muon", distill_head=nn.Linear(v1.config.width, 768))
+        ),
+    )
+    print(json.dumps(results, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/method/vla/test_muon.py b/method/vla/test_muon.py
new file mode 100644
index 0000000000000000000000000000000000000000..021e222ba516c535644301417a3f9152ecf0f230
--- /dev/null
+++ b/method/vla/test_muon.py
@@ -0,0 +1,362 @@
+"""Fast CPU-only Muon tests; fake tensors/store, no dataset or cache writes.
+
+Run: python -B -m unittest method.vla.test_muon -v
+"""
+
+import copy
+import io
+import json
+import os
+import tempfile
+import unittest
+from collections import Counter
+from contextlib import redirect_stdout
+from dataclasses import asdict, replace
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+from method.vla.model import (
+    MicroVLA,
+    flow_loss_terms,
+    instruction_tokens,
+    model_config,
+)
+from method.vla.muon import HybridMuon, build_optimizer, hybrid_groups, muon_update, newton_schulz
+from method.vla.train import Config, schedule_optimizer, train, validate_config, validate_resume_config
+
+TINY = dict(
+    image_size=16,
+    width=32,
+    depth=1,
+    heads=2,
+    head_dim=16,
+    mlp=64,
+    expert_width=32,
+    expert_mlp=64,
+    vit_width=24,
+    vit_depth=1,
+    vit_heads=3,
+)
+
+
+def fake_problem():
+    torch.manual_seed(123)
+    model = MicroVLA(model_config(horizon=4, **TINY))
+    images = torch.randint(0, 256, (4, 3, 3, 16, 16)).float()
+    state = torch.rand(4, 19) * 2 - 1
+    actions = torch.rand(4, 4, 10) * 2 - 1
+    noise = torch.randn_like(actions)
+    t = torch.tensor([0.2, 0.4, 0.6, 0.8])
+    return model, (images, state, instruction_tokens(4, "cpu"), actions), noise, t
+
+
+def overfit_curves():
+    initial, args, noise, t = fake_problem()
+    curves = {}
+    # Matched LR is an explicit control. The candidate LR is conservative (2x
+    # v1); this numerical check does not claim a fair-budget algorithm win.
+    for name, lr in (("adamw", 3e-4), ("muon", 3e-4), ("muon", 6e-4)):
+        model = copy.deepcopy(initial)
+        optimizer = build_optimizer(model, optimizer=name, lr=lr)
+        curve = []
+        for step in range(31):
+            optimizer.zero_grad(set_to_none=True)
+            total, n = flow_loss_terms(
+                model, *args, torch.ones_like(args[-1], dtype=torch.bool), noise=noise, t=t
+            )
+            loss = total / n
+            curve.append(float(loss.detach()))
+            if step == 30:
+                break
+            loss.backward()
+            nn.utils.clip_grad_norm_(model.parameters(), 1.0)
+            optimizer.step()
+        curves[f"{name}_{lr:g}"] = curve
+    return curves
+
+
+class MemoryDataset(torch.utils.data.Dataset):
+    def __init__(self):
+        generator = torch.Generator().manual_seed(71)
+        self.batch = dict(
+            rgb=torch.randint(0, 256, (4, 3, 3, 16, 16), dtype=torch.uint8, generator=generator),
+            proprio=torch.randn(4, 19, generator=generator),
+            target=torch.rand(4, 4, 10, generator=generator) * 2 - 1,
+            label_mask=torch.ones(4, 4, 10, dtype=torch.bool),
+            pad_mask=torch.zeros(4, 4, dtype=torch.bool),
+        )
+
+    def __len__(self):
+        return 4
+
+    def __getitem__(self, index):
+        return {k: v[index] for k, v in self.batch.items()}
+
+    def sample_weights(self, weights):
+        return torch.full((4,), 0.25, dtype=torch.double)
+
+
+class MemoryStore:
+    """EpisodeStore interface in RAM; no synthetic image cache is created."""
+
+    digest = "synthetic-in-memory"
+    image_path = "in-memory"
+    stats = {}
+    files = ("fake-train", "fake-val")
+    train_ids, val_ids = (0,), (1,)
+
+    def dataset(self, split, horizon):
+        assert horizon == 4
+        return MemoryDataset()
+
+
+class FakeTeacher(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.dummy = nn.Parameter(torch.ones(1), requires_grad=False)
+        self.config = SimpleNamespace(hidden_size=12)
+
+    def forward(self, pixel_values, **kwargs):
+        patches = F.avg_pool2d(pixel_values, 16).flatten(2).transpose(1, 2)
+        return SimpleNamespace(last_hidden_state=patches.repeat(1, 1, 4))
+
+
+class MuonTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        torch.set_num_threads(2)
+
+    def assert_tree_equal(self, a, b):
+        if isinstance(a, torch.Tensor):
+            torch.testing.assert_close(a, b, rtol=0, atol=0)
+        elif isinstance(a, dict):
+            self.assertEqual(a.keys(), b.keys())
+            for key in a:
+                self.assert_tree_equal(a[key], b[key])
+        elif isinstance(a, (tuple, list)):
+            self.assertEqual(len(a), len(b))
+            for left, right in zip(a, b, strict=True):
+                self.assert_tree_equal(left, right)
+        else:
+            self.assertEqual(a, b)
+
+    def test_singular_values_and_cpu_dtype(self):
+        measurements = []
+        for shape in ((8, 8), (16, 16), (32, 32), (8, 32), (32, 8)):
+            torch.manual_seed(42)
+            matrix = torch.randn(shape)
+            original = matrix.clone()
+            with torch.autocast("cpu", dtype=torch.bfloat16):
+                result = newton_schulz(matrix)
+            self.assertEqual(result.dtype, torch.float32)
+            self.assertTrue(torch.equal(matrix, original))
+            singular = torch.linalg.svdvals(result)
+            self.assertGreater(float(singular.min()), 0.6)
+            self.assertLess(float(singular.max()), 1.2)
+            measurements.append([shape, float(singular.min()), float(singular.max())])
+        self.assertTrue(torch.equal(newton_schulz(torch.zeros(4, 8)), torch.zeros(4, 8)))
+        # Five iterations cannot promise a lower bound for rank-deficient input.
+        self.assertLess(float(torch.linalg.svdvals(newton_schulz(torch.ones(4, 8)))[-1]), 1e-6)
+        print("NS_SINGULAR_VALUES=" + json.dumps(measurements))
+
+    def test_rms_matching(self):
+        measurements = []
+        for shape in ((8, 8), (8, 32), (32, 8)):
+            torch.manual_seed(42)
+            grad = torch.randn(shape)
+            p = nn.Parameter(torch.zeros(shape))
+            optimizer = torch.optim.AdamW([p], lr=1.0, weight_decay=0)
+            p.grad = grad.clone()
+            optimizer.step()
+            # Actual first AdamW step / lr: bias-corrected m/sqrt(v) ~= sign(g).
+            # Exclude decay, measure entrywise RMS, and compare the Muon direction.
+            adam_rms = float(p.detach().square().mean().sqrt())
+            rms = float(muon_update(grad).square().mean().sqrt())
+            self.assertAlmostEqual(rms / adam_rms, 0.2, delta=0.04)
+            measurements.append(dict(shape=shape, muon_rms=rms, adamw_rms=adam_rms))
+        print("UPDATE_RMS=" + json.dumps(measurements))
+
+    def test_fused_projection_split(self):
+        torch.manual_seed(5)
+        for splits in ((16, 16, 16), (32, 16, 16)):
+            matrix = torch.randn(sum(splits), 16)
+            actual = muon_update(matrix, split_sizes=splits)
+            expected = torch.cat([muon_update(p) for p in matrix.split(splits)])
+            torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+            self.assertGreater(float((actual - muon_update(matrix)).abs().max()), 0.01)
+
+    def test_complete_exclusive_groups_and_exclusions(self):
+        model = MicroVLA(model_config(horizon=4, **TINY))
+        for head in (None, nn.Linear(32, 12)):
+            groups = hybrid_groups(model, distill_head=head)
+            actual = Counter(id(p) for g in groups for p in g["params"])
+            expected = (
+                [*model.vision.parameters(), *head.parameters()]
+                if head is not None
+                else list(model.parameters())
+            )
+            self.assertEqual(actual, Counter(id(p) for p in expected))
+            self.assertTrue(all(n == 1 for n in actual.values()))
+            muon_ids = {id(p) for g in groups if g["use_muon"] for p in g["params"]}
+            self.assertEqual(len(muon_ids), 4 if head is not None else 12)
+            for name, p in model.named_parameters():
+                if id(p) in muon_ids:
+                    self.assertEqual(p.ndim, 2)
+                    self.assertTrue(name.endswith("weight"))
+                    self.assertNotIn("modulation", name)
+                if any(s in name for s in ("modulation", "norm", "position", "embedding")):
+                    self.assertNotIn(id(p), muon_ids)
+                if name.startswith(("tokens.", "action_in.", "action_out.", "time_mlp.")):
+                    self.assertNotIn(id(p), muon_ids)
+            self.assertNotIn(id(model.vision.project.weight), muon_ids)
+            if head is not None:
+                self.assertNotIn(id(head.weight), muon_ids)
+
+    def test_nesterov_decay_and_serialized_momentum(self):
+        torch.manual_seed(7)
+        p = nn.Parameter(torch.randn(8, 16))
+        initial, reference = p.detach().clone(), p.detach().clone()
+        optimizer = HybridMuon([dict(params=[p], use_muon=True)], lr=0.01, weight_decay=0.1)
+        buffer = torch.zeros_like(p)
+        for _ in range(2):
+            grad = torch.randn_like(p)
+            p.grad = grad.clone()
+            buffer = 0.95 * buffer + 0.05 * grad
+            reference = reference * 0.999 - 0.01 * muon_update(0.05 * grad + 0.95 * buffer)
+            optimizer.step()
+            torch.testing.assert_close(p, reference)
+            self.assertTrue(torch.equal(p.grad, grad))
+        self.assertFalse(torch.equal(initial, p))
+        stream = io.BytesIO()
+        torch.save(optimizer.state_dict(), stream)
+        stream.seek(0)
+        clone = nn.Parameter(p.detach().clone())
+        resumed = HybridMuon([dict(params=[clone], use_muon=True)], lr=0.01, weight_decay=0.1)
+        resumed.load_state_dict(torch.load(stream, weights_only=False))
+        grad = torch.randn_like(p)
+        p.grad, clone.grad = grad.clone(), grad.clone()
+        optimizer.step()
+        resumed.step()
+        self.assert_tree_equal(optimizer.state_dict(), resumed.state_dict())
+        self.assert_tree_equal(p, clone)
+        # None means no momentum/decay update; an explicit zero gradient decays.
+        before = clone.detach().clone()
+        clone.grad = None
+        resumed.step()
+        self.assert_tree_equal(clone, before)
+        zero = nn.Parameter(torch.ones(4, 8))
+        zero.grad = torch.zeros_like(zero)
+        decay = HybridMuon([dict(params=[zero], use_muon=True)], lr=0.01, weight_decay=0.1)
+        decay.step()
+        torch.testing.assert_close(zero, torch.full_like(zero, 0.999))
+
+    def test_schedules_and_legacy_resume(self):
+        model = MicroVLA(model_config(horizon=4, **TINY))
+        config = Config(optimizer="muon", muon_lr=9e-4, warmup_steps=2, steps=10, distill_steps=6)
+        optimizer = build_optimizer(model, optimizer="muon", muon_lr=config.muon_lr)
+        for phase, end in (("train", 10), ("distill", 6)):
+            for step, factor in ((0, 0.5), (1, 1), (2, 1), (end, 0)):
+                schedule_optimizer(optimizer, config, phase, step)
+                for group in optimizer.param_groups:
+                    base = 9e-4 if group["use_muon"] else 3e-4
+                    self.assertAlmostEqual(group["lr"], base * factor)
+        config = Config(device="cpu")
+        saved = asdict(config)
+        for key in ("optimizer", "muon_lr", "muon_momentum", "muon_ns_steps"):
+            saved.pop(key)
+        previous = dict(version="microvla-1", config=saved)
+        validate_resume_config(config, previous)
+        with self.assertRaisesRegex(ValueError, "optimizer"):
+            validate_resume_config(replace(config, optimizer="muon"), previous)
+        legacy = build_optimizer(model)
+        direct = torch.optim.AdamW(model.parameters(), lr=config.lr, weight_decay=config.weight_decay)
+        self.assert_tree_equal(legacy.state_dict(), direct.state_dict())
+        schedule_optimizer(legacy, config, "distill", 0)
+        self.assertEqual(legacy.param_groups[0]["lr"], config.lr)
+
+    def test_invalid_config(self):
+        for settings in (
+            dict(optimizer="unknown"),
+            dict(muon_momentum=1),
+            dict(muon_momentum=float("nan")),
+            dict(muon_ns_steps=0),
+            dict(muon_ns_steps=1.5),
+            dict(optimizer="muon", muon_lr=-1),
+            dict(optimizer="muon", muon_lr=float("nan")),
+            dict(muon_lr=0.001),
+        ):
+            with self.subTest(settings=settings), self.assertRaises(ValueError):
+                validate_config(Config(device="cpu", **settings))
+
+    def test_30_step_fake_overfit(self):
+        curves = overfit_curves()
+        adam, muon = curves["adamw_0.0003"], curves["muon_0.0006"]
+        self.assertLess(muon[-1], 0.65 * muon[0])
+        self.assertLess(adam[-1], 0.8 * adam[0])
+        self.assertTrue(all(m <= a + 1e-6 for m, a in zip(muon, adam, strict=True)))
+        print("OVERFIT_CURVES=" + json.dumps(curves))
+
+    def test_train_phase_resume_and_optimizer_rejection(self):
+        with (
+            tempfile.TemporaryDirectory(prefix="microvla-muon-", dir="/tmp") as directory,
+            patch("method.vla.train.EpisodeStore", return_value=MemoryStore()) as store,
+            patch("method.vla.train.load_teacher", side_effect=lambda c, d: FakeTeacher().to(d)),
+            redirect_stdout(io.StringIO()),
+        ):
+            root = Path(directory)
+            for name in ("adamw", "muon"):
+                config = Config(
+                    optimizer=name,
+                    device="cpu",
+                    horizon=4,
