Building isolated old/new caches: 16 files, 5565 frames, 353399760 image bytes each
"""CPU checks for cache reuse, recovery, locking, pruning and worker reopening."""

import fcntl
import json
import os
import pickle
import tempfile
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
from unittest.mock import patch

import numpy as np
import torch
from torch.utils.data import DataLoader

from .cache_tool import cache_usage, config_references, prune_cache
from .dataset import EpisodeStore, build_cache, episode_cache_key, episode_files
from .smoke_test import check_dataset, fake_data
from .train import Config, read_config


def snapshot(directory):
    return {
        p.name: (p.stat().st_size, p.stat().st_mtime_ns, p.stat().st_ino)
        for p in directory.iterdir()
        if p.suffix in (".u8", ".npz")
    }


def main():
    torch.set_num_threads(2)
    with tempfile.TemporaryDirectory(prefix="bc-cache-smoke-") as temporary:
        root = Path(temporary)
        dirs, episodes = fake_data(root)
        cache = root / "cache"
        configs = []
        for name, sources in (("a", dirs[:2]), ("b", dirs[1:])):
            config = root / (name + ".json")
            config.write_text(
                json.dumps({"data_dirs": sources, "cache_dir": str(cache), "val_episodes": 1})
            )
            configs.append(config)
        def from_config(path):
            values = read_config(path)
            return EpisodeStore(values["data_dirs"], values["cache_dir"], values["val_episodes"])

        first = from_config(configs[0])
        before = snapshot(cache)
        second = from_config(configs[1])
        after = snapshot(cache)
        assert all(after[name] == value for name, value in before.items())
        assert len(before) == 12 and len(after) == 18
        shared = set(first.image_paths) & set(second.image_paths)
        assert len(shared) == 3
        shared_bytes = sum(
            before[p.name][0] + before[p.with_suffix(".npz").name][0] for p in shared
        )
        print(
            f"Two overlapping configs: 3 shared entries, {shared_bytes} bytes reused; "
            "0 shared bytes rewritten; only 3 new entries"
        )
        before = snapshot(cache)
        from_config(configs[1])
        assert snapshot(cache) == before
        check_dataset(root, dirs, episodes)
        # Sidecar removal returns to the old key; old entry stays present.
        assert snapshot(cache).keys() >= before.keys()
        dataset = second.dataset("train", 20)
        expected = dataset[0]
        assert dataset.images and not pickle.loads(pickle.dumps(dataset)).images
        for context in ("fork", "spawn"):
            loader = DataLoader(
                dataset, batch_size=1, num_workers=2, multiprocessing_context=context
            )
            batch = next(iter(loader))
            for name, value in expected.items():
                np.testing.assert_array_equal(batch[name][0].numpy(), value)
        references, _ = config_references(configs)
        usage = cache_usage(cache, references)
        assert usage["entries"] == 10 and usage["complete_entries"] == 10
        assert all(v["referenced_entries"] == 6 for v in usage["references"].values())
        keep = set().union(*references.values())
        # Never prune old 24-character monolithic caches or temporary files.
        legacy = cache / ("a" * 24 + ".u8")
        legacy.write_bytes(b"legacy")
        before = snapshot(cache)
        dry = prune_cache(cache, keep)
        assert dry["dry_run"] and dry["entries"] == 1 and snapshot(cache) == before
        orphan = dry["keys"][0]
        with (cache / (orphan + ".lock")).open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            busy = prune_cache(cache, keep, apply=True)
            assert busy["busy_keys"] == [orphan] and busy["entries"] == 0
        assert prune_cache(cache, keep, apply=True)["entries"] == 1
        assert legacy.exists() and (cache / (orphan + ".lock")).exists()
        # Bad config fails closed before any pruning can start.
        bad = root / "bad.json"
        bad.write_text(json.dumps({"data_dirs": [str(root / "missing")]}))
        try:
            config_references([configs[0], bad])
        except ValueError:
            pass
        else:
            raise AssertionError("Missing source accepted")
        path = episode_files(dirs)[0]
        key = episode_cache_key(path)
        image, index = cache / (key + ".u8"), cache / (key + ".npz")
        original = image.read_bytes()
        # Recovery from truncated image and corrupt/missing index.
        image.write_bytes(b"short")
        build_cache(path, cache)
        assert image.read_bytes() == original
        index.write_bytes(b"bad archive")
        build_cache(path, cache)
        assert image.read_bytes() == original
        index.unlink()
        before_names = {p.name for p in cache.iterdir()}
        with patch("method.bc.dataset.np.savez", side_effect=OSError("simulated disk full")):
            try:
                build_cache(path, cache)
            except OSError:
                pass
            else:
                raise AssertionError("Injected write failure ignored")
        assert {p.name for p in cache.iterdir()} == before_names
        assert image.read_bytes() == original and not index.exists()
        # Concurrent constructors publish a single consistent pair.
        with ThreadPoolExecutor(max_workers=4) as pool:
            entries = list(pool.map(lambda _: build_cache(path, cache), range(4)))
        assert len({entry[2] for entry in entries}) == 1 and index.exists()
        before = snapshot(cache)
        build_cache(path, cache)
        assert snapshot(cache) == before
        # Metadata changes invalidate only the affected episode.
        keys = [episode_cache_key(p) for p in episode_files(dirs)]
        stat = path.stat()
        os.utime(path, ns=(stat.st_atime_ns, stat.st_mtime_ns + 1))
        new_keys = [episode_cache_key(p) for p in episode_files(dirs)]
        assert sum(a != b for a, b in zip(keys, new_keys, strict=True)) == 1
        assert Config.cache_dir != str(cache)
    print(
        "Cache smoke passed: reuse, sidecars, masks, normalization, fork/spawn workers, "
        "dry-run/apply pruning, busy locks, legacy retention, corrupt/missing recovery, "
        "disk-full cleanup and concurrent builds. CPU wiring only."
    )


if __name__ == "__main__":
    main()
