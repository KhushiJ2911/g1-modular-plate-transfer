"""Inspect per-episode caches and prune unreferenced entries (dry run by default)."""

import argparse
import fcntl
import json
import re
from pathlib import Path

from .dataset import episode_cache_key, episode_files, load_cache_index
from .train import Config, read_config

ENTRY_KEY = re.compile(r"[0-9a-f]{64}")


def config_references(config_paths):
    """Fail before deleting anything if a config or any source cannot be read."""
    references, cache_dirs = {}, set()
    for path in config_paths:
        values = read_config(path)
        directories = values.get("data_dirs", Config.data_dirs)
        if not isinstance(directories, (list, tuple)) or not directories:
            raise ValueError(f"{path}: data_dirs must be a nonempty list")
        references[str(path)] = {episode_cache_key(p) for p in episode_files(directories)}
        cache_dirs.add(Path(values.get("cache_dir", Config.cache_dir)).resolve())
    return references, cache_dirs


def entry_keys(cache_dir):
    return {
        p.stem
        for p in Path(cache_dir).glob("*")
        if p.suffix in (".u8", ".npz") and ENTRY_KEY.fullmatch(p.stem) and p.is_file()
    }


def entry_size(cache_dir, key):
    return sum(
        p.stat().st_size
        for suffix in (".u8", ".npz")
        if (p := Path(cache_dir) / (key + suffix)).is_file()
    )


def cache_usage(cache_dir, references):
    cache_dir = Path(cache_dir)
    keys = entry_keys(cache_dir)
    sizes = {key: entry_size(cache_dir, key) for key in keys}
    total = sum(p.stat().st_size for p in cache_dir.glob("*") if p.is_file())
    complete = {
        key
        for key in keys
        if load_cache_index(cache_dir / (key + ".u8"), cache_dir / (key + ".npz"), key) is not None
    }
    return {
        "cache_dir": str(cache_dir),
        "total_bytes": total,
        "total_gib": round(total / 2**30, 3),
        "entries": len(keys),
        "legacy_entries": len(
            {
                p.stem
                for p in cache_dir.glob("*")
                if p.suffix in (".u8", ".npz") and re.fullmatch(r"[0-9a-f]{24}", p.stem)
            }
        ),
        "complete_entries": len(complete),
        "incomplete_entries": len(keys - complete),
        "entry_bytes": sum(sizes.values()),
        "legacy_and_other_bytes": total - sum(sizes.values()),
        "references": {
            config: {
                "expected_entries": len(wanted),
                "referenced_entries": len(keys & wanted),
                "complete_referenced_entries": len(complete & wanted),
                "missing_entries": len(wanted - keys),
                "referenced_bytes": sum(sizes[key] for key in keys & wanted),
            }
            for config, wanted in references.items()
        },
    }


def prune_cache(cache_dir, keep_keys, apply=False):
    """Only full-length episode keys are eligible; legacy caches/locks stay put.

    Lock files must never be unlinked: waiting builders may hold the same inode.
    Stop jobs using entries to be pruned; their lazy workers may need to open them.
    """
    cache_dir = Path(cache_dir)
    removed, busy, total = [], [], 0
    for key in sorted(entry_keys(cache_dir) - keep_keys):
        if not apply:
            removed.append(key)
            total += entry_size(cache_dir, key)
            continue
        with (cache_dir / (key + ".lock")).open("a") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                busy.append(key)
                continue
            total += entry_size(cache_dir, key)
            # Remove the commit marker first, under the same lock as the builder.
            for suffix in (".npz", ".u8"):
                (cache_dir / (key + suffix)).unlink(missing_ok=True)
            removed.append(key)
    return {
        "cache_dir": str(cache_dir),
        "dry_run": not apply,
        "entries": len(removed),
        "bytes": total,
        "keys": removed,
        "busy_keys": busy,
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    du = subparsers.add_parser("du", help="Report bytes, entries and config references as JSON")
    du.add_argument("--config", type=Path, nargs="+", default=[])
    prune = subparsers.add_parser(
        "prune", help="List unreferenced episode entries; preserve legacy"
    )
    prune.add_argument("--keep-config", type=Path, nargs="+", required=True)
    prune.add_argument(
        "--apply", action="store_true", help="Actually delete listed episode entries"
    )
    for command in (du, prune):
        command.add_argument(
            "--cache-dir", type=Path, help="Override cache directories from configs"
        )
    args = parser.parse_args()
    configs = args.config if args.command == "du" else args.keep_config
    references, cache_dirs = config_references(configs)
    if args.cache_dir:
        cache_dirs = {args.cache_dir.resolve()}
    if not cache_dirs:
        cache_dirs = {Path(Config.cache_dir).resolve()}
    keep = set().union(*references.values())
    reports = [
        cache_usage(directory, references)
        if args.command == "du"
        else prune_cache(directory, keep, args.apply)
        for directory in sorted(cache_dirs)
    ]
    print(json.dumps(reports, indent=2))


if __name__ == "__main__":
    main()
