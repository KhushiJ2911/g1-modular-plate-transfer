\"\"\"CPU loader comparison against a saved pre-change dataset.py on identical files.\"\"\"

import argparse
import importlib.util
import json
import statistics
import sys
import tempfile
import time
from pathlib import Path
from unittest.mock import patch

import numpy as np
import torch
from torch.utils.data import DataLoader

from . import dataset as current
from .train import StepBatches


def measure(store, args, trial):
    dataset = store.dataset(\"train\", args.horizon)
    loader = DataLoader(
        dataset,
        batch_sampler=StepBatches(
            dataset.sample_weights(), args.batch_size, 0, args.warmup + args.batches, 42
        ),
        num_workers=args.num_workers,
        pin_memory=False,
        generator=torch.Generator().manual_seed(42),
    )
    iterator = iter(loader)
    for _ in range(args.warmup):
        next(iterator)
    started = time.perf_counter()
    for _ in range(args.batches):
        next(iterator)
    elapsed = time.perf_counter() - started
    return {\"trial\": trial, \"batches\": args.batches, \"seconds\": elapsed,
            \"it_per_second\": args.batches / elapsed}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(\"--old-dataset\", type=Path, required=True)
    parser.add_argument(\"--data-dirs\", nargs=\"+\", required=True)
    parser.add_argument(\"--episodes-per-dir\", type=int, default=8)
    parser.add_argument(\"--max-cache-mib\", type=int, default=2048)
    parser.add_argument(\"--work-dir\", type=Path, default=Path('/tmp'))
    parser.add_argument(\"--batch-size\", type=int, default=64)
    parser.add_argument(\"--num-workers\", type=int, default=2)
    parser.add_argument(\"--horizon\", type=int, default=20)
    parser.add_argument(\"--warmup\", type=int, default=50)
    parser.add_argument(\"--batches\", type=int, default=300)
    parser.add_argument(\"--trials\", type=int, default=3)
    args = parser.parse_args()
    if args.episodes_per_dir < 2 or min(args.batches, args.trials, args.batch_size) < 1:
        parser.error(\"Need >=2 episodes/directory and positive batches/trials/batch size\")
    torch.set_num_threads(2)
    spec = importlib.util.spec_from_file_location(\"method.bc.cache_benchmark_old\", args.old_dataset)
    old = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = old
    spec.loader.exec_module(old)
    files = [p for directory in args.data_dirs
             for p in current.episode_files([directory])[:args.episodes_per_dir]]
    counts = []
    for path in files:
        with np.load(path, allow_pickle=False) as episode:
            counts.append((len(episode['action']) + 1) // 2)
    image_bytes = sum(counts) * current.FRAME_BYTES
    if 2 * image_bytes > args.max_cache_mib * 2**20:
        parser.error(f\"Two image caches need {2 * image_bytes} bytes; reduce episodes-per-dir\")
    print(f\"Building isolated old/new caches: {len(files)} files, \"
          f\"{sum(counts)} frames, {image_bytes} image bytes each\", flush=True)
    with tempfile.TemporaryDirectory(prefix=\"bc-cache-benchmark-\", dir=args.work_dir) as temporary:
        stores = {}
        for name, module in ((\"old\", old), (\"new\", current)):
            with patch.object(module, \"episode_files\", return_value=files):
                stores[name] = module.EpisodeStore(args.data_dirs, Path(temporary) / name,
                                                   val_episodes=1)
        a, b = stores['old'], stores['new']
        assert a.digest == b.digest
        for name in ('state', 'action', 'label_mask', 'steps', 'frames', 'aux_target', 'aux_mask'):
            np.testing.assert_array_equal(getattr(a, name), getattr(b, name))
        for name in a.stats:
            np.testing.assert_array_equal(a.stats[name], b.stats[name])
        for split in ('train', 'val'):
            left, right = a.dataset(split, args.horizon), b.dataset(split, args.horizon)
            for row in np.linspace(0, len(left) - 1, 64, dtype=int):
                x, y = left[row], right[row]
                for name in x:
                    np.testing.assert_array_equal(x[name], y[name])
        measurements = {name: [] for name in stores}
        for trial in range(args.trials):
            for name in (('old', 'new') if trial % 2 == 0 else ('new', 'old')):
                result = measure(stores[name], args, trial + 1)
                measurements[name].append(result)
                print(f\"{name}: {result['it_per_second']:.2f} it/s\", flush=True)
        result = {
            \"files\": [str(p) for p in files], \"episodes\": len(files),
            \"frames\": sum(counts), \"image_bytes_per_format\": image_bytes,
            \"batch_size\": args.batch_size, \"num_workers\": args.num_workers,
            \"horizon\": args.horizon, \"warmup_batches\": args.warmup,
            \"timed_batches_per_trial\": args.batches, \"pin_memory\": False,
            \"device\": \"cpu\", \"measurements\": measurements,
            \"median_it_per_second\": {
                name: statistics.median(row['it_per_second'] for row in rows)
                for name, rows in measurements.items()
            },
        }
        print(json.dumps(result, indent=2))


if __name__ == '__main__':
    main()
