    ]


def episode_cache_key(path):
    return hashlib.sha256(json.dumps([CACHE_VERSION, episode_signature(path)]).encode()).hexdigest()


def load_cache_index(image_path, index_path, key):
    """A readable, shape-valid index commits an exact-size image file."""
    try:
        with np.load(index_path, allow_pickle=False) as index:
            data = {name: index[name] for name in index.files}
        if int(data["cache_version"]) != CACHE_VERSION or str(data["key"]) != key:
            return None
        length, frames = int(data["lengths"][0]), int(data["frame_counts"][0])
        if length < 1 or frames != (length + 1) // 2:
            return None
        if image_path.stat().st_size != frames * FRAME_BYTES:
            return None
        shapes = {"state": (length, 50), "action": (length, 20), "label_mask": (length, 20)}
        for name, (suffix, constant) in PRIV_LABELS.items():
            shapes[name] = suffix if constant else (length, *suffix)
            shapes[name + "_available"] = ()
        if any(data[name].shape != shape for name, shape in shapes.items()):
            return None
        if data["label_mask"].dtype != np.bool_:
            return None
        return data
    except (OSError, ValueError, KeyError, IndexError, EOFError, zipfile.BadZipFile):
        return None


def build_cache(path, cache_dir):
    """Publish one episode under its own lock, with the index committed last."""
    path = Path(path).resolve()
    key = episode_cache_key(path)
    cache_dir = Path(cache_dir)
    cache_dir.mkdir(parents=True, exist_ok=True)
    image_path, index_path = (cache_dir / f"{key}{suffix}" for suffix in (".u8", ".npz"))
    with (cache_dir / f"{key}.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        cached = load_cache_index(image_path, index_path, key)
        if cached is not None:
            return image_path, cached, key
        with np.load(path, allow_pickle=False) as episode:
            # Supervision uses clean actions, never executed controller corrections.
            action = np.asarray(episode["action"], dtype=np.float32)
            state = np.asarray(episode["state"], dtype=np.float32)
            rgb = episode["rgb"]
            length = len(action)
            if int(episode["rgb_stride"]) != 2:
                raise ValueError(f"{path}: expected rgb_stride=2")
            if length < 1 or action.shape != (length, 20):
                raise ValueError(f"{path}: invalid action shape")
            label_mask = (
                episode["label_mask"]
                if "label_mask" in episode
                else np.ones((length, 20), dtype=bool)
            )
            if label_mask.shape != (length, 20) or label_mask.dtype != np.bool_:
                raise ValueError(f"{path}: label_mask must be bool (T,20)")
            if state.shape != (length, 50):
                raise ValueError(f"{path}: state must have exactly T rows")
            if rgb.dtype != np.uint8 or rgb.shape != ((length + 1) // 2, *FRAME_SHAPE):
                raise ValueError(f"{path}: invalid RGB dtype/shape")
            if not np.isfinite(state).all() or not np.isfinite(action).all():
                raise ValueError(f"{path}: nonfinite state/action")
            if np.abs(action).max() > 1.00001:
                raise ValueError(f"{path}: actions must be normalized")
            labels, presence = read_priv(path, episode, length)
        cached = dict(
            cache_version=np.asarray(CACHE_VERSION),
            key=np.asarray(key),
            files=np.asarray([str(path)]),
            state=state,
            action=action,
            label_mask=label_mask,
            lengths=np.asarray([length]),
            frame_counts=np.asarray([len(rgb)]),
            **labels,
            **{name + "_available": np.asarray(value) for name, value in presence.items()},
        )
        # Stage BOTH files before replacing either, including on disk-full failures.
        with ExitStack() as stack:
            streams = []
            for _ in range(2):
                stream = stack.enter_context(tempfile.NamedTemporaryFile(dir=cache_dir, delete=False))
                stack.callback(Path(stream.name).unlink, missing_ok=True)
                streams.append(stream)
            rgb.tofile(streams[0])
            np.savez(streams[1], **cached)
            for stream in streams:
                stream.flush()
                os.fsync(stream.fileno())
            if episode_cache_key(path) != key:
                raise RuntimeError(f"{path}: episode/sidecar changed during cache construction")
            index_path.unlink(missing_ok=True)
            os.replace(streams[0].name, image_path)
            os.replace(streams[1].name, index_path)
            directory_fd = os.open(cache_dir, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
    return image_path, cached, key


class EpisodeStore:
    def __init__(self, directories, cache_dir, val_episodes=6, proprio_dims=PROPRIO_DIMS):
        files = episode_files(directories)
        self.proprio_dims = validate_proprio_dims(proprio_dims)
        self.directory_ids = np.asarray(
            [
                next(i for i, d in enumerate(directories) if p.parent == Path(d).resolve())
                for p in files
            ]
        )
        self.val_ids = []
        for directory_id, directory in enumerate(directories):
            ids = np.flatnonzero(self.directory_ids == directory_id)
            if not 1 <= val_episodes < len(ids):
                raise ValueError(
                    f"{directory}: need more than val_episodes={val_episodes} episodes"
                )
            self.val_ids.extend(ids[np.linspace(0, len(ids) - 1, val_episodes, dtype=int)].tolist())
        self.train_ids = [i for i in range(len(files)) if i not in self.val_ids]
        entries = [build_cache(path, cache_dir) for path in files]
        self.image_paths = [entry[0] for entry in entries]
        self.cache_keys = [entry[2] for entry in entries]
        indices = [entry[1] for entry in entries]
        self.state, self.action, self.label_mask = (
            np.concatenate([index[name] for index in indices])
            for name in ("state", "action", "label_mask")
        )
        self.steps = np.r_[0, np.cumsum([index["lengths"][0] for index in indices])]
        self.frames = np.r_[0, np.cumsum([index["frame_counts"][0] for index in indices])]
        self.priv = {
            name: (np.stack if constant else np.concatenate)([index[name] for index in indices])
            for name, (_, constant) in PRIV_LABELS.items()
        }
        self.priv_available = {
            name: np.asarray([index[name + "_available"] for index in indices])
            for name in PRIV_LABELS
        }
        # Keep checkpoint data identity independent of the physical cache layout.
        signature = [item for path in files for item in episode_signature(path)]
        self.digest = hashlib.sha256(json.dumps([3, signature]).encode()).hexdigest()[:24]
        self.files = [str(p) for p in files]
        row_episodes = np.repeat(np.arange(len(files)), np.diff(self.steps))
        targets, masks = [], []
        for key in AUX_LABELS:
            values = self.priv[key]
            if PRIV_LABELS[key][1]:
                values = values[row_episodes]
            values = values.reshape(len(self.state), -1)
            targets.append(values)
            masks.append(
                np.broadcast_to(self.priv_available[key][row_episodes, None], values.shape)
            )
        self.aux_target = np.concatenate(targets, axis=1)
        self.aux_mask = np.concatenate(masks, axis=1).copy()
        train_rows = np.concatenate(
            [np.arange(self.steps[i], self.steps[i + 1]) for i in self.train_ids]
        )
        proprio = self.state[train_rows][:, self.proprio_dims].astype(np.float64)
        aux_mean, aux_std = np.zeros(9, np.float32), np.ones(9, np.float32)
        for dim in range(8):
            rows = train_rows[self.aux_mask[train_rows, dim]]
            if len(rows):
                values = self.aux_target[rows, dim].astype(np.float64)
                aux_mean[dim], aux_std[dim] = values.mean(), max(values.std(), 1e-3)
        # Inactive policy defaults must not learn from untrusted student actions.
        action_mask = self.label_mask[train_rows]
        action_mean = (
            (self.action[train_rows].astype(np.float64) * action_mask).sum(0)
            / np.maximum(action_mask.sum(0), 1)
        ).astype(np.float32)

