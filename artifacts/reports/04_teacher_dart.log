+"""Three real action steps per path; no task success or episode artifact claimed."""
+import numpy as np
+
+from advaitic_eval.environment import make_environment
+from method.teacher.dart import DartNoise
+from method.teacher.labels import PrivilegedLabels
+from method.teacher.teacher import Teacher
+
+with np.load('/home/keyu/advaitic/data/human60/ep_0.npz') as data:
+    states, actions, seed = data['state'], data['action'], int(data['seed'])
+env = make_environment()
+try:
+    print('Human reset / three-step alignment smoke', flush=True)
+    ts = env.reset(seed=seed)
+    labels = PrivilegedLabels(env)
+    maximum = 0.0
+    for t in range(3):
+        deviation = float(np.max(np.abs(ts.low_dim_obs - states[t])))
+        maximum = max(maximum, deviation)
+        assert deviation <= 0.05
+        labels.append(ts.low_dim_obs)
+        ts = env.step(actions[t])
+        print(f'human step={t} deviation={deviation:.9g}', flush=True)
+    print({key: (value.shape, str(value.dtype)) for key, value in labels.arrays().items()}, flush=True)
+    print(f'human three-step max_deviation={maximum:.9g}', flush=True)
+    print('Teacher reset / three-step DART smoke', flush=True)
+    ts = env.reset(seed=seed)
+    teacher = Teacher()
+    teacher.reset(env)
+    noise = DartNoise(seed, 1)
+    labels = PrivilegedLabels(env)
+    for t in range(3):
+        labels.append(ts.low_dim_obs, teacher.current_snapshot)
+        clock = teacher.demo_step
+        clean = teacher.act(ts)
+        executed = noise.execute(clean, teacher, clock)
+        assert np.isfinite(executed).all() and np.max(np.abs(executed)) <= 1
+        np.testing.assert_array_equal(clean[[2, 3, *range(11, 20)]], executed[[2, 3, *range(11, 20)]])
+        ts = env.step(executed)
+        teacher.observe()
+        print(f'teacher step={t} max_action_perturbation={np.max(np.abs(executed-clean)):.9g}', flush=True)
+    assert all(len(value) == 3 for key, value in labels.arrays().items() if key not in labels.offsets)
+    print('Completed six real steps; no episode completed or success claimed.', flush=True)
+finally:
+    env.close()
