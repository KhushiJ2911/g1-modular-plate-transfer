"""Episode-local action drift, applied outside the clean teacher controller."""

from __future__ import annotations

import numpy as np

THETA = 0.15
GUARD_STEPS = 15


def validate_scale(scale: float) -> float:
    scale = float(scale)
    if not np.isfinite(scale) or scale < 0:
        raise ValueError("dart_noise must be finite and nonnegative")
    return scale


class DartNoise:
    """Discrete OU drift with the requested stationary marginal standard deviation.

    x[t+1] = (1-theta)*x[t] + std*sqrt(theta*(2-theta))*N(0,1).
    Start at zero; advance on every physical step, including protected steps.
    Guards mask the applied drift without modifying the teacher's clean action.
    """

    def __init__(self, seed: int, scale: float):
        self.scale = validate_scale(scale)
        self.rng = np.random.default_rng(seed + 10_000_019)
        self.value = np.zeros(20)
        self.std = np.zeros(20)
        self.std[:2] = 0.10 * self.scale
        self.std[4:11] = 0.02 * self.scale
        self.previous_closed = np.zeros(2, dtype=bool)
        self.last_transition = None
        self.transitions = None
        self.step = 0

    def execute(self, clean, teacher, demo_step: int) -> np.ndarray:
        """Call after teacher.act, with its demo clock from BEFORE that call."""
        closed = clean[18:20] > 0
        if np.any(closed != self.previous_closed):
            self.last_transition = self.step
        self.previous_closed = closed.copy()
        if self.transitions is None:
            reference = teacher.actions[teacher.chosen_demo]
            self.transitions = (
                np.flatnonzero(
                    np.any((reference[1:, 18:20] > 0) != (reference[:-1, 18:20] > 0), axis=1)
                )
                + 1
            )
            # A reference starting closed transitions on its first command.
            if np.any(reference[0, 18:20] > 0):
                self.transitions = np.r_[0, self.transitions]
            # The controller opens both fingers at the end even if a reference
            # were to finish closed. Guard that possible synthetic transition.
            if np.any(reference[-1, 18:20] > 0):
                self.transitions = np.r_[self.transitions, len(reference)]
        before_transition = np.any(
            (self.transitions >= demo_step) & (self.transitions - demo_step <= GUARD_STEPS)
        )
        after_transition = (
            self.last_transition is not None and self.step - self.last_transition <= GUARD_STEPS
        )
        retreat = teacher.config["mode"] == "v2" and teacher.release_physical_step is not None
        self.step += 1
        if self.scale == 0:
            return clean.copy()
        self.value = (1 - THETA) * self.value + (
            self.std * np.sqrt(THETA * (2 - THETA)) * self.rng.standard_normal(20)
        )
        if before_transition or after_transition or retreat:
            return clean.copy()
        return np.clip(clean + self.value, -1, 1).astype(np.float32)
"""Shared, read-only privileged training labels for teacher and human rollouts."""

from __future__ import annotations

import os
import tempfile
from pathlib import Path

import numpy as np

from method.teacher.diagnostics import PrivilegedSensors

# Nominal MovePlateG1 rack origins in the pinned upstream move_plates.py.
START_RACK_XY = np.array([0.55, 0.24])
TARGET_RACK_XY = np.array([0.55, -0.24])
STEP_KEYS = (
    "priv_plate_pos",
    "priv_plate_rel",
    "priv_target_site_rel",
    "priv_plate_tilt_deg",
    "priv_held",
)


def pelvis_relative(world_xyz, state) -> np.ndarray:
    """Translate by observed pelvis xyz, then rotate xy by negative pelvis yaw."""
    offset = np.asarray(world_xyz, dtype=float) - state[18:21]
    c, s = np.cos(state[21]), np.sin(state[21])
    return np.array(
        [c * offset[0] + s * offset[1], -s * offset[0] + c * offset[1], offset[2]],
        dtype=np.float32,
    )


class PrivilegedLabels:
    def __init__(self, env):
        inner = env.inner_env
        self.sensors = PrivilegedSensors(inner)
        self.offsets = {
            "priv_start_rack_offset": np.asarray(
                np.asarray(inner.rack_start.get_position())[:2] - START_RACK_XY, dtype=np.float32
            ),
            "priv_target_rack_offset": np.asarray(
                np.asarray(inner.rack_target.get_position())[:2] - TARGET_RACK_XY, dtype=np.float32
            ),
        }
        if any(v.shape != (2,) or not np.isfinite(v).all() for v in self.offsets.values()):
            raise ValueError("Expected finite xy rack offsets")
        self.rows = {key: [] for key in STEP_KEYS}

    def append(self, state, snapshot=None):
        """Sample before env.step; snapshot may be the teacher's live pre-action read."""
        state = np.asarray(state, dtype=float)
        if state.shape != (50,) or not np.isfinite(state).all():
            raise ValueError("Expected finite (50,) observed state for labels")
        if snapshot is None:
            snapshot = self.sensors.snapshot(len(self.rows["priv_held"]))
        plate = np.asarray(snapshot["pose"][:3], dtype=np.float32)
        self.rows["priv_plate_pos"].append(plate)
        self.rows["priv_plate_rel"].append(pelvis_relative(plate, state))
        self.rows["priv_target_site_rel"].append(pelvis_relative(snapshot["site_xyz"], state))
        self.rows["priv_plate_tilt_deg"].append(snapshot["tilt_deg"])
        self.rows["priv_held"].append(snapshot["held"])

    def arrays(self) -> dict[str, np.ndarray]:
        result = dict(self.offsets)
        for key, rows in self.rows.items():
            array = np.asarray(rows, dtype=np.bool_ if key == "priv_held" else np.float32)
            if key in STEP_KEYS[:3]:
                array = array.reshape(-1, 3)
            if not np.isfinite(array).all():
                raise ValueError(f"Nonfinite privileged label: {key}")
            result[key] = array
        return result


def save_npz_atomic(destination: Path, **arrays) -> Path:
    """Publish a complete archive only after compression, flush and fsync."""
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="wb",
            dir=destination.parent,
            prefix=f".{destination.stem}_",
            suffix=".npz",
            delete=False,
        ) as stream:
            temporary = Path(stream.name)
            np.savez_compressed(stream, **arrays)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, destination)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
    return destination
"""Replay human actions to produce aligned privileged-label sidecars, CPU only."""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

os.environ["ORT_DISABLE_TELEMETRY"] = "1"
os.environ["CUDA_VISIBLE_DEVICES"] = ""

import numpy as np

if __package__ in (None, ""):
    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from method.teacher.labels import PrivilegedLabels, save_npz_atomic
from method.teacher.run_teacher import parse_seeds
from method.teacher.teacher import REPO_DIR

HUMAN_DIR = Path("/home/keyu/advaitic/data/human60")
ALIGNMENT_TOLERANCE = 0.05


def replay_labels(env, source: Path) -> tuple[dict, float]:
    """Return labels only for a fully aligned, successful real action replay."""
    with np.load(source, allow_pickle=False) as data:
        actions = np.asarray(data["action"], dtype=np.float32)
        states = np.asarray(data["state"], dtype=np.float32)
        seed = int(data["seed"])
    if actions.ndim != 2 or actions.shape[1] != 20 or not len(actions):
        raise ValueError("Expected nonempty (T,20) human actions")
    if states.shape != (len(actions), 50):
        raise ValueError("Expected human state rows aligned with (T,20) actions")
    if not np.isfinite(actions).all() or np.any(np.abs(actions) > 1):
        raise ValueError("Human actions must be finite and normalized to [-1,1]")
    if not np.isfinite(states).all() or not 0 <= seed <= 2**32 - 1:
        raise ValueError("Nonfinite human states or invalid seed")
    ts = env.reset(seed=seed)
    labels = PrivilegedLabels(env)
    max_deviation = 0.0
    for step, action in enumerate(actions):
        if ts.last():
            raise ValueError(
                f"Replay terminated early at step={step}/{len(actions)}; "
                f"max_deviation={max_deviation:.9g}"
            )
        observed = np.asarray(ts.low_dim_obs, dtype=np.float32)
        if observed.shape != (50,) or not np.isfinite(observed).all():
            raise AssertionError(f"Invalid replay state at step={step}")
        deviation = float(np.max(np.abs(observed - states[step])))
        max_deviation = max(max_deviation, deviation)
        if deviation > ALIGNMENT_TOLERANCE:
            raise AssertionError(
                f"State alignment failed at step={step}: "
                f"max_deviation={max_deviation:.9g} > {ALIGNMENT_TOLERANCE}"
            )
        # Use the observed replay pelvis, just as in the teacher runner.
        labels.append(observed)
        ts = env.step(action)
    if not ts.last() or not env.episode_succeeded() or env.episode_fell():
        raise ValueError(
            f"Replay did not terminate successfully after {len(actions)} actions; "
            f"termination={env.episode_termination()}; max_deviation={max_deviation:.9g}"
        )
    return {
        **labels.arrays(),
        "seed": np.int64(seed),
        "success": np.bool_(True),
        "max_state_deviation": np.float32(max_deviation),
    }, max_deviation


def run(args) -> int:
    indices = parse_seeds(args.indices)
    output = args.out_dir if args.out_dir is not None else args.demos_dir
    output.mkdir(parents=True, exist_ok=True)
    pending, skipped, flagged = [], 0, 0
    for index in indices:
        if index == 45:
            print("demo=45 FLAG known non-reproducing demo; no sidecar written", flush=True)
            continue
        destination = output / f"ep_{index}.priv.npz"
        if destination.exists():
            skipped += 1
            print(f"demo={index} SKIP existing={destination}", flush=True)
        else:
            pending.append((index, destination))
    written, max_deviation = 0, 0.0
    if pending:
        sys.path.insert(0, str(REPO_DIR / "src"))
        from advaitic_eval.environment import make_environment

        env = make_environment()
        try:
            for index, destination in pending:
                try:
                    arrays, deviation = replay_labels(env, args.demos_dir / f"ep_{index}.npz")
                    save_npz_atomic(destination, **arrays)
                except (AssertionError, ValueError, RuntimeError, OSError, KeyError) as exc:
                    flagged += 1
                    print(f"demo={index} FLAG {type(exc).__name__}: {exc}", flush=True)
                    continue
                written += 1
                max_deviation = max(max_deviation, deviation)
                print(
                    f"demo={index} OK steps={len(arrays['priv_held'])} "
                    f"max_deviation={deviation:.9g} sidecar={destination}",
                    flush=True,
                )
        finally:
            env.close()
    print(
        f"Human labels: written={written} skipped_existing={skipped} "
        f"known_excluded={int(45 in indices)} flagged={flagged} "
        f"max_deviation_written={max_deviation:.9g}",
        flush=True,
    )
    return 1 if flagged else 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--demos-dir", type=Path, default=HUMAN_DIR)
    parser.add_argument(
        "--indices", nargs="+", default=["0:60"], help="Demo indices, e.g. 0:60 (45 excluded)"
    )
    parser.add_argument(
        "--out-dir", type=Path, help="Sidecar directory (default: next to the human NPZs)"
    )
    args = parser.parse_args()
    try:
        return run(args)
    except KeyboardInterrupt:
        print("Interrupted; unfinished sidecar not published. Repeat to resume.", file=sys.stderr)
        return 130
    except (ValueError, RuntimeError, OSError) as exc:
        parser.exit(2, f"{type(exc).__name__}: {exc}\n")


if __name__ == "__main__":
    raise SystemExit(main())
        if stream.read(1) != "\n":
            stream.write("\n")
    stream.write(payload)
    stream.flush()
    os.fsync(stream.fileno())


def save_demo(
    directory: Path, seed: int, slot: int, rgb, states, actions, executed, dart_noise, labels
) -> Path:
    """Atomically publish successful pre-action observations and their actions."""
    return save_npz_atomic(
        directory / f"ep_{seed}.npz",
        rgb=np.asarray(rgb, dtype=np.uint8),
        state=np.asarray(states, dtype=np.float32),
        action=np.asarray(actions, dtype=np.float32),
        action_executed=np.asarray(executed, dtype=np.float32),
        dart_noise=np.float32(dart_noise),
        seed=np.int64(seed),
        slot=np.int64(slot),
        success=np.bool_(True),
        rgb_stride=np.int64(RGB_STRIDE),
        **labels.arrays(),
    )


def run_episode(
    env, teacher: Teacher, seed: int, save_directory: Path | None, *, trace=None, dart_noise=0.0
) -> dict:
    started = time.monotonic()
    noise = DartNoise(seed, dart_noise)
    ts = env.reset(seed=seed)
    from advaitic_eval.environment import observed_source_slot

    slot = observed_source_slot(env)
    teacher.reset(env)
    if trace is not None:
        trace(0, teacher, teacher.current_snapshot, False)
    labels = PrivilegedLabels(env) if save_directory is not None else None
    rgb, states, actions, executed = [], [], [], []
    steps = 0
    while not ts.last():
        if labels is not None:
            labels.append(ts.low_dim_obs, teacher.current_snapshot)
        demo_step = teacher.demo_step
        action = teacher.act(ts)
        if action.shape != (20,) or not np.isfinite(action).all() or np.any(np.abs(action) > 1):
            raise ValueError("Teacher returned an invalid normalized action")
        action_executed = noise.execute(action, teacher, demo_step)
        if save_directory is not None:
            states.append(np.asarray(ts.low_dim_obs, dtype=np.float32).copy())
            actions.append(action.copy())
            executed.append(action_executed.copy())
            if steps % RGB_STRIDE == 0:
                rgb.append(np.asarray(ts.rgb_obs, dtype=np.uint8).copy())
        ts = env.step(action_executed)
        steps += 1
        snapshot = teacher.observe()
        if trace is not None:
            trace(steps, teacher, snapshot, ts.last())
    fell = bool(env.episode_fell())
    success = bool(env.episode_succeeded() and not fell)
    record = {
        "seed": seed,
        "dart_noise": noise.scale,
        "slot": slot,
        "chosen_demo": teacher.chosen_demo,
        "grasp_shift": teacher.grasp_shift.tolist(),
        "place_shift": teacher.place_shift.tolist(),
        "success": success,
        "completed": True,
        "termination": env.episode_termination(),
        "fell": fell,
        "steps": steps,
        "max_pelvis_tracking_error": teacher.max_tracking_error,
        "wait_steps": dict(teacher.wait_steps),
        "demo_step": teacher.demo_step,
        "demo_file": None,
    }
    record.update(teacher.diagnostics(success=success, fell=fell))
    if success and save_directory is not None:
        record["demo_file"] = str(
            save_demo(
                save_directory, seed, slot, rgb, states, actions, executed, noise.scale, labels
            )
        )
    record["wall_time"] = time.monotonic() - started
    return record


def run(args) -> int:
    dart_noise = validate_scale(args.dart_noise)
    seeds = parse_seeds(args.seeds)
    teacher = Teacher(
        args.demos,
        args.meta,
        mode=args.mode,
        kp=args.kp,
        tolerance=args.tolerance,
        max_wait=args.max_wait,
    )
    # Prevent accidentally resuming a changed controller/data configuration.
    digest = hashlib.sha256()
    for path in (
        Path(__file__),
        Path(__file__).with_name("teacher.py"),
        Path(__file__).with_name("diagnostics.py"),
        Path(__file__).with_name("dart.py"),
        Path(__file__).with_name("labels.py"),
        args.demos,
        args.meta,
    ):
        digest.update(path.read_bytes())
    digest.update((REPO_DIR / "src/advaitic_eval/action_layout.json").read_bytes())
    digest.update(json.dumps(teacher.config, sort_keys=True).encode())
    digest.update(json.dumps({"dart_noise": dart_noise}, sort_keys=True).encode())
    run_id = digest.hexdigest()
    args.out.parent.mkdir(parents=True, exist_ok=True)
    if args.save_demos is not None:
        args.save_demos = args.save_demos.resolve()
        args.save_demos.mkdir(parents=True, exist_ok=True)
    with args.out.open("a+", encoding="utf-8") as stream:
        try:
            fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RuntimeError("Output JSONL is already in use; use one log per process") from exc
        records = read_records(stream)
        if any(row.get("run_id") != run_id for row in records.values()):
            raise ValueError("Controller/data configuration changed; choose a new --out JSONL")
        pending = [seed for seed in seeds if seed not in records]
        print(
            f"Requested {len(seeds)}; skipped {len(seeds) - len(pending)}; pending {len(pending)}"
        )
        if pending:
            # Import this worktree's evaluator, even with a sibling editable env.
            sys.path.insert(0, str(REPO_DIR / "src"))
            from advaitic_eval.environment import make_environment

            env = make_environment()
            try:
                for seed in pending:
                    record = run_episode(env, teacher, seed, args.save_demos, dart_noise=dart_noise)
                    record.update(run_id=run_id, teacher_config=teacher.config)
                    append_record(stream, record)
                    records[seed] = record
                    print(
                        f"seed={seed} slot={record['slot']} demo={record['chosen_demo']} "
                        f"success={record['success']} category={record['failure_category']} "
                        f"end={record['termination']} "
                        f"steps={record['steps']} error={record['max_pelvis_tracking_error']:.4f}m",
                        flush=True,

